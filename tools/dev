#!/usr/bin/env python3
"""Repository-owned development environment for Hover.

The CLI deliberately uses only the Python standard library so `doctor` and
`setup` work before the repository virtual environment exists.
"""

from __future__ import annotations

import argparse
import hashlib
import os
import platform
import re
import secrets
import shlex
import socket
import subprocess
import sys
import time
from pathlib import Path

REPO_ROOT = Path(__file__).resolve().parent.parent
CONTAINER_DIR = REPO_ROOT / "tools" / "dev-container"
INFRA_COMPOSE = CONTAINER_DIR / "infra.compose.yml"
WORKSPACE_COMPOSE = CONTAINER_DIR / "workspace.compose.yml"
INFRA_PROJECT = "hover-dev-infra"
MAX_WORKSPACES = 15  # Redis databases 1..15; database 0 remains unallocated.
_COMPOSE_COMMAND: list[str] | None = None


class DevError(RuntimeError):
    pass


def run(
    command: list[str],
    *,
    env: dict[str, str] | None = None,
    input_text: str | None = None,
    capture: bool = False,
    check: bool = True,
) -> subprocess.CompletedProcess[str]:
    return subprocess.run(
        command,
        cwd=REPO_ROOT,
        env=env,
        input=input_text,
        text=True,
        stdout=subprocess.PIPE if capture else None,
        stderr=subprocess.PIPE if capture else None,
        check=check,
    )


def command_output(command: list[str], *, env: dict[str, str] | None = None) -> str:
    result = run(command, env=env, capture=True)
    return result.stdout.strip()


def state_dir() -> Path:
    override = os.environ.get("HOVER_DEV_STATE_DIR")
    if override:
        return Path(override).expanduser().resolve()
    xdg_state_home = os.environ.get("XDG_STATE_HOME")
    base = Path(xdg_state_home).expanduser() if xdg_state_home else Path.home() / ".local" / "state"
    return base / "hover-dev"


def infra_env_path() -> Path:
    return state_dir() / "infra.env"


def workspace_state_dir() -> Path:
    return REPO_ROOT / ".context" / "hover-dev"


def instance_id() -> str:
    conductor_id = os.environ.get("CONDUCTOR_WORKSPACE_ID")
    identity = f"conductor:{conductor_id}" if conductor_id else f"worktree:{REPO_ROOT}"
    return hashlib.sha256(identity.encode()).hexdigest()[:16]


def workspace_env_path() -> Path:
    return workspace_state_dir() / f"{instance_id()}.env"


def parse_env_file(path: Path) -> dict[str, str]:
    values: dict[str, str] = {}
    if not path.exists():
        return values
    for line in path.read_text().splitlines():
        if not line or line.startswith("#"):
            continue
        key, separator, value = line.partition("=")
        if not separator:
            raise DevError(f"Invalid environment entry in {path}: {line!r}")
        values[key] = value
    return values


def write_env_file(path: Path, values: dict[str, str]) -> None:
    path.parent.mkdir(parents=True, exist_ok=True)
    content = "# Generated by ./tools/dev; local development credentials only.\n"
    content += "".join(f"{key}={value}\n" for key, value in sorted(values.items()))
    path.write_text(content)
    path.chmod(0o600)


def ensure_infra_credentials() -> dict[str, str]:
    path = infra_env_path()
    values = parse_env_file(path)
    required = {
        "HOVER_INFRA_POSTGRES_USER": "hover",
        "HOVER_INFRA_POSTGRES_PASSWORD": secrets.token_urlsafe(32),
        "HOVER_INFRA_REDIS_PASSWORD": secrets.token_urlsafe(32),
        "HOVER_INFRA_RABBITMQ_USER": "hover",
        "HOVER_INFRA_RABBITMQ_PASSWORD": secrets.token_urlsafe(32),
    }
    changed = False
    for key, default in required.items():
        if not values.get(key):
            values[key] = default
            changed = True
    if changed or not path.exists():
        write_env_file(path, values)
    return values


def compose_command() -> list[str]:
    global _COMPOSE_COMMAND
    if _COMPOSE_COMMAND is not None:
        return _COMPOSE_COMMAND
    plugin = run(["docker", "compose", "version"], capture=True, check=False)
    if plugin.returncode == 0:
        _COMPOSE_COMMAND = ["docker", "compose"]
        return _COMPOSE_COMMAND
    try:
        standalone = run(["docker-compose", "version"], capture=True, check=False)
        if standalone.returncode == 0:
            _COMPOSE_COMMAND = ["docker-compose"]
            return _COMPOSE_COMMAND
    except FileNotFoundError:
        pass
    raise DevError("Docker Compose v2 is unavailable (`docker compose` or `docker-compose`)")


def infra_compose_args() -> list[str]:
    return [
        *compose_command(),
        "--env-file",
        str(infra_env_path()),
        "-p",
        INFRA_PROJECT,
        "-f",
        str(INFRA_COMPOSE),
    ]


def workspace_compose_args() -> list[str]:
    return [
        *compose_command(),
        "--env-file",
        str(workspace_env_path()),
        "-f",
        str(WORKSPACE_COMPOSE),
    ]


def dependency_digest() -> str:
    digest = hashlib.sha256()
    patterns = [
        "uv.lock",
        "pyproject.toml",
        "package.json",
        "pnpm-lock.yaml",
        "starlight_help/package.json",
        "tools/dev-container/Dockerfile",
        "tools/lib/provision.py",
        "tools/lib/provision_inner.py",
        "scripts/lib/setup-apt-repo",
    ]
    for name in patterns:
        path = REPO_ROOT / name
        digest.update(name.encode())
        digest.update(path.read_bytes())
    digest.update(platform.machine().encode())
    return digest.hexdigest()[:16]


def migration_digest() -> str:
    digest = hashlib.sha256()
    files = list(REPO_ROOT.glob("*/migrations/*.py"))
    files.extend(
        REPO_ROOT / name
        for name in [
            "zerver/lib/test_fixtures.py",
            "zilencer/management/commands/populate_db.py",
            "tools/rebuild-dev-database",
        ]
    )
    for path in sorted(files):
        digest.update(str(path.relative_to(REPO_ROOT)).encode())
        digest.update(path.read_bytes())
    return digest.hexdigest()[:16]


def selected_port(cli_port: int | None) -> int:
    candidates = [
        str(cli_port) if cli_port is not None else None,
        os.environ.get("CONDUCTOR_PORT"),
        os.environ.get("HOVER_DEV_PORT"),
        "9991",
    ]
    for candidate in candidates:
        if candidate:
            try:
                port = int(candidate)
            except ValueError as error:
                raise DevError(f"Invalid development port: {candidate!r}") from error
            if not 1 <= port <= 65535:
                raise DevError(f"Development port must be between 1 and 65535: {port}")
            return port
    raise AssertionError("default port missing")


def port_is_available(port: int) -> bool:
    with socket.socket(socket.AF_INET, socket.SOCK_STREAM) as sock:
        sock.setsockopt(socket.SOL_SOCKET, socket.SO_REUSEADDR, 1)
        try:
            sock.bind(("127.0.0.1", port))
        except OSError:
            return False
    return True


def own_app_is_running() -> bool:
    result = command_output(
        [
            "docker",
            "ps",
            "-q",
            "--filter",
            f"label=hover.dev.instance={instance_id()}",
            "--filter",
            "label=hover.dev.application=true",
        ]
    )
    return bool(result)


def assert_port_available(port: int) -> None:
    if not port_is_available(port) and not own_app_is_running():
        raise DevError(
            f"Port {port} is already in use. Choose another with --port, CONDUCTOR_PORT, "
            "or HOVER_DEV_PORT; no existing workspace was stopped."
        )


def require_command(command: str, help_text: str) -> None:
    result = run(["sh", "-c", f"command -v {shlex.quote(command)}"], capture=True, check=False)
    if result.returncode != 0:
        raise DevError(help_text)


def docker_info() -> dict[str, str]:
    fields = command_output(
        ["docker", "info", "--format", "{{.OSType}}|{{.Architecture}}|{{.NCPU}}|{{.MemTotal}}"]
    ).split("|")
    if len(fields) != 4:
        raise DevError("Docker returned an unexpected system information response")
    return dict(zip(["os", "architecture", "cpus", "memory"], fields, strict=True))


def doctor(args: argparse.Namespace) -> None:
    problems: list[str] = []
    checks: list[str] = []
    for command, message in [
        ("docker", "Docker is not installed"),
        ("git", "Git is not installed"),
    ]:
        try:
            require_command(command, message)
            checks.append(f"ok: {command}")
        except DevError as error:
            problems.append(str(error))

    if problems:
        raise DevError("\n".join(problems))

    try:
        compose_version = command_output([*compose_command(), "version"])
        checks.append(f"ok: {compose_version}")
    except (DevError, subprocess.CalledProcessError) as error:
        problems.append(str(error))

    try:
        info = docker_info()
        memory_gib = int(info["memory"]) / (1024**3)
        checks.append(
            f"ok: Docker {info['os']}/{info['architecture']}, {info['cpus']} CPUs, {memory_gib:.1f} GiB"
        )
        if int(info["cpus"]) < 4 or memory_gib < 7.5:
            problems.append("Three concurrent core workspaces require at least 4 CPUs and 8 GiB")
    except (DevError, ValueError, subprocess.CalledProcessError) as error:
        problems.append(f"Docker daemon is unavailable: {error}")

    if sys.platform == "darwin":
        context = command_output(["docker", "context", "show"])
        if context != "colima":
            problems.append(f"The active Docker context is {context!r}; expected 'colima'")
        else:
            checks.append("ok: active Docker context is colima")
        colima_config = Path.home() / ".colima" / "default" / "colima.yaml"
        if not colima_config.exists():
            problems.append(f"Colima configuration not found at {colima_config}")
        else:
            config = colima_config.read_text()
            if "mountType: virtiofs" not in config:
                problems.append("Colima must use VirtioFS (`mountType: virtiofs`)")
            else:
                checks.append("ok: Colima uses VirtioFS mounts")
            if "mountInotify: true" not in config:
                problems.append(
                    "Colima forwarded file notifications are disabled (`mountInotify: true`)"
                )
            else:
                checks.append("ok: forwarded file notifications are enabled")

    port = selected_port(args.port)
    if port_is_available(port) or own_app_is_running():
        checks.append(f"ok: port {port} is available for this workspace")
    else:
        problems.append(f"Port {port} is already owned by another process")

    if infra_env_path().exists():
        checks.append(f"ok: shared credentials exist at {infra_env_path()}")
    else:
        checks.append("info: shared credentials will be generated by `./tools/dev setup`")

    print("\n".join(checks))
    if problems:
        raise DevError("Development environment checks failed:\n- " + "\n- ".join(problems))


def start_infrastructure() -> dict[str, str]:
    credentials = ensure_infra_credentials()
    run([*infra_compose_args(), "up", "-d", "--wait"])
    initialize_registry(credentials)
    return credentials


def psql(
    sql: str,
    credentials: dict[str, str],
    *,
    variables: dict[str, str] | None = None,
    database: str = "postgres",
) -> str:
    if not re.fullmatch(r"[a-z0-9_]+", database):
        raise DevError(f"Refusing to connect to unexpected database name: {database}")
    command = [
        *infra_compose_args(),
        "exec",
        "-T",
        "postgres",
        "psql",
        "-X",
        "-v",
        "ON_ERROR_STOP=1",
        "-U",
        credentials["HOVER_INFRA_POSTGRES_USER"],
        "-d",
        database,
        "-At",
    ]
    for key, value in (variables or {}).items():
        command.extend(["-v", f"{key}={value}"])
    result = run(command, input_text=sql, capture=True, check=False)
    if result.returncode != 0:
        detail = result.stderr.strip() or result.stdout.strip()
        raise DevError(f"PostgreSQL command failed: {detail}")
    return result.stdout.strip()


def seed_template_is_valid(database: str, credentials: dict[str, str]) -> bool:
    if not database_exists(database, credentials):
        return False
    try:
        return (
            psql(
                "SELECT EXISTS (SELECT 1 FROM zulip.zerver_realm);",
                credentials,
                database=database,
            )
            == "t"
        )
    except DevError:
        return False


def initialize_registry(credentials: dict[str, str]) -> None:
    psql(
        """
        CREATE TABLE IF NOT EXISTS hover_dev_workspace_registry (
            instance_id text PRIMARY KEY,
            slot smallint UNIQUE NOT NULL CHECK (slot BETWEEN 1 AND 15),
            workspace_path text NOT NULL,
            last_seen timestamptz NOT NULL DEFAULT now()
        );
        CREATE TABLE IF NOT EXISTS hover_dev_seed_templates (
            digest text PRIMARY KEY,
            database_name text UNIQUE NOT NULL,
            state text NOT NULL CHECK (state IN ('building', 'ready', 'failed')),
            updated_at timestamptz NOT NULL DEFAULT now()
        );
        """,
        credentials,
    )


def recover_stale_registrations(credentials: dict[str, str]) -> None:
    rows = psql(
        "SELECT instance_id FROM hover_dev_workspace_registry "
        "WHERE last_seen < now() - interval '30 days';",
        credentials,
    ).splitlines()
    for stale_id in rows:
        running = command_output(
            ["docker", "ps", "-q", "--filter", f"label=hover.dev.instance={stale_id}"]
        )
        if not running:
            psql(
                "BEGIN; SELECT pg_advisory_xact_lock(hashtext('hover-dev-registry')); "
                "DELETE FROM hover_dev_workspace_registry WHERE instance_id = :'stale_id' "
                "AND last_seen < now() - interval '30 days'; COMMIT;",
                credentials,
                variables={"stale_id": stale_id},
            )


def allocate_slot(credentials: dict[str, str]) -> int:
    recover_stale_registrations(credentials)
    output = psql(
        """
        BEGIN;
        SELECT pg_advisory_xact_lock(hashtext('hover-dev-registry'));
        WITH existing AS (
            SELECT slot FROM hover_dev_workspace_registry WHERE instance_id = :'instance_id'
        ), candidate AS (
            SELECT slot FROM generate_series(1, 15) slot
            WHERE NOT EXISTS (
                SELECT 1 FROM hover_dev_workspace_registry registry WHERE registry.slot = slot
            )
            ORDER BY slot LIMIT 1
        ), chosen AS (
            SELECT slot FROM existing UNION ALL SELECT slot FROM candidate LIMIT 1
        )
        INSERT INTO hover_dev_workspace_registry(instance_id, slot, workspace_path)
        SELECT :'instance_id', slot, :'workspace_path' FROM chosen
        ON CONFLICT (instance_id) DO UPDATE
        SET workspace_path = EXCLUDED.workspace_path, last_seen = now()
        RETURNING slot;
        COMMIT;
        """,
        credentials,
        variables={"instance_id": instance_id(), "workspace_path": str(REPO_ROOT)},
    )
    lines = [line for line in output.splitlines() if line.isdigit()]
    if not lines:
        raise DevError(
            f"No workspace slots remain; at most {MAX_WORKSPACES} registrations are supported"
        )
    return int(lines[-1])


def workspace_values(credentials: dict[str, str], slot: int, port: int) -> dict[str, str]:
    dep_digest = dependency_digest()
    architecture = platform.machine().replace("_", "-")
    dep_generation = f"{architecture}-{dep_digest}"
    current_id = instance_id()
    git_common_dir = Path(
        command_output(["git", "rev-parse", "--path-format=absolute", "--git-common-dir"])
    ).resolve()
    git_dir = Path(
        command_output(["git", "rev-parse", "--path-format=absolute", "--git-dir"])
    ).resolve()
    try:
        container_git_dir = Path("/git") / git_dir.relative_to(git_common_dir)
    except ValueError as error:
        raise DevError(
            f"Git directory {git_dir} is outside common directory {git_common_dir}"
        ) from error
    values = {
        **credentials,
        "HOVER_INSTANCE_ID": current_id,
        "HOVER_WORKSPACE": str(REPO_ROOT),
        "HOVER_GIT_COMMON_DIR": str(git_common_dir),
        "HOVER_CONTAINER_GIT_DIR": str(container_git_dir),
        "HOVER_HOST_UID": str(os.getuid()),
        "HOVER_HOST_GID": str(os.getgid()),
        "HOVER_HOST_PORT": str(port),
        "HOVER_DATABASE_NAME": f"hover_{current_id}",
        "HOVER_REDIS_DATABASE": str(slot),
        "HOVER_RABBITMQ_VHOST": f"hover_{slot}",
        "HOVER_APP_IMAGE": f"hover-dev-app:{dep_generation}",
        "HOVER_VENV_VOLUME": f"hover-dev-venv-{dep_generation}",
        "HOVER_NODE_VOLUME": f"hover-dev-node-{dep_generation}",
        "HOVER_STARLIGHT_VOLUME": f"hover-dev-starlight-{dep_generation}",
        "HOVER_VAR_VOLUME": f"hover-dev-var-{current_id}",
        "HOVER_UPLOADS_VOLUME": f"hover-dev-uploads-{current_id}",
        "HOVER_STATIC_GENERATED_VOLUME": (f"hover-dev-static-generated-{current_id}-{dep_digest}"),
        "HOVER_WEB_GENERATED_VOLUME": f"hover-dev-web-generated-{current_id}-{dep_digest}",
    }
    return values


def build_app_image(values: dict[str, str]) -> None:
    image = values["HOVER_APP_IMAGE"]
    exists = run(["docker", "image", "inspect", image], capture=True, check=False).returncode == 0
    if not exists:
        run(
            [
                "docker",
                "build",
                "--file",
                str(CONTAINER_DIR / "Dockerfile"),
                "--build-arg",
                f"HOST_UID={os.getuid()}",
                "--build-arg",
                f"HOST_GID={os.getgid()}",
                "--tag",
                image,
                str(REPO_ROOT),
            ]
        )


def seed_dependency_volumes(values: dict[str, str]) -> None:
    for key in ["HOVER_VENV_VOLUME", "HOVER_NODE_VOLUME", "HOVER_STARLIGHT_VOLUME"]:
        run(["docker", "volume", "create", values[key]], capture=True)
    write_env_file(workspace_env_path(), values)
    run([*workspace_compose_args(), "run", "--rm", "--no-deps", "dependencies"])


def configure_rabbitmq(values: dict[str, str]) -> None:
    vhost = values["HOVER_RABBITMQ_VHOST"]
    user = values["HOVER_INFRA_RABBITMQ_USER"]
    existing = command_output(
        [
            *infra_compose_args(),
            "exec",
            "-T",
            "rabbitmq",
            "rabbitmqctl",
            "list_vhosts",
            "--no-table-headers",
            "--quiet",
        ]
    )
    if vhost not in existing.splitlines():
        run(
            [
                *infra_compose_args(),
                "exec",
                "-T",
                "rabbitmq",
                "rabbitmqctl",
                "add_vhost",
                vhost,
            ]
        )
    run(
        [
            *infra_compose_args(),
            "exec",
            "-T",
            "rabbitmq",
            "rabbitmqctl",
            "set_permissions",
            "-p",
            vhost,
            user,
            ".*",
            ".*",
            ".*",
        ]
    )


def database_exists(name: str, credentials: dict[str, str]) -> bool:
    result = psql(
        "SELECT 1 FROM pg_database WHERE datname = :'database_name';",
        credentials,
        variables={"database_name": name},
    )
    return result.strip() == "1"


def create_database(
    name: str, owner: str, credentials: dict[str, str], template: str | None = None
) -> None:
    identifiers = [name, owner, *([template] if template is not None else [])]
    if any(not re.fullmatch(r"[a-z][a-z0-9_]{0,62}", identifier) for identifier in identifiers):
        raise DevError(f"Refusing unsafe PostgreSQL identifier(s): {identifiers}")
    template_clause = f" TEMPLATE {template}" if template is not None else ""
    psql(f"CREATE DATABASE {name} OWNER {owner}{template_clause};", credentials)
    command = [
        *infra_compose_args(),
        "exec",
        "-T",
        "postgres",
        "psql",
        "-X",
        "-v",
        "ON_ERROR_STOP=1",
        "-U",
        owner,
        "-d",
        name,
        "-c",
        "CREATE EXTENSION IF NOT EXISTS pgroonga;",
    ]
    run(command)
    if template is not None:
        # PGroonga's database-local objects do not survive PostgreSQL 15+
        # CREATE DATABASE ... TEMPLATE cloning. Rebuild them in the clone.
        psql(f"REINDEX DATABASE {name};", credentials, database=name)


def app_run(
    values: dict[str, str],
    command: list[str],
    *,
    database_name: str | None = None,
    cache_namespace: str | None = None,
) -> None:
    environment_args: list[str] = []
    if database_name is not None:
        environment_args.extend(["-e", f"HOVER_DEV_DATABASE_NAME={database_name}"])
    if cache_namespace is not None:
        environment_args.extend(["-e", f"HOVER_DEV_CACHE_PREFIX={cache_namespace}:"])
    run(
        [
            *workspace_compose_args(),
            "run",
            "--rm",
            "--no-deps",
            *environment_args,
            "task",
            *command,
        ]
    )


def ensure_seed_template(values: dict[str, str]) -> str:
    credentials = values
    digest = migration_digest()
    template = f"hover_tpl_{digest}"
    state = psql(
        "SELECT state FROM hover_dev_seed_templates WHERE digest = :'digest';",
        credentials,
        variables={"digest": digest},
    )
    if state == "ready" and seed_template_is_valid(template, credentials):
        return template
    if state == "ready":
        psql(
            "UPDATE hover_dev_seed_templates SET state = 'failed', updated_at = now() "
            "WHERE digest = :'digest';",
            credentials,
            variables={"digest": digest},
        )

    claim = psql(
        """
        BEGIN;
        SELECT pg_advisory_xact_lock(hashtext('hover-dev-template-' || :'digest'));
        WITH inserted AS (
            INSERT INTO hover_dev_seed_templates(digest, database_name, state)
            VALUES (:'digest', :'database_name', 'building')
            ON CONFLICT (digest) DO NOTHING
            RETURNING 1
        ), reclaimed AS (
            UPDATE hover_dev_seed_templates
            SET state = 'building', database_name = :'database_name', updated_at = now()
            WHERE digest = :'digest'
              AND NOT EXISTS (SELECT 1 FROM inserted)
              AND (state = 'failed' OR updated_at < now() - interval '15 minutes')
            RETURNING 1
        )
        SELECT CASE
            WHEN EXISTS (SELECT 1 FROM inserted) OR EXISTS (SELECT 1 FROM reclaimed)
            THEN 'claimed'
            ELSE (SELECT state FROM hover_dev_seed_templates WHERE digest = :'digest')
        END;
        COMMIT;
        """,
        credentials,
        variables={"digest": digest, "database_name": template},
    )
    claim_lines = [
        line for line in claim.splitlines() if line in {"claimed", "building", "ready", "failed"}
    ]
    state = claim_lines[-1] if claim_lines else ""
    if state == "claimed":
        try:
            if database_exists(template, credentials):
                if not re.fullmatch(r"hover_tpl_[a-f0-9]{16}", template):
                    raise DevError(f"Refusing to replace unexpected seed database: {template}")
                psql(
                    "SELECT pg_terminate_backend(pid) FROM pg_stat_activity "
                    "WHERE datname = :'database_name' AND pid <> pg_backend_pid();",
                    credentials,
                    variables={"database_name": template},
                )
                psql(f"DROP DATABASE {template};", credentials)
            create_database(template, values["HOVER_INFRA_POSTGRES_USER"], credentials)
            app_run(
                values,
                ["./manage.py", "migrate", "--noinput"],
                database_name=template,
                cache_namespace=template,
            )
            app_run(
                values,
                ["./manage.py", "createcachetable", "third_party_api_results"],
                database_name=template,
                cache_namespace=template,
            )
            app_run(
                values,
                ["./manage.py", "populate_db", "-n100", "--threads=1"],
                database_name=template,
                cache_namespace=template,
            )
            psql(
                "UPDATE hover_dev_seed_templates SET state = 'ready', updated_at = now() "
                "WHERE digest = :'digest';",
                credentials,
                variables={"digest": digest},
            )
        except BaseException:
            psql(
                "UPDATE hover_dev_seed_templates SET state = 'failed', updated_at = now() "
                "WHERE digest = :'digest';",
                credentials,
                variables={"digest": digest},
            )
            raise
        return template

    deadline = time.monotonic() + 900
    while time.monotonic() < deadline:
        status = psql(
            "SELECT state FROM hover_dev_seed_templates WHERE digest = :'digest';",
            credentials,
            variables={"digest": digest},
        )
        if status == "ready" and database_exists(template, credentials):
            return template
        if status == "failed":
            raise DevError(f"Another setup failed while building seed template {template}")
        time.sleep(2)
    raise DevError(f"Timed out waiting for seed template {template}")


def prepare_workspace_database(values: dict[str, str], template: str) -> None:
    database = values["HOVER_DATABASE_NAME"]
    if not database_exists(database, values):
        create_database(
            database,
            values["HOVER_INFRA_POSTGRES_USER"],
            values,
            template=template,
        )
    app_run(values, ["./manage.py", "migrate", "--noinput"])


def setup(args: argparse.Namespace) -> None:
    port = selected_port(args.port)
    assert_port_available(port)
    credentials = start_infrastructure()
    slot = allocate_slot(credentials)
    values = workspace_values(credentials, slot, port)
    build_app_image(values)
    seed_dependency_volumes(values)
    configure_rabbitmq(values)
    app_run(values, ["scripts/setup/generate_secrets.py", "--development"])
    app_run(values, ["./manage.py", "compilemessages", "--ignore=*"])
    template = ensure_seed_template(values)
    prepare_workspace_database(values, template)
    print(
        f"Hover workspace {values['HOVER_INSTANCE_ID']} is ready on port {port} "
        f"(database {values['HOVER_DATABASE_NAME']}, Redis DB {slot}, RabbitMQ vhost "
        f"{values['HOVER_RABBITMQ_VHOST']})."
    )


def load_workspace_values(*, port: int | None = None) -> dict[str, str]:
    path = workspace_env_path()
    values = parse_env_file(path)
    if not values:
        raise DevError("This workspace is not set up. Run `./tools/dev setup` first.")
    if values.get("HOVER_INSTANCE_ID") != instance_id():
        raise DevError(f"Workspace state at {path} belongs to a different instance")
    if port is not None:
        values["HOVER_HOST_PORT"] = str(port)
    write_env_file(path, values)
    return values


def up(args: argparse.Namespace) -> None:
    port = selected_port(args.port)
    load_workspace_values(port=port)
    assert_port_available(port)
    service = "app" if args.profile == "core" else "app-full"
    profile_args = [] if args.profile == "core" else ["--profile", "full"]
    run([*workspace_compose_args(), *profile_args, "up", "--no-deps", service])


def execute(args: argparse.Namespace) -> None:
    values = load_workspace_values()
    if not args.command:
        raise DevError("Pass a command after `--`, for example: ./tools/dev exec -- ./tools/lint")
    app_run(values, args.command)


def logs(_args: argparse.Namespace) -> None:
    load_workspace_values()
    run([*infra_compose_args(), "logs", "--tail=40", "postgres", "redis", "rabbitmq", "memcached"])
    run([*workspace_compose_args(), "--profile", "full", "logs", "--follow", "app", "app-full"])


def down(_args: argparse.Namespace) -> None:
    values = load_workspace_values()
    run([*workspace_compose_args(), "--profile", "full", "down", "--remove-orphans"])
    credentials = parse_env_file(infra_env_path())
    if credentials:
        psql(
            "UPDATE hover_dev_workspace_registry SET last_seen = now() WHERE instance_id = :'instance_id';",
            credentials,
            variables={"instance_id": values["HOVER_INSTANCE_ID"]},
        )


def drop_database(name: str, credentials: dict[str, str]) -> None:
    if not re.fullmatch(r"hover_[a-f0-9]{16}", name):
        raise DevError(f"Refusing to drop unexpected database name: {name}")
    psql(
        "SELECT pg_terminate_backend(pid) FROM pg_stat_activity "
        "WHERE datname = :'database_name' AND pid <> pg_backend_pid();",
        credentials,
        variables={"database_name": name},
    )
    psql(f"DROP DATABASE IF EXISTS {name};", credentials)


def reset(args: argparse.Namespace) -> None:
    if not args.yes:
        raise DevError(
            "Reset destroys this workspace's data. Re-run with `./tools/dev reset --yes`."
        )
    values = load_workspace_values()
    run([*workspace_compose_args(), "--profile", "full", "down", "--remove-orphans"])
    drop_database(values["HOVER_DATABASE_NAME"], values)
    run(
        [
            *infra_compose_args(),
            "exec",
            "-T",
            "redis",
            "redis-cli",
            "-a",
            values["HOVER_INFRA_REDIS_PASSWORD"],
            "-n",
            values["HOVER_REDIS_DATABASE"],
            "FLUSHDB",
        ]
    )
    vhost = values["HOVER_RABBITMQ_VHOST"]
    run(
        [*infra_compose_args(), "exec", "-T", "rabbitmq", "rabbitmqctl", "delete_vhost", vhost],
        check=False,
    )
    configure_rabbitmq(values)
    for key in [
        "HOVER_VAR_VOLUME",
        "HOVER_UPLOADS_VOLUME",
        "HOVER_STATIC_GENERATED_VOLUME",
        "HOVER_WEB_GENERATED_VOLUME",
    ]:
        volume = values[key]
        expected_prefix = {
            "HOVER_VAR_VOLUME": "hover-dev-var-",
            "HOVER_UPLOADS_VOLUME": "hover-dev-uploads-",
            "HOVER_STATIC_GENERATED_VOLUME": "hover-dev-static-generated-",
            "HOVER_WEB_GENERATED_VOLUME": "hover-dev-web-generated-",
        }[key]
        if not volume.startswith(expected_prefix):
            raise DevError(f"Refusing to remove unexpected volume name: {volume}")
        exists = run(["docker", "volume", "inspect", volume], capture=True, check=False)
        if exists.returncode == 0:
            run(["docker", "volume", "rm", volume])
    template = ensure_seed_template(values)
    prepare_workspace_database(values, template)
    print(f"Reset only Hover workspace {values['HOVER_INSTANCE_ID']}.")


def infra_stop(_args: argparse.Namespace) -> None:
    running = command_output(
        ["docker", "ps", "--filter", "label=hover.dev.application=true", "--format", "{{.Names}}"]
    )
    if running:
        raise DevError(
            "Shared infrastructure is still used by workspace applications:\n"
            + "\n".join(f"- {name}" for name in running.splitlines())
        )
    if not infra_env_path().exists():
        print("Shared infrastructure has not been set up.")
        return
    run([*infra_compose_args(), "stop"])


def parser() -> argparse.ArgumentParser:
    root = argparse.ArgumentParser(prog="./tools/dev")
    subparsers = root.add_subparsers(dest="subcommand", required=True)

    doctor_parser = subparsers.add_parser("doctor", help="Validate the host without changing state")
    doctor_parser.add_argument("--port", type=int)
    doctor_parser.set_defaults(handler=doctor)

    setup_parser = subparsers.add_parser("setup", help="Prepare shared services and this workspace")
    setup_parser.add_argument("--port", type=int)
    setup_parser.set_defaults(handler=setup)

    up_parser = subparsers.add_parser("up", help="Run Hover in the foreground")
    up_parser.add_argument("--port", type=int)
    up_parser.add_argument("--profile", choices=["core", "full"], default="core")
    up_parser.set_defaults(handler=up)

    exec_parser = subparsers.add_parser("exec", help="Run a command in this workspace container")
    exec_parser.add_argument("command", nargs=argparse.REMAINDER)
    exec_parser.set_defaults(handler=execute)

    logs_parser = subparsers.add_parser("logs", help="Follow application and infrastructure logs")
    logs_parser.set_defaults(handler=logs)

    down_parser = subparsers.add_parser("down", help="Stop only this workspace application")
    down_parser.set_defaults(handler=down)

    reset_parser = subparsers.add_parser("reset", help="Recreate only this workspace's data")
    reset_parser.add_argument("--yes", action="store_true")
    reset_parser.set_defaults(handler=reset)

    infra_parser = subparsers.add_parser("infra", help="Manage shared infrastructure")
    infra_subparsers = infra_parser.add_subparsers(dest="infra_command", required=True)
    infra_stop_parser = infra_subparsers.add_parser("stop", help="Stop unused shared services")
    infra_stop_parser.set_defaults(handler=infra_stop)
    return root


def main() -> int:
    args = parser().parse_args()
    if getattr(args, "command", [None])[:1] == ["--"]:
        args.command = args.command[1:]
    try:
        args.handler(args)
    except KeyboardInterrupt:
        print("\nStopped.", file=sys.stderr)
        return 130
    except (DevError, subprocess.CalledProcessError) as error:
        print(f"error: {error}", file=sys.stderr)
        return 1
    return 0


if __name__ == "__main__":
    sys.exit(main())
