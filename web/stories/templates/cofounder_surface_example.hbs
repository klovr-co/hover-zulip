<div class="cf-theme storybook-surface-story">
    <div class="storybook-surface-specimen">
        <span class="storybook-surface-specimen__caption">{{t "Base"}}</span>
        {{#> ../../templates/cofounder/components/surface padded=true aria-labelledby="surface-base-title"}}
        <div class="storybook-surface-content">
            <h2 id="surface-base-title">{{t "Review launch campaign"}}</h2>
            <p>{{t "Confirm the final brief before publishing."}}</p>
            <div class="storybook-surface-actions">
            {{> ../../templates/cofounder/components/button variant="primary" label=(t "Review")}}
            {{> ../../templates/cofounder/components/button variant="secondary" label=(t "View details")}}
            </div>
        </div>
        {{/../../templates/cofounder/components/surface}}
    </div>

    <div class="storybook-surface-specimen">
        <span class="storybook-surface-specimen__caption">{{t "Raised"}}</span>
        {{#> ../../templates/cofounder/components/surface padded=true raised=true aria-labelledby="surface-raised-title"}}
        <div class="storybook-surface-content">
            <h2 id="surface-raised-title">{{t "Workspace update"}}</h2>
            <p>{{t "Three launch tasks are ready for review."}}</p>
            {{> ../../templates/cofounder/components/status tone="success" label=(t "Ready")}}
        </div>
        {{/../../templates/cofounder/components/surface}}
    </div>

    <div class="storybook-surface-specimen">
        <span class="storybook-surface-specimen__caption">{{t "Overlay"}}</span>
        {{#> ../../templates/cofounder/components/surface padded=true overlay=true aria-labelledby="surface-overlay-title"}}
        <div class="storybook-surface-content">
            <h2 id="surface-overlay-title">{{t "Quick review"}}</h2>
            <p>{{t "Choose the next step for this launch request."}}</p>
        </div>
        {{/../../templates/cofounder/components/surface}}
    </div>
</div>
