{{> ../cofounder/components/icon_button
  icon="chevron-right"
  intent="neutral"
  component_classes="cf-people-sidebar__section-toggle section-toggle-tooltip-target"
  aria-label=header_text
  has_expanded_state=true
  expanded=(not is_collapsed)
  omit_legacy_classes=true
  }}
<h5 id="{{id}}" class="cf-people-sidebar__section-title no-style hidden-for-spectators">
    <span class="cf-people-sidebar__section-title-text">{{header_text}}</span>
    {{!-- Hide the count until we have fetched data to display the correct count --}}
    <span class="cf-people-sidebar__section-count-wrap hide">
        (<span class="cf-people-sidebar__section-count"></span>)
    </span>
</h5>
