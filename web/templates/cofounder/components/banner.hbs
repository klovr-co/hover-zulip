<div {{#if process}}data-process="{{process}}" {{/if}}role="{{#if (or (eq intent "danger") (eq intent "warning"))}}alert{{else}}status{{/if}}" aria-atomic="true" class="cf-banner cf-banner--{{intent}}{{#if custom_classes}} {{custom_classes}}{{/if}}">
    <div class="cf-banner__content">
        <div class="cf-banner__label">
            {{#if label}}
                {{label}}
            {{else}}
                {{> @partial-block .}}
            {{/if}}
        </div>
        {{#unless (eq buttons undefined)}}
        {{#unless (eq buttons.length 0)}}
        <div class="cf-banner__actions">
            {{#each buttons}}
                {{> banner_action .}}
            {{/each}}
        </div>
        {{/unless}}
        {{/unless}}
    </div>
    {{#if close_button}}
        {{> button variant="ghost" icon="close" aria-label=(t "Dismiss") custom_classes="cf-banner__close"}}
    {{/if}}
</div>
