<li {{#if for_modal}} id="more-topics-modal"{{/if}} class="cf-channel-nav narrow-filter{{#if is_muted}} cf-channel-nav--muted out_of_home_view{{/if}}{{#if custom_classes}} {{custom_classes}}{{/if}}" data-stream-id="{{id}}">
    <div class="cf-channel-nav__header bottom_left_row channel-header">
        <a href="{{url}}" class="cf-channel-nav__main subscription_block selectable_sidebar_block" draggable="false"{{#if (lookup . "selected")}} aria-current="page"{{/if}}>
            <span class="cf-channel-nav__icon stream-privacy-original-color-{{id}} stream-privacy filter-icon" style="color: {{color}}">
                {{> ../../stream_privacy .}}
            </span>
            <span class="cf-channel-nav__label stream-name">{{name}}</span>
            <span class="cf-channel-nav__signals stream-markers-and-unreads">
                <span class="cf-channel-nav__mention unread_mention_info">{{lookup . "mention_label"}}</span>
                <span class="cf-channel-nav__badge unread_count normal-count{{#unless (lookup . "badge_visible")}} hide{{/unless}}">{{lookup . "unread_count"}}</span>
                <span class="cf-channel-nav__masked masked_unread_count" aria-label="{{t 'Some unread messages are hidden'}}"><span aria-hidden="true">&#8226;</span></span>
            </span>
        </a>
        <div class="cf-channel-nav__actions left-sidebar-controls">
            <button type="button" class="cf-channel-nav__action channel-search-topics-button" aria-label="{{t 'Search topics'}}" data-tippy-content="{{t 'Search topics'}}" data-stream-id="{{id}}">
                {{> icon name="search" compact=true}}
            </button>
            {{#if can_post_messages}}
            <button type="button" class="cf-channel-nav__action channel-new-topic-button hidden-for-spectators auto-hide-left-sidebar-overlay" aria-label="{{#if (or is_empty_topic_only_channel cannot_create_topics_in_channel)}}{{t 'New message'}}{{else}}{{t 'Start a new topic'}}{{/if}}" data-tippy-content="{{#if (or is_empty_topic_only_channel cannot_create_topics_in_channel)}}{{t 'New message'}}{{else}}{{t 'Start a new topic'}}{{/if}}" data-stream-id="{{id}}">
                {{> icon name="plus" compact=true}}
            </button>
            {{/if}}
        </div>
        <button type="button" class="cf-channel-nav__action cf-channel-nav__more sidebar-menu-icon stream-sidebar-menu-icon" aria-label="{{t 'Channel options'}}">
            {{> icon name="more-horizontal" compact=true}}
        </button>
    </div>
    {{> @partial-block .}}
</li>
