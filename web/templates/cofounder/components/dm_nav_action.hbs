<li id="show-more-direct-messages" class="cf-dm-nav-action dm-list-item bottom_left_row{{#if is_zero}} zero-dm-unreads{{/if}}">
    <button type="button" class="cf-dm-nav-action__main dm-name">
        <span class="cf-dm-nav-action__label">{{label}}</span>
        <span class="cf-dm-nav-action__badge unread_count{{#if is_zero}} zero_count{{/if}}">{{unread}}</span>
    </button>
</li>
