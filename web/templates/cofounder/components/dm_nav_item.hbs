<li class="cf-dm-nav dm-list-item bottom_left_row{{#if is_active}} cf-dm-nav--selected active-sub-filter{{/if}}{{#if is_zero}} zero-dm-unreads{{/if}}" data-user-ids-string="{{user_ids_string}}">
    <a href="{{url}}" draggable="false" class="cf-dm-nav__main dm-box dm-user-status" data-user-ids-string="{{user_ids_string}}" data-is-group="{{#if is_group}}true{{else}}false{{/if}}"{{#if is_active}} aria-current="page"{{/if}}>
        <span class="cf-dm-nav__presence" aria-hidden="true">
            {{#if is_group}}
                {{> icon name="users" compact=true}}
            {{else}}
                <span class="cf-dm-nav__presence-dot {{user_circle_class}}"></span>
            {{/if}}
        </span>
        <span class="cf-dm-nav__label conversation-partners">
            <span class="cf-dm-nav__label-text conversation-partners-list">{{recipients}}</span>
            {{#if is_current_user}}<span class="cf-dm-nav__self my_user_status">{{t '(you)'}}</span>{{/if}}
            {{> ../../status_emoji status_emoji_info}}
            {{#if is_bot}}
                <span class="cf-dm-nav__bot" role="img" aria-label="{{t 'Bot' }}">{{> icon name="bot" compact=true}}</span>
            {{/if}}
        </span>
        <span class="cf-dm-nav__signals dm-markers-and-unreads">
            {{#if has_unread_mention}}<span class="cf-dm-nav__mention unread_mention_info">@</span>{{/if}}
            <span class="cf-dm-nav__badge unread_count{{#if is_zero}} zero_count{{/if}}">{{unread}}</span>
        </span>
    </a>
</li>
