<div id="{{id}}" class="cf-dm-section-header left-sidebar-section-header direct-messages-container{{#if is_modal}} cf-dm-section-header--modal{{/if}}{{#if custom_classes}} {{custom_classes}}{{/if}}">
    {{#if has_toggle}}
    <button id="toggle-direct-messages-section-icon" type="button" class="cf-dm-section-header__toggle rotate-icon-down dm-tooltip-target" aria-label="{{t 'Toggle direct messages'}}">
        {{> icon name="chevron-right" compact=true}}
    </button>
    {{/if}}
    <h4 class="cf-dm-section-header__title left-sidebar-title"><span class="dm-tooltip-target">{{title}}</span></h4>
    <div class="cf-dm-section-header__actions left-sidebar-controls">
        <a class="cf-dm-section-header__action show-all-direct-messages tippy-left-sidebar-tooltip-no-label-delay" href="#narrow/is/dm" aria-label="{{t 'Direct message feed' }}" data-tooltip-template-id="show-all-direct-messages-template">
            {{> icon name="messages" compact=true}}
        </a>
        <button type="button" class="cf-dm-section-header__action compose-new-direct-message tippy-left-sidebar-tooltip-no-label-delay auto-hide-left-sidebar-overlay" aria-label="{{t 'Start a new DM' }}" data-tooltip-template-id="new_direct_message_button_tooltip_template">
            {{> icon name="plus" compact=true}}
        </button>
    </div>
    <div class="cf-dm-section-header__signals heading-markers-and-unreads">
        <span class="cf-dm-section-header__badge unread_count"></span>
    </div>
    {{#if has_filter}}
    <div class="cf-dm-section-header__filter">{{#if @partial-block}}{{> @partial-block}}{{/if}}</div>
    {{/if}}
</div>
