<button type="button"{{#if id}} id="{{id}}"{{/if}} class="cf-icon-button cf-icon-button--{{intent}}{{#if squared}} cf-icon-button--square{{/if}}{{#if component_classes}} {{component_classes}}{{/if}}{{#if custom_classes}} {{custom_classes}}{{/if}}{{#unless omit_legacy_classes}} icon-button icon-button-{{intent}}{{#if squared}} icon-button-square{{/if}}{{/unless}}{{#if hidden}} hide{{/if}}"{{#if role}} role="{{role}}"{{/if}}{{#if data-tooltip-template-id}} data-tooltip-template-id="{{data-tooltip-template-id}}"{{/if}}{{#if aria-label}} aria-label="{{aria-label}}"{{else}}{{#if data-tippy-content}} aria-label="{{data-tippy-content}}"{{/if}}{{/if}}{{#if has_expanded_state}} aria-expanded="{{#if expanded}}true{{else}}false{{/if}}"{{/if}}{{#if has_checked_state}} aria-checked="{{#if checked}}true{{else}}false{{/if}}"{{/if}}{{#if data-tippy-content}} data-tippy-content="{{data-tippy-content}}"{{/if}}{{#if data-tippy-placement}} data-tippy-placement="{{data-tippy-placement}}"{{/if}}{{#if data-clipboard-text}} data-clipboard-text="{{data-clipboard-text}}"{{/if}}{{#if data-micromodal-close}} data-micromodal-close{{/if}}{{#if disabled}} disabled{{/if}}>
    {{> icon name=icon compact=true}}
</button>
