<div class="cf-source-actions" role="group" aria-label="{{t 'Knowledge sources'}}">
    <span class="cf-source-actions__label">{{t "Sources"}}</span>
    {{#if evidence_url}}
        <button
          type="button"
          class="cf-source-action cf-source-action--evidence"
          data-cf-evidence-url="{{evidence_url}}"
          aria-haspopup="dialog"
          >
            {{t "View sources"}}
        </button>
    {{/if}}
    {{#each integrations}}
        <span class="cf-source-action-wrap">
            {{#if url}}
                <a
                  class="cf-source-action cf-source-action--integration cf-source-action--{{key}}"
                  href="{{url}}"
                  target="_blank"
                  rel="noopener noreferrer"
                  aria-label="{{name}}: {{count}}"
                  title="{{name}}"
                  >
                    {{#if (eq key "whatsapp")}}
                        {{> icon name="phone" compact=true custom_classes="cf-source-action__icon"}}
                    {{else if (eq key "github")}}
                        {{> icon name="git-pull-request" compact=true custom_classes="cf-source-action__icon"}}
                    {{else if (eq key "instagram")}}
                        {{> icon name="image" compact=true custom_classes="cf-source-action__icon"}}
                    {{else}}
                        {{> icon name="link-alt" compact=true custom_classes="cf-source-action__icon"}}
                    {{/if}}
                    <span class="cf-source-action__count">{{count}}</span>
                </a>
            {{else}}
                <span
                  class="cf-source-action cf-source-action--integration cf-source-action--{{key}}
                  cf-source-action--static"
                  role="img"
                  aria-label="{{name}}: {{count}}"
                  title="{{name}}"
                  >
                    {{#if (eq key "whatsapp")}}
                        {{> icon name="phone" compact=true custom_classes="cf-source-action__icon"}}
                    {{else if (eq key "github")}}
                        {{> icon name="git-pull-request" compact=true custom_classes="cf-source-action__icon"}}
                    {{else if (eq key "instagram")}}
                        {{> icon name="image" compact=true custom_classes="cf-source-action__icon"}}
                    {{else}}
                        {{> icon name="link-alt" compact=true custom_classes="cf-source-action__icon"}}
                    {{/if}}
                    <span class="cf-source-action__count">{{count}}</span>
                </span>
            {{/if}}
        </span>
    {{/each}}
</div>
