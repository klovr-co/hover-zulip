<li class="cf-topic-nav-action bottom_left_row {{item_classes}}{{#if is_zero}} zero-topic-unreads{{/if}}{{#if is_muted_only}} more_topic_unreads_muted_only{{/if}}">
    <a href="{{href}}" class="cf-topic-nav-action__main{{#if has_icon}} cf-topic-nav-action__main--with-icon{{/if}} {{main_classes}}"{{#if is_new_topic}} data-stream-id="{{stream_id}}"{{/if}}>
        {{#if has_icon}}
        <span class="cf-topic-nav-action__icon" aria-hidden="true">{{> icon name=icon compact=true}}</span>
        {{/if}}
        <span class="cf-topic-nav-action__label {{label_classes}}">{{label}}</span>
        {{#if has_unreads}}
        <span class="cf-topic-nav-action__signals topic-markers-and-unreads">
            {{#if has_mention}}<span class="cf-topic-nav-action__mention unread_mention_info">@</span>{{/if}}
            <span class="cf-topic-nav-action__badge unread_count normal-count{{#if is_zero}} zero_count{{/if}}">{{unread}}</span>
        </span>
        {{/if}}
    </a>
</li>
