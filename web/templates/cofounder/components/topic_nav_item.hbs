<li class="cf-topic-nav bottom_left_row{{#if is_active_topic}} cf-topic-nav--selected active-sub-filter{{/if}}{{#if is_zero}} zero-topic-unreads{{/if}}{{#if is_muted}} cf-topic-nav--muted muted_topic{{/if}}{{#if is_unmuted_or_followed}} unmuted_or_followed_topic{{/if}} topic-list-item" data-topic-name="{{topic_name}}">
    <a href="{{url}}" class="cf-topic-nav__main topic-box" draggable="false"{{#if is_active_topic}} aria-current="page"{{/if}}>
        <span class="cf-topic-nav__resolved sidebar-topic-check"{{#if topic_resolved_prefix}} role="img" aria-label="{{t 'Resolved topic'}}"{{else}} aria-hidden="true"{{/if}}>{{topic_resolved_prefix}}</span>
        <span class="cf-topic-nav__label sidebar-topic-name">
            <span class="cf-topic-nav__label-inner sidebar-topic-name-inner{{#if is_empty_string_topic}} empty-topic-display{{/if}}">{{topic_display_name}}</span>
        </span>
        <span class="cf-topic-nav__signals topic-markers-and-unreads">
            {{#if contains_unread_mention}}
            <span class="cf-topic-nav__mention unread_mention_info" aria-label="{{t 'Mentioned you'}}">@</span>
            {{/if}}
            <span class="cf-topic-nav__badge unread_count normal-count{{#if is_zero}} zero_count{{/if}}" aria-label="{{t 'Unread messages'}}: {{unread}}">{{unread}}</span>
        </span>
    </a>
    {{#unless contains_unread_mention}}
    {{#if is_followed}}
    <button type="button" class="cf-topic-nav__action cf-topic-nav__visibility visibility-policy-icon change_visibility_policy" aria-label="{{t 'Change visibility policy'}}: {{topic_display_name}}" data-tippy-content="{{t 'You follow this topic.'}}" data-stream-id="{{stream_id}}" data-topic-name="{{topic_name}}">
        {{> icon name="eye" compact=true}}
    </button>
    {{/if}}
    {{/unless}}
    <button type="button" class="cf-topic-nav__action cf-topic-nav__more sidebar-menu-icon topic-sidebar-menu-icon" aria-label="{{t 'Topic options'}}: {{topic_display_name}}">
        {{> icon name="more-horizontal" compact=true}}
    </button>
</li>
