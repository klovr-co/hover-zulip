<header class="two-pane-settings-header cf-two-pane-shell__header">
    {{> icon_button icon="chevron-left" intent="neutral" custom_classes="cf-two-pane-shell__back" aria-label=(t "Back to list") }}
    <span class="cf-two-pane-shell__title{{#if title_class}} {{title_class}}{{/if}}">{{title}}</span>
    {{> icon_button icon="close" intent="neutral" custom_classes="exit cf-two-pane-shell__close" aria-label=(t "Close") }}
</header>
