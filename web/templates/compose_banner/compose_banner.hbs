{{#> ../cofounder/components/notice . intent=banner_type}}
    {{#if banner_text}}
    <p class="cf-notice__content">{{banner_text}}</p>
    {{else}}
    <div class="cf-notice__content">{{> @partial-block .}}</div>
    {{/if}}
    {{#if (or button_text is_onboarding_banner)}}
    <div class="cf-notice__actions">
        {{#if button_text}}
        <button type="button" class="cf-button cf-button--secondary cf-notice__action" {{#if scheduling_message}}data-validation-trigger="schedule"{{/if}}>{{button_text}}</button>
        {{/if}}
        {{#if is_onboarding_banner}}
        <button type="button" class="cf-button cf-button--secondary cf-notice__action" data-action="mark-as-read">{{t "Got it"}}</button>
        {{/if}}
    </div>
    {{/if}}
{{/../cofounder/components/notice}}
