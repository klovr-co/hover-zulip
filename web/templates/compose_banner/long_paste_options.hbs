{{#> ../cofounder/components/notice . intent=banner_type}}
    {{#if show_paste_button}}
    <div class="cf-notice__content">{{t 'Paste text directly or convert to a file?'}}</div>
    <div class="cf-notice__actions">
        {{> ../cofounder/components/button variant="secondary" label=(t "Paste") custom_classes="cf-notice__action paste-to-compose"}}
        {{> ../cofounder/components/button variant="secondary" label=(t "Convert") custom_classes="cf-notice__action convert-to-file"}}
    </div>
    {{else}}
    <div class="cf-notice__content">{{t 'Do you want to convert the pasted text into a file?'}}</div>
    <div class="cf-notice__actions">
        {{> ../cofounder/components/button variant="secondary" label=(t "Yes, convert") custom_classes="cf-notice__action convert-to-file"}}
    </div>
    {{/if}}
{{/../cofounder/components/notice}}
