{{#> ../cofounder/components/notice . intent="success" custom_classes="message_scheduled_success_compose_banner"}}
    <p class="cf-notice__content">
        {{#if minimum_scheduled_message_delay_minutes_note}}
            {{t 'Messages must be scheduled at least {minimum_scheduled_message_delay_minutes} minutes in the future.'}}
        {{/if}}
        {{t 'Your message has been scheduled for {deliver_at}.'}}
        <a href="#scheduled">{{t "View scheduled messages"}}</a>
    </p>
    <div class="cf-notice__actions">
        {{> ../cofounder/components/button variant="secondary" label=(t "Undo") custom_classes="cf-notice__action undo_scheduled_message"}}
    </div>
{{/../cofounder/components/notice}}
