<section
  class="cf-feed-controls"
  data-cf-feed-controls="all"
  aria-label="{{t 'Filter Space updates'}}"
  >
    <div class="cf-feed-controls__heading">
        <span class="cf-feed-controls__eyebrow">{{space_name}}</span>
        <span class="cf-feed-controls__title">
            <strong>{{t "All"}}</strong>
            <small>{{t "People and meaningful Module updates"}}</small>
        </span>
    </div>
    <div
      class="cf-feed-controls__rail"
      role="group"
      aria-label="{{t 'Feed filters'}}"
      >
        <button
          type="button"
          class="cf-feed-filter cf-feed-filter--selected"
          data-cf-feed-filter="all"
          aria-pressed="true"
          >
            <span class="cf-feed-filter__label">{{t "All"}}</span>
        </button>
        {{#each modules}}
            <button
              type="button"
              class="cf-feed-filter"
              data-cf-feed-filter="module"
              data-cf-feed-filter-key="{{key}}"
              aria-pressed="false"
              >
                {{> cofounder/components/icon name=icon_name compact=true}}
                <span class="cf-feed-filter__label">{{name}}</span>
                <span class="cf-feed-filter__count">{{count}}</span>
            </button>
        {{/each}}
        {{#each sources}}
            <button
              type="button"
              class="cf-feed-filter"
              data-cf-feed-filter="source"
              data-cf-feed-filter-key="{{source_key}}"
              aria-pressed="false"
              >
                {{> cofounder/components/icon name=icon_name compact=true}}
                <span class="cf-feed-filter__label">{{name}}</span>
                <span class="cf-feed-filter__count">{{count}}</span>
            </button>
        {{/each}}
    </div>
    <p class="cf-feed-controls__status" aria-live="polite">
        {{t
          "Showing teammate posts and the latest meaningful state of every enabled Module."
          }}
    </p>
</section>
