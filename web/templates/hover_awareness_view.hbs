<main class="cf-awareness-shell" aria-label="{{title}}">
    <div class="cf-awareness-status" role="status" aria-live="polite">
        {{status}}
        {{#if show_retry}}
            {{> cofounder/components/button id="cf-awareness-retry" variant="secondary" label=(t "Try again") }}
        {{/if}}
    </div>

    {{#if has_items}}
        <section
          class="cf-awareness-feed"
          role="feed"
          aria-label="{{title}}"
          >
            {{#each items}}
                <article
                  class="{{card_class}}"
                  role="article"
                  aria-labelledby="cf-awareness-item-{{message_id}}"
                  data-cf-awareness-message-id="{{message_id}}"
                  >
                    <div class="cf-awareness-card__body">
                        <img
                          class="cf-awareness-avatar"
                          src="{{avatar_url}}"
                          alt=""
                          />
                        <div class="cf-awareness-card__main">
                            <header class="cf-awareness-card__meta">
                                <strong>{{sender_name}}</strong>
                                <time datetime="{{timestamp}}">{{display_time}}</time>
                            </header>
                            <div class="cf-generated-update__label">
                                <span
                                  class="cf-generated-update__chip"
                                  >{{output_label}}</span>
                                <span
                                  class="cf-generated-update__context"
                                  >{{source_summary}}</span>
                                {{#if importance_tone}}{{> cofounder/components/status tone=importance_tone label=importance custom_classes="cf-generated-update__importance"}}{{/if}}
                                {{#if is_unread}}
                                    <span
                                      class="cf-awareness-unread"
                                      aria-label="{{t 'Unread'}}"
                                      >{{t "Unread"}}</span>
                                {{/if}}
                            </div>
                            {{#if has_reasons}}
                                <div
                                  class="cf-awareness-card__reasons"
                                  aria-label="{{t 'Why this is here'}}"
                                  >
                                    {{#each reason_labels}}
                                        <span
                                          class="cf-awareness-reason"
                                          >{{this}}</span>
                                    {{/each}}
                                </div>
                            {{/if}}
                            <div
                              id="cf-awareness-item-{{message_id}}"
                              class="cf-awareness-card__content rendered_markdown"
                              >
                                {{rendered_markdown rendered_content}}
                            </div>
                            {{#if reviewed_summary}}
                                <div class="cf-awareness-current-state">
                                    <strong>{{t "Latest state"}}</strong>
                                    <span>{{reviewed_summary}}</span>
                                </div>
                            {{/if}}
                            {{#if todo_status}}
                                <div class="cf-awareness-todo">
                                    <strong>{{t "Todo"}}</strong>
                                    <span>
                                        {{todo_status}}
                                        {{#if todo_due_date}}
                                            ·
                                            {{#tr}}Due {{todo_due_date}}{{/tr}}
                                        {{/if}}
                                    </span>
                                </div>
                            {{/if}}
                            {{> cofounder/components/source_actions integrations=sources evidence_url=evidence_url}}
                            <footer class="cf-awareness-card__footer">
                                <span>{{space_name}} · {{topic}}</span>
                                <nav aria-label="{{t 'Update actions'}}">
                                    <a href="{{message_url}}">{{t "View update"}}</a>
                                    {{#if has_history}}
                                        <a href="{{history_url}}">{{#tr}}View history ({{history_count}}){{/tr}}</a>
                                    {{/if}}
                                </nav>
                            </footer>
                        </div>
                    </div>
                </article>
            {{/each}}
        </section>
    {{/if}}
</main>
