<section class="cf-review-details" aria-label="{{t 'Disputed details'}}">
    {{#each details}}
        <article class="cf-review-detail cf-review-detail--{{state_tone}}" aria-label="{{field_label}}: {{state_label}}">
            <div class="cf-review-detail__heading">
                {{> cofounder/components/status tone=state_tone label=state_label custom_classes="cf-review-detail__state"}}
                <strong class="cf-review-detail__field">{{field_label}}</strong>
            </div>
            <p class="cf-review-detail__summary">{{summary}}</p>
            {{#if target_label}}<p class="cf-review-detail__target">{{target_label}}</p>{{/if}}
            {{#if resolution_label}}<p class="cf-review-detail__resolution" role="status">{{resolution_label}}</p>{{/if}}
            <div class="cf-review-detail__actions">
                {{#if evidence_url}}
                <button type="button" class="cf-button cf-button--ghost cf-button--compact cf-review-detail__evidence" data-cf-evidence-url="{{evidence_url}}" aria-label="{{t 'View conflicting sources' }}: {{field_label}} ({{evidence_count}})">
                    <span class="cf-button__label">{{#tr}}View conflicting sources ({{evidence_count}}){{/tr}}</span>
                </button>
                {{/if}}
                {{#if show_review_action}}
                <button type="button" class="cf-button cf-button--secondary cf-button--compact cf-review-detail__review" data-cf-review-message-id="{{../message_id}}" data-cf-review-field-path="{{field_path}}" aria-label="{{t 'Review' }}: {{field_label}}">
                    <span class="cf-button__label">{{t "Review"}}</span>
                </button>
                {{/if}}
            </div>
        </article>
    {{/each}}
</section>
