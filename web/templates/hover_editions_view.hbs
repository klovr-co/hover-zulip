<main class="cf-edition-shell" aria-labelledby="cf-edition-heading">
    <header class="cf-edition-header">
        <div class="cf-edition-header__topline">
            <span class="cf-edition-marker">{{edition_marker}}</span>
            {{#if edition}}
                <time datetime="{{edition.covered_end}}">{{display_date}}</time>
            {{/if}}
        </div>
        <h1 id="cf-edition-heading">
            {{#if edition}}
                {{edition.title}}
            {{else}}
                {{t "Your Daily Brief"}}
            {{/if}}
        </h1>
        <p>
            {{#if selected_morning}}
                {{t
                  "A calm, useful look at what deserves your attention today."
                  }}
            {{else}}
                {{t
                  "A thoughtful close to what moved, what finished, and what can wait safely."
                  }}
            {{/if}}
        </p>

        <div
          class="cf-edition-tabs"
          role="tablist"
          aria-label="{{t 'Choose an edition'}}"
          >
            <button
              id="cf-edition-tab-morning"
              type="button"
              class="cf-edition-tab"
              data-edition="morning"
              role="tab"
              aria-controls="cf-edition-panel-morning"
              aria-selected="{{morning_aria_selected}}"
              tabindex="{{morning_tabindex}}"
              >{{t "Morning"}}</button>
            <button
              id="cf-edition-tab-end-of-day"
              type="button"
              class="cf-edition-tab"
              data-edition="end_of_day"
              role="tab"
              aria-controls="cf-edition-panel-end-of-day"
              aria-selected="{{end_of_day_aria_selected}}"
              tabindex="{{end_of_day_tabindex}}"
              >{{t "End of day"}}</button>
        </div>
    </header>

    <div
      id="{{active_panel_id}}"
      role="tabpanel"
      aria-labelledby="{{active_tab_id}}"
      aria-busy="{{panel_aria_busy}}"
      tabindex="0"
      >
        <div
          class="{{status_class}}"
          role="{{status_role}}"
          aria-live="{{status_aria_live}}"
          tabindex="-1"
          >
            {{status}}
            {{#if show_retry}}
                {{> cofounder/components/button id="cf-edition-retry" variant="secondary" label=(t "Retry")}}
            {{/if}}
        </div>

        {{#if loading}}
            <div class="cf-edition-loading" aria-hidden="true">
                <span></span><span></span><span></span>
            </div>
        {{else if edition}}
            <div
              class="cf-edition-view-controls"
              aria-label="{{t 'Reading view'}}"
              >
                {{#if all_mode}}
                    {{#if has_items}}
                        {{> cofounder/components/button id="cf-edition-focus-view" variant="ghost" icon="panel-left" label=(t "Focus view") custom_classes="cf-edition-view-button"}}
                    {{/if}}
                {{else}}
                    {{> cofounder/components/button id="cf-edition-view-all" variant="ghost" icon="list" label=(t "View all") custom_classes="cf-edition-view-button"}}
                {{/if}}
            </div>

            {{#if focus_mode}}
                {{#if current_slide}}
                    <section
                      class="cf-edition-carousel"
                      role="region"
                      aria-roledescription="carousel"
                      aria-label="{{t 'Daily Brief focus view'}}"
                      tabindex="0"
                      >
                        <div
                          class="cf-edition-carousel__progress"
                          role="status"
                          aria-live="polite"
                          >
                            {{t
                              "Item {slide_number} of {slide_count}"
                            slide_number=slide_number
                            slide_count=slide_count
                        }}
                        </div>
                        <article
                          class="cf-edition-passage cf-edition-slide"
                          aria-roledescription="slide"
                          aria-label="{{t
                          'Item {slide_number} of {slide_count}'
                          slide_number=slide_number
                          slide_count=slide_count
                          }}"
                          >
                            <span
                              class="cf-edition-section-label"
                              >{{current_slide.section_label}}</span>
                            <h2>{{current_slide.title}}</h2>
                            <p>{{current_slide.detail}}</p>
                            <div class="cf-edition-passage__actions">
                                <a
                                  class="cf-edition-update-link"
                                  href="{{current_slide.update.url}}"
                                  >
                                    {{t "Open update"}}
                                    <span>{{current_slide.update.space_name}}
                                        ·
                                        {{current_slide.update.topic}}</span>
                                </a>
                                {{#if current_slide.update.evidence_url}}
                                    <button
                                      type="button"
                                      class="cf-edition-sources-link"
                                      data-cf-evidence-url="{{current_slide.update.evidence_url}}"
                                      aria-haspopup="dialog"
                                      >{{t "View sources"}}</button>
                                {{/if}}
                            </div>
                        </article>
                        <div class="cf-edition-carousel__controls">
                            {{#if can_go_previous}}
                                {{> cofounder/components/button id="cf-edition-previous" variant="secondary" icon="chevron-left" aria-label=(t "Previous item") custom_classes="cf-edition-carousel__button"}}
                            {{else}}
                                {{> cofounder/components/button id="cf-edition-previous" variant="secondary" icon="chevron-left" aria-label=(t "Previous item") custom_classes="cf-edition-carousel__button" disabled=true}}
                            {{/if}}
                            {{#if can_go_next}}
                                {{> cofounder/components/button id="cf-edition-next" variant="secondary" icon="chevron-right" aria-label=(t "Next item") custom_classes="cf-edition-carousel__button"}}
                            {{else}}
                                {{> cofounder/components/button id="cf-edition-next" variant="secondary" icon="chevron-right" aria-label=(t "Next item") custom_classes="cf-edition-carousel__button" disabled=true}}
                            {{/if}}
                        </div>
                    </section>
                {{else}}
                    <p class="cf-edition-empty">
                        {{t
                          "There are no confirmed updates to feature in this edition."
                          }}
                    </p>
                {{/if}}
            {{else}}
                <div class="cf-edition-scroll" aria-label="{{t 'Full edition'}}">
                    {{#each sections}}
                        {{#if has_items}}
                            <section
                              class="cf-edition-section"
                              aria-labelledby="cf-edition-section-{{key}}"
                              >
                                <h2
                                  id="cf-edition-section-{{key}}"
                                  >
                                    {{label}}
                                </h2>
                                {{#each items}}
                                    <article class="cf-edition-passage">
                                        <h3>{{title}}</h3>
                                        <p>{{detail}}</p>
                                        <div class="cf-edition-passage__actions">
                                            <a
                                              class="cf-edition-update-link"
                                              href="{{update.url}}"
                                              >
                                                {{t "Open update"}}
                                                <span>{{update.space_name}}
                                                    ·
                                                    {{update.topic}}</span>
                                            </a>
                                            {{#if update.evidence_url}}
                                                <button
                                                  type="button"
                                                  class="cf-edition-sources-link"
                                                  data-cf-evidence-url="{{update.evidence_url}}"
                                                  aria-haspopup="dialog"
                                                  >{{t "View sources"}}</button>
                                            {{/if}}
                                        </div>
                                    </article>
                                {{/each}}
                            </section>
                        {{/if}}
                    {{/each}}
                    {{#if edition.all_clear}}
                        <aside class="cf-edition-all-clear">
                            <span aria-hidden="true">{{> cofounder/components/icon name="check"}}</span>
                            <div>
                                <h2>{{t "Everything else is moving well"}}</h2>
                                <p>
                                    {{t
                                      "Nothing else in your confirmed Spaces needs your attention right now."
                                      }}
                                </p>
                            </div>
                        </aside>
                    {{else}}
                        {{#unless has_items}}
                            <p class="cf-edition-empty">
                                {{t
                                  "There are no confirmed updates to feature in this edition."
                                  }}
                            </p>
                        {{/unless}}
                    {{/if}}
                </div>
            {{/if}}
        {{/if}}
    </div>
    <div
      id="{{inactive_panel_id}}"
      role="tabpanel"
      aria-labelledby="{{inactive_tab_id}}"
      hidden
      >
    </div>
</main>
