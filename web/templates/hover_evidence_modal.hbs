{{#if loading}}
    <p role="status" aria-live="polite">
        {{t
            "Resolving the exact source messages…"
        }}
    </p>
{{else if error}}
    {{#if retryable}}
        <div
            class="alert alert-warning show"
            role="alert"
            tabindex="-1"
            data-hover-evidence-result
        >
            {{t "Sources are temporarily unavailable. Please try again."}}
            <button
                type="button"
                class="button rounded small hover-evidence-retry"
                data-evidence-url="{{evidence_url}}"
            >
                {{t "Retry"}}
            </button>
        </div>
    {{else}}
        <div
            class="alert alert-error show"
            role="alert"
            tabindex="-1"
            data-hover-evidence-result
        >
            {{t "These sources are no longer available."}}
        </div>
    {{/if}}
{{else if empty}}
    <p tabindex="-1" data-hover-evidence-result>
        {{t "No exact source messages are available for this update."}}
    </p>
{{else}}
    <ol class="hover-evidence-list" tabindex="-1" data-hover-evidence-result>
        {{#each evidence}}
            <li>
                <div>
                    <strong>{{sender.display_name}}</strong>
                    ·
                    <time
                        datetime="{{timestamp}}"
                    >
                        {{display_timestamp}}
                    </time>
                </div>
                {{#if content.text}}
                    <p>{{content.text}}</p>
                {{/if}}
                {{#if content.voice_transcript}}
                    <p>{{content.voice_transcript}}</p>
                {{/if}}
                {{#if content.media_description}}
                    <p>{{content.media_description}}</p>
                {{/if}}
                {{#if media}}
                    {{#unless content.media_description}}
                        <p>
                            <em>
                                {{t
                                    "Media evidence"
                                }}
                                ·
                                {{media.type}}
                            </em>
                        </p>
                    {{/unless}}
                    {{#unless media.available}}
                        <p>
                            <em>
                                {{t
                                    "Media is no longer available."
                                }}
                            </em>
                        </p>
                    {{/unless}}
                {{/if}}
            </li>
        {{/each}}
    </ol>
{{/if}}
