{{#if loading}}
    <p role="status" aria-live="polite">{{t "Resolving the exact source messages…"}}</p>
{{else if error}}
    {{#if retryable}}
        <div class="cf-notice cf-notice--warning cf-evidence-result" role="alert" tabindex="-1" data-cf-evidence-result>
            <div class="cf-notice__body">
                <p class="cf-notice__content">{{t "Sources are temporarily unavailable. Please try again."}}</p>
                <div class="cf-notice__actions">
                    {{> cofounder/components/button variant="secondary" label=(t "Retry") cf_evidence_retry_url=evidence_url}}
                </div>
            </div>
        </div>
    {{else}}
        <div class="cf-notice cf-notice--danger cf-evidence-result" role="alert" tabindex="-1" data-cf-evidence-result>
            <div class="cf-notice__body">
                <p class="cf-notice__content">{{t "These sources are no longer available."}}</p>
            </div>
        </div>
    {{/if}}
{{else if empty}}
    <p tabindex="-1" data-cf-evidence-result>
        {{t "No exact source messages are available for this update."}}
    </p>
{{else}}
    <ol class="cf-evidence-list" tabindex="-1" data-cf-evidence-result>
        {{#each evidence}}
            <li>
                <div>
                    <strong>{{sender.display_name}}</strong>
                    ·
                    <time datetime="{{timestamp}}">{{display_timestamp}}</time>
                </div>
                {{#if content.text}}
                    <p>{{content.text}}</p>
                {{/if}}
                {{#if content.voice_transcript}}
                    <p>{{content.voice_transcript}}</p>
                {{/if}}
                {{#if content.media_description}}
                    <p>{{content.media_description}}</p>
                {{/if}}
                {{#if media}}
                    {{#unless content.media_description}}
                        <p><em>{{t "Media evidence"}} · {{media.type}}</em></p>
                    {{/unless}}
                    {{#unless media.available}}
                        <p><em>{{t "Media is no longer available."}}</em></p>
                    {{/unless}}
                {{/if}}
            </li>
        {{/each}}
    </ol>
{{/if}}
