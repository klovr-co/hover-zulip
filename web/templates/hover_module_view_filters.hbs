<section
  class="cf-feed-controls"
  data-cf-feed-controls="module"
  aria-label="{{t 'Filter Module updates'}}"
  >
    <div class="cf-feed-controls__heading">
        <span class="cf-feed-controls__eyebrow">{{space_name}}</span>
        <span class="cf-feed-controls__title">
            <strong>{{module_name}}</strong>
            <small>{{t "Current insights with history on demand"}}</small>
        </span>
    </div>
    <div
      class="cf-feed-controls__rail"
      role="group"
      aria-label="{{t 'Module history display'}}"
      >
        <button
          type="button"
          class="cf-feed-filter cf-feed-filter--selected"
          data-cf-feed-history="latest"
          aria-pressed="true"
          >{{t "Latest insights"}}</button>
        <button
          type="button"
          class="cf-feed-filter"
          data-cf-feed-history="all"
          aria-pressed="false"
          >{{t "Full history"}}</button>
    </div>
    <p class="cf-feed-controls__status" aria-live="polite">
        {{t
          "Showing the latest state of each insight. Earlier updates remain in Full history."
          }}
    </p>
</section>
