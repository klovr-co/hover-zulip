<div class="hover-pipelines-shell">
    {{#if is_index}}
        <header class="hover-pipelines-index-header">
            <div>
                <h1>{{t "Pipelines"}}</h1>
                <p>{{t "Automated summaries from your connected data."}}</p>
            </div>
            {{#if can_create}}
                <button type="button" class="button rounded sea-green hover-pipeline-create">{{t "Create pipeline"}}</button>
            {{/if}}
        </header>
        <div class="hover-pipeline-index-tools">
            <label class="hover-pipeline-search">
                <i class="zulip-icon zulip-icon-search"></i>
                <input type="search" class="hover-pipeline-index-search" value="{{index_query}}" placeholder="{{t 'Search pipelines'}}" />
            </label>
            <div class="hover-pipeline-filters">
                <button data-pipeline-filter="all" class="{{filter_all_class}}">{{t "All"}}</button>
                <button data-pipeline-filter="active" class="{{filter_active_class}}">{{t "Active"}}</button>
                <button data-pipeline-filter="draft" class="{{filter_draft_class}}">{{t "Drafts"}}</button>
            </div>
        </div>
        <div class="hover-pipeline-table-wrap">
            <table class="hover-pipeline-table">
                <thead><tr><th>{{t "Pipeline"}}</th><th>{{t "Data source"}}</th><th>{{t "Schedule"}}</th><th>{{t "Status"}}</th><th>{{t "Last run"}}</th></tr></thead>
                <tbody>
                    {{#if has_pipelines}}
                        {{#each pipelines}}
                            <tr>
                                <td data-label="{{t 'Pipeline'}}"><strong>{{name}}</strong><small>{{instruction}}</small></td>
                                <td data-label="{{t 'Data source'}}"><div class="hover-pipeline-provider">{{#if provider_logo_url}}<img src="{{provider_logo_url}}" alt="" />{{else}}<span class="hover-pipeline-provider-fallback">{{provider_initial}}</span>{{/if}}<span>{{source_name}}</span></div></td>
                                <td data-label="{{t 'Schedule'}}">{{schedule_label}}</td>
                                <td data-label="{{t 'Status'}}"><span class="hover-pipeline-status hover-pipeline-status--{{status}}"><i></i>{{status_label}}</span></td>
                                <td data-label="{{t 'Last run'}}">{{last_run_label}}</td>
                            </tr>
                        {{/each}}
                    {{else}}
                        <tr class="hover-pipeline-empty"><td colspan="5"><strong>{{empty_heading}}</strong><span>{{empty_description}}</span></td></tr>
                    {{/if}}
                </tbody>
            </table>
        </div>
        <p class="hover-pipeline-one-source-note">{{t "Each pipeline uses one data source."}}</p>
    {{else}}
        <ol class="hover-pipeline-steps">
            <li class="{{step_one_class}}"><span>{{#if step_one_complete}}<i class="zulip-icon zulip-icon-check"></i>{{else}}1{{/if}}</span>{{t "Choose a data source"}}</li>
            <li class="{{step_two_class}}"><span>{{#if step_two_complete}}<i class="zulip-icon zulip-icon-check"></i>{{else}}2{{/if}}</span>{{t "Configure pipeline"}}</li>
            <li class="{{step_three_class}}"><span>3</span>{{t "Review"}}</li>
        </ol>
        {{#if is_select}}
            <section class="hover-pipeline-stage hover-pipeline-source-select">
                <button type="button" class="button-reset-style hover-pipeline-back" data-pipeline-back="index"><i class="zulip-icon zulip-icon-arrow-left"></i>{{t "Back to pipelines"}}</button>
                <header class="hover-pipeline-create-header">
                    <span class="hover-pipeline-kicker">{{t "Pipeline"}}</span>
                    <h1>{{t "Create a pipeline"}}</h1>
                    <p>{{t "Choose an existing data source, then define how Hover should summarize its messages."}}</p>
                </header>
                <h2>{{t "Choose one data source"}}</h2>
                <p>{{t "Only data sources you can access are shown."}}</p>
                <div class="hover-pipeline-index-tools">
                    <label class="hover-pipeline-search"><i class="zulip-icon zulip-icon-search"></i><input type="search" class="hover-pipeline-source-search" value="{{source_query}}" placeholder="{{t 'Search data sources'}}" /></label>
                    <div class="hover-pipeline-filters">
                        <button data-pipeline-source-filter="all" class="{{source_filter_all_class}}">{{t "All"}}</button>
                        <button data-pipeline-source-filter="connected" class="{{source_filter_connected_class}}">{{t "Connected"}}</button>
                        <button data-pipeline-source-filter="attention" class="{{source_filter_attention_class}}">{{t "Needs attention"}}</button>
                    </div>
                    <a href="#hover/data-sources" class="hover-pipeline-manage-sources">{{t "Manage data sources"}}</a>
                </div>
                <div class="hover-pipeline-source-list">
                    {{#if has_sources}}
                        {{#each sources}}
                            <button type="button" class="hover-pipeline-source-choice {{selected_class}}" data-source-id="{{id}}">
                                <span class="hover-pipeline-source-radio"></span>
                                {{#if provider_logo_url}}<img src="{{provider_logo_url}}" alt="" />{{/if}}
                                <span class="hover-pipeline-source-identity"><strong>{{name}}</strong><small>{{provider_name}}</small></span>
                                <span class="hover-pipeline-source-destination">{{t "Publishes to:"}} {{destination}} › {{topic}}</span>
                                <span class="hover-pipeline-status hover-pipeline-status--{{status_key}}"><i></i>{{status_label}}</span>
                                <span class="hover-pipeline-source-last">{{last_event}}</span>
                            </button>
                        {{/each}}
                    {{else}}
                        <div class="hover-pipeline-source-empty">{{t "No available data sources. Add or fix one in Data Sources first."}}</div>
                    {{/if}}
                </div>
                <p class="hover-pipeline-stage-note">{{t "This pipeline will read messages published by the selected data source."}}</p>
                <div class="hover-pipeline-actions">
                    <button type="button" class="button-reset-style hover-pipeline-back" data-pipeline-back="index">{{t "Cancel"}}</button>
                    <button type="button" class="button rounded sea-green hover-pipeline-primary hover-pipeline-source-continue">{{t "Continue"}}</button>
                </div>
            </section>
        {{else if is_configure}}
            <section class="hover-pipeline-stage hover-pipeline-configure">
                <button type="button" class="button-reset-style hover-pipeline-back" data-pipeline-back="select"><i class="zulip-icon zulip-icon-arrow-left"></i>{{t "Back to data source selection"}}</button>
                <h2>{{t "Configure pipeline"}}</h2>
                <p>{{t "Tell Hover what to summarize and when to deliver it."}}</p>
                <div class="hover-pipeline-source-summary">
                    {{#if connector.provider_logo_url}}<img src="{{connector.provider_logo_url}}" alt="" />{{/if}}
                    <span><strong>{{connector.name}}</strong><small>{{t "Reads from"}} {{connector.destination}} › {{connector.topic}}</small></span>
                    <span class="hover-pipeline-status hover-pipeline-status--active"><i></i>{{t "Connected"}}</span>
                    <button type="button" class="button rounded hover-pipeline-change-source">{{t "Change source"}}</button>
                </div>
                <div class="hover-data-source-notice">{{t "Hover will summarize new messages published by this data source since the previous run."}}</div>
                <form id="hover_pipeline_configure_form">
                    <div class="hover-pipeline-form-row"><label for="hover_pipeline_name">{{t "Pipeline name"}}</label><div><input id="hover_pipeline_name" value="{{draft.name}}" maxlength="80" required /><small>{{t "A clear name helps your team recognize this pipeline."}}</small></div></div>
                    <div class="hover-pipeline-form-row"><label for="hover_pipeline_instruction">{{t "What should Hover summarize?"}}</label><div><textarea id="hover_pipeline_instruction" maxlength="2000" required>{{draft.instruction}}</textarea><small>{{t "Hover uses this instruction to focus every summary."}}</small></div></div>
                    <div class="hover-pipeline-form-row hover-pipeline-schedule-row">
                        <label for="hover_pipeline_cadence">{{t "Schedule"}}</label>
                        <div><select id="hover_pipeline_cadence">{{#if cadence_daily}}<option value="daily" selected>{{t "Every day"}}</option>{{else}}<option value="daily">{{t "Every day"}}</option>{{/if}}{{#if cadence_weekdays}}<option value="weekdays" selected>{{t "Weekdays"}}</option>{{else}}<option value="weekdays">{{t "Weekdays"}}</option>{{/if}}{{#if cadence_weekly}}<option value="weekly" selected>{{t "Every week"}}</option>{{else}}<option value="weekly">{{t "Every week"}}</option>{{/if}}</select>{{#if cadence_weekly}}<select id="hover_pipeline_weekday"><option value="4" selected>{{t "Friday"}}</option></select>{{/if}}<span>{{t "at"}}</span><input id="hover_pipeline_time" type="time" value="{{draft.local_time}}" /><span class="hover-pipeline-timezone">{{draft.timezone}}</span></div>
                    </div>
                    <div class="hover-pipeline-form-row">
                        <label for="hover_pipeline_output_destination">{{t "Post summaries to"}}</label>
                        <div class="hover-pipeline-output-row"><select id="hover_pipeline_output_destination">{{#each output_destinations}}{{#if selected}}<option value="{{name}}" selected>{{name}}</option>{{else}}<option value="{{name}}">{{name}}</option>{{/if}}{{/each}}</select><input id="hover_pipeline_output_topic" value="{{draft.output_topic}}" maxlength="60" required /><small>{{t "Each run creates a new summary in this topic."}}</small></div>
                    </div>
                    <div class="hover-pipeline-actions"><button type="button" class="button-reset-style hover-pipeline-back" data-pipeline-back="select">{{t "Back"}}</button><button type="submit" class="button rounded sea-green hover-pipeline-primary">{{t "Review pipeline"}}</button></div>
                </form>
            </section>
        {{else if is_review}}
            <section class="hover-pipeline-stage hover-pipeline-review">
                <button type="button" class="button-reset-style hover-pipeline-back" data-pipeline-back="configure"><i class="zulip-icon zulip-icon-arrow-left"></i>{{t "Back to pipeline configuration"}}</button>
                <h2>{{t "Review pipeline"}}</h2><p>{{t "Check the details before creating your pipeline."}}</p>
                <div class="hover-pipeline-review-section"><h3>{{t "Data source"}}</h3><div>{{#if connector.provider_logo_url}}<img src="{{connector.provider_logo_url}}" alt="" />{{/if}}<strong>{{connector.name}}</strong><dl><dt>{{t "Data source:"}}</dt><dd>{{connector.name}}</dd><dt>{{t "Reads from:"}}</dt><dd>{{connector.destination}} › {{connector.topic}}</dd><dt>{{t "Status:"}}</dt><dd><span class="hover-pipeline-ready">{{t "Connected"}}</span></dd></dl></div><button type="button" class="button rounded hover-pipeline-edit-source">{{t "Edit"}}</button></div>
                <div class="hover-pipeline-review-section"><h3>{{t "Summary"}}</h3><dl><dt>{{t "Pipeline name:"}}</dt><dd>{{draft.name}}</dd><dt>{{t "Instruction:"}}</dt><dd>{{draft.instruction}}</dd></dl><button type="button" class="button rounded hover-pipeline-edit-configure">{{t "Edit"}}</button></div>
                <div class="hover-pipeline-review-section"><h3>{{t "Schedule & delivery"}}</h3><dl><dt>{{t "Schedule:"}}</dt><dd>{{review_schedule}}</dd><dt>{{t "Time zone:"}}</dt><dd>{{draft.timezone}}</dd><dt>{{t "Posts to:"}}</dt><dd>{{draft.output_destination}} › {{draft.output_topic}}</dd></dl><button type="button" class="button rounded hover-pipeline-edit-configure">{{t "Edit"}}</button></div>
                <div class="hover-pipeline-review-notice"><i class="zulip-icon zulip-icon-git-pull-request"></i>{{review_notice}}</div>
                <div class="hover-pipeline-actions"><button type="button" class="button-reset-style hover-pipeline-back" data-pipeline-back="configure">{{t "Back"}}</button><button type="button" class="button rounded sea-green hover-pipeline-primary hover-pipeline-submit">{{t "Create pipeline"}}</button></div>
                <div class="hover-pipeline-request-status"></div>
            </section>
        {{/if}}
    {{/if}}
</div>
