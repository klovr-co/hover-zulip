<details class="cf-revision-trail">
    <summary>
        {{> cofounder/components/icon name="edit" compact=true}}
        <span>{{t "Reviewed interpretation"}}</span>
        <span class="cf-revision-trail__count">{{revisions.length}} {{t "revision(s)"}}</span>
        {{> cofounder/components/icon name="chevron-down" compact=true custom_classes="cf-revision-trail__chevron"}}
    </summary>
    <ol class="cf-revision-trail__list">
        {{#each revisions}}
            <li class="cf-revision-trail__item">
                <div class="cf-revision-trail__meta">
                    <strong>{{actor.full_name}}</strong>
                    <time datetime="{{timestamp}}">{{timestamp}}</time>
                </div>
                <div class="cf-revision-trail__change">
                    <code>{{field_path}}</code>
                    <del>{{previous_value_display}}</del>
                    {{> cofounder/components/icon name="chevron-right" compact=true}}
                    <ins>{{new_value_display}}</ins>
                </div>
                {{#if reason}}<p class="cf-revision-trail__reason">{{reason}}</p>{{/if}}
            </li>
        {{/each}}
    </ol>
</details>
