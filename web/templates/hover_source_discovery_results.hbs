{{! Source collections require an explicit boolean in Zulip templates. }}
{{#if has_sources}}
    <fieldset class="hover-source-candidate-list" data-source-results="available">
        <legend>{{t "Permitted Sources"}}</legend>
        {{#each sources}}
            <label class="hover-source-candidate">
                <input
                    type="radio"
                    name="hover_source_candidate"
                    value="{{source_ref}}"
                />
                <span class="hover-source-ledger__icon" aria-hidden="true"><i
                        class="fa fa-whatsapp"
                    ></i></span>
                <span class="hover-source-candidate-copy"><strong
                    >{{display_name}}</strong><small>{{account_display_name}}
                        ·
                        {{source_type}}</small></span>
                <button
                    type="button"
                    class="button small rounded hover-source-preview-button"
                    data-source-ref="{{source_ref}}"
                >{{t "Preview"}}</button>
            </label>
        {{/each}}
    </fieldset>
    {{#if has_more}}
        <button
            type="button"
            class="button small rounded hover-source-next-button"
        >{{t "More results"}}</button>
    {{/if}}
{{else}}
    <div class="hover-source-empty-state hover-source-empty-state-compact">
        {{t
            "No permitted Sources match this search."
        }}
    </div>
{{/if}}
