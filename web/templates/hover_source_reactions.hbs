<div class="hover-source-reactions" aria-label="{{t 'Knowledge sources'}}">
    <span class="hover-source-reactions__label">{{t "Sources"}}</span>
    {{#if evidence_url}}
        <button
          type="button"
          class="hover-source-pill hover-view-evidence"
          data-evidence-url="{{evidence_url}}"
          aria-haspopup="dialog"
          >
            {{t "View sources"}}
        </button>
    {{/if}}
    {{#each integrations}}
        <div class="message_reaction_container">
            {{#if url}}
                <a
                  class="hover-source-pill hover-source-reaction hover-source-reaction--{{key}}"
                  href="{{url}}"
                  target="_blank"
                  rel="noopener noreferrer"
                  aria-label="{{name}}"
                  title="{{name}}"
                  >
                    <i
                      class="{{icon_class}} hover-source-reaction__icon"
                      aria-hidden="true"
                      ></i>
                    <span class="message_reaction_count">{{count}}</span>
                </a>
            {{else}}
                <span
                  class="hover-source-pill hover-source-reaction hover-source-reaction--{{key}}"
                  aria-label="{{name}}"
                  title="{{name}}"
                  >
                    <i
                      class="{{icon_class}} hover-source-reaction__icon"
                      aria-hidden="true"
                      ></i>
                    <span class="message_reaction_count">{{count}}</span>
                </span>
            {{/if}}
        </div>
    {{/each}}
</div>
