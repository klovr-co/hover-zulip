<article class="cf-source-record" data-record-id="{{id}}" role="listitem">
    <header class="cf-source-record__header">
        <strong>{{sender_display_name}}</strong>
        <time datetime="{{timestamp}}">{{display_time}}</time>
    </header>
    {{#if reply_context}}
        <blockquote
          class="cf-source-record__reply"
          aria-label="{{t 'Quoted reply'}}"
          >
            <strong>{{reply_context.sender_display_name}}</strong>
            <span>{{reply_context.excerpt}}</span>
        </blockquote>
    {{/if}}
    {{#if content.text}}
        <p class="cf-source-record__text">{{content.text}}</p>
    {{/if}}
    {{#if content.voice_transcript}}
        <div
          class="cf-source-record__transcript"
          aria-label="{{t 'Voice transcript'}}"
          >
            <span class="cf-source-record__content-label">{{t "Voice transcript"}}</span>
            <p>{{content.voice_transcript}}</p>
        </div>
    {{/if}}
    {{#if content.media_description}}
        <p>{{content.media_description}}</p>
    {{/if}}
    {{#if media}}
        <div class="cf-source-record__media" aria-label="{{t 'Media attachment'}}">
            <span aria-hidden="true">{{> cofounder/components/icon name="paperclip"}}</span>
            <span>
                {{media.type}}
                {{#if media.mime_type}}
                    ·
                    {{media.mime_type}}
                {{/if}}
                {{#if media.display_size}}
                    ·
                    {{media.display_size}}
                {{/if}}
            </span>
            {{#unless media.available}}
                <span class="cf-source-record__media-unavailable">{{t "Unavailable"}}</span>
            {{/unless}}
        </div>
    {{/if}}
</article>
