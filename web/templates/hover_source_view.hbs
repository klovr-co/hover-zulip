<div class="cf-source-view__shell">
    <header class="cf-source-view__header">
        <div class="cf-source-view__breadcrumb">
            {{space_name}}
            <span aria-hidden="true">/</span>
            {{t "Sources"}}
        </div>
        <div class="cf-source-view__title-row">
            <span class="cf-source-view__provider-icon" aria-hidden="true">
                {{> cofounder/components/icon name=provider_icon}}
            </span>
            <h1>{{source.display_name}}</h1>
            {{> cofounder/components/status tone="neutral" label=(t "Source records · Read-only") custom_classes="cf-source-view__readonly-status"}}
            {{#if source.is_history_retained}}
                {{> cofounder/components/status tone="warning" label=(t "History retained") custom_classes="cf-source-view__retained-status"}}
            {{/if}}
        </div>
        <div class="cf-source-view__metadata">
            <span>{{source.account_display_name}}</span>
            <span aria-hidden="true">&middot;</span>
            <span>{{source.source_type}}</span>
        </div>
        <p>{{t "These records came from the connected Source. Replies and other actions are unavailable here."}}</p>
        <form id="cf-source-search-form" class="cf-source-view__search" role="search">
            <label class="cf-field__label" for="cf-source-search">{{t "Search this Source"}}</label>
            <div class="cf-source-view__search-controls">
                <input
                  id="cf-source-search"
                  class="cf-field__control"
                  type="search"
                  value="{{query}}"
                  maxlength="100"
                  autocomplete="off"
                  />
                {{> cofounder/components/button type="submit" variant="secondary" label=(t "Search")}}
            </div>
        </form>
    </header>
    <div
      class="cf-source-view__status"
      role="status"
      aria-live="polite"
      >
        {{status}}
    </div>
    {{#if show_load_older}}
        {{> cofounder/components/button id="cf-source-load-older" variant="secondary" label=(t "Load older") custom_classes="cf-source-view__page-action"}}
    {{/if}}
    {{#if show_retry}}
        {{> cofounder/components/button id="cf-source-retry" variant="secondary" label=(t "Retry") custom_classes="cf-source-view__page-action"}}
    {{/if}}
    <div
      class="cf-source-view__record-list"
      role="list"
      aria-label="{{t 'Source records'}}"
      >
        {{#each date_groups}}
            <section class="cf-source-view__date-group">
                <h2>{{date_label}}</h2>
                {{{records_html}}}
            </section>
        {{/each}}
    </div>
</div>
