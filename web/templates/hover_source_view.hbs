<div class="cf-source-view__shell">
    <header class="cf-source-view__header">
        <div class="cf-source-view__breadcrumb">
            {{space_name}}
            <span aria-hidden="true">/</span>
            {{t "Sources"}}
        </div>
        <div class="cf-source-view__title-row">
            <span class="cf-source-view__provider-icon" aria-hidden="true">
                {{> cofounder/components/icon name=provider_icon}}
            </span>
            <h1>{{source.display_name}}</h1>
            {{> cofounder/components/status tone="neutral" label=(t "Read-only records") custom_classes="cf-source-view__readonly-status"}}
            {{#if source.is_history_retained}}
                {{> cofounder/components/status tone="warning" label=(t "History retained") custom_classes="cf-source-view__retained-status"}}
            {{/if}}
        </div>
        <div class="cf-source-view__metadata">
            <span>{{source.account_display_name}}</span>
            <span aria-hidden="true">&middot;</span>
            <span>{{source.source_type}}</span>
        </div>
        <p>{{t "These records came from the connected Source. Replies and other actions are unavailable here."}}</p>
        <form id="cf-source-search-form" class="cf-source-view__search" role="search">
            <label class="cf-field__label" for="cf-source-search">{{t "Search this Source"}}</label>
            <div class="cf-source-view__search-controls">
                <input
                  id="cf-source-search"
                  class="cf-field__control"
                  type="search"
                  value="{{query}}"
                  maxlength="100"
                  autocomplete="off"
                  aria-controls="cf-source-record-list"
                  aria-describedby="cf-source-view-status"
                  />
                {{> cofounder/components/button type="submit" variant="secondary" label=(t "Search")}}
            </div>
        </form>
    </header>
    <div
      class="cf-source-view__status{{#if has_error}} cf-source-view__status--error{{/if}}{{#if is_empty}} cf-source-view__status--empty{{/if}}"
      id="cf-source-view-status"
      role="status"
      aria-live="polite"
      aria-atomic="true"
      >
        {{#if is_loading}}
            {{> cofounder/components/icon name="loader-circle" compact=true custom_classes="cf-source-view__loading-indicator"}}
        {{else if has_error}}
            {{> cofounder/components/icon name="warning" compact=true custom_classes="cf-source-view__error-indicator"}}
        {{else if is_empty}}
            {{> cofounder/components/icon name=empty_icon custom_classes="cf-source-view__empty-indicator"}}
        {{/if}}
        <span class="cf-source-view__status-message">{{status}}</span>
        {{#if is_empty}}
            <span class="cf-source-view__empty-hint">{{empty_hint}}</span>
        {{/if}}
    </div>
    {{#if show_load_older}}
        {{> cofounder/components/button id="cf-source-load-older" variant="secondary" label=(t "Load older") custom_classes="cf-source-view__page-action"}}
    {{/if}}
    {{#if show_retry}}
        {{> cofounder/components/button id="cf-source-retry" variant="secondary" label=(t "Retry") aria-label=(t "Retry loading Source records") custom_classes="cf-source-view__page-action"}}
    {{/if}}
    <div
      id="cf-source-record-list"
      class="cf-source-view__record-list"
      role="list"
      aria-label="{{t 'Source records'}}"
      aria-busy="{{#if is_loading}}true{{else}}false{{/if}}"
      >
        {{#each date_groups}}
            <section class="cf-source-view__date-group">
                <h2>{{date_label}}</h2>
                {{{records_html}}}
            </section>
        {{/each}}
    </div>
</div>
