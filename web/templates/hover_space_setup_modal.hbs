<form id="hover_source_attachment_form">
    <div class="hover-space-setup-summary">
        <div class="hover-space-setup-kicker">{{t "Private Setup"}}</div>
        <h2>{{space.name}}</h2>
        <div class="hover-space-setup-category">
            <i
              class="zulip-icon zulip-icon-folder"
              aria-hidden="true"
              ></i>
            {{space.category.name}}
        </div>
        {{#if space.description}}<p>{{space.description}}</p>{{/if}}
        <p class="settings-field-description">
            {{t "This Space has no channel, subscribers, or notifications until it is launched."}}
        </p>
    </div>

    {{! Render attached Source metadata only when the caller confirms it is nonempty. }}
    {{#if has_attachments}}
        <section
          class="hover-setup-attached-sources"
          aria-label="{{t 'Attached sources'}}"
          >
            <h3>{{t "Sources"}}</h3>
            <ul>
                {{#each space.attachments}}
                    <li>
                        <span
                          class="hover-source-ledger__icon"
                          aria-hidden="true"
                          >
                            {{#if (eq source.provider_key "whatsapp")}}
                                <i class="fa fa-whatsapp"></i>
                            {{else}}
                                <i class="fa fa-plug"></i>
                            {{/if}}
                        </span>
                        <span>
                            <strong>{{source.display_name}}</strong>
                            <small>{{source.account_display_name}}
                                ·
                                {{source.source_type}}</small>
                        </span>
                    </li>
                {{/each}}
            </ul>
        </section>
    {{/if}}

    <section
      id="hover-space-membership-panel"
      class="hover-space-membership-panel"
      >
        <div class="hover-source-attachment-heading">
            <div>
                <p class="hover-space-setup-kicker">{{t "Access review"}}</p>
                <h3>{{t "Teammates"}}</h3>
            </div>
            <span class="hover-source-private-badge">
                <i
                  class="fa fa-eye-slash"
                  aria-hidden="true"
                  ></i>
                {{t "Admins only in Setup"}}
            </span>
        </div>

        {{#each space.membership_suggestions}}
            <div class="hover-member-row">
                <span>
                    <strong>{{full_name}}</strong>
                    <small>{{t "Verified internal match"}}</small>
                </span>
                <span class="hover-member-role">
                    {{#if (eq suggested_role "contributor")}}
                        {{t "Contributor"}}
                    {{else}}
                        {{t "Subscriber"}}
                    {{/if}}
                </span>
                <button
                  type="button"
                  class="button rounded small"
                  data-membership-action="confirm-suggestion"
                  data-user-id="{{user_id}}"
                  data-role="{{suggested_role}}"
                  >{{t "Confirm"}}</button>
                <button
                  type="button"
                  class="button rounded small"
                  data-membership-action="remove"
                  data-user-id="{{user_id}}"
                  >{{t "Remove"}}</button>
            </div>
        {{/each}}

        {{#each space.memberships}}
            <div class="hover-member-row">
                <span>
                    <strong>{{full_name}}</strong>
                    <small>
                        {{#if is_administrator}}
                            {{t "Space Admin"}}
                        {{else}}
                            {{t "Confirmed member"}}
                        {{/if}}
                    </small>
                </span>
                <span class="hover-member-role">
                    {{#if (eq role "contributor")}}
                        {{t "Contributor"}}
                    {{else}}
                        {{t "Subscriber"}}
                    {{/if}}
                </span>
                {{#unless is_administrator}}
                    <button
                      type="button"
                      class="button rounded small"
                      data-membership-action="promote"
                      data-user-id="{{user_id}}"
                      >{{t "Make admin"}}</button>
                    <button
                      type="button"
                      class="button rounded small"
                      data-membership-action="remove"
                      data-user-id="{{user_id}}"
                      >{{t "Remove"}}</button>
                {{/unless}}
            </div>
        {{/each}}

        {{#if has_eligible_users}}
            <div class="hover-member-add-row">
                <label for="hover_member_user">{{t "Add an internal teammate"}}</label>
                <select id="hover_member_user" class="modal_select">
                    {{#each eligible_users}}
                        <option
                          value="{{user_id}}"
                          >
                            {{full_name}}
                        </option>
                    {{/each}}
                </select>
                <select
                  id="hover_member_role"
                  class="modal_select"
                  aria-label="{{t 'Role'}}"
                  >
                    <option value="contributor">{{t "Contributor"}}</option>
                    <option value="subscriber">{{t "Subscriber"}}</option>
                </select>
                <button
                  type="button"
                  class="button rounded hover-member-add-button"
                  >{{t "Add teammate"}}</button>
            </div>
        {{/if}}

        <div class="hover-space-launch-row">
            <span>
                <strong>{{t "Ready to launch?"}}</strong>
                <small>{{t "Launch creates one private channel and subscribes only confirmed members."}}</small>
            </span>
            <button
              type="button"
              class="button rounded sea-green hover-space-launch-button"
              >{{t "Launch Space"}}</button>
        </div>
    </section>

    <section
      id="hover-source-attachment-panel"
      class="hover-source-attachment-panel"
      >
        <div class="hover-source-attachment-heading">
            <div>
                <p class="hover-space-setup-kicker">
                    {{t "Connected discovery"}}
                </p>
                <h3>{{t "Attach a Source"}}</h3>
            </div>
            <span class="hover-source-private-badge">
                <i
                  class="fa fa-lock"
                  aria-hidden="true"
                  ></i>
                {{t "Safe metadata only"}}
            </span>
        </div>
        {{! Account collections require an explicit boolean in Zulip templates. }}
        {{#if has_accounts}}
            <div class="hover-source-discovery-controls">
                <label for="hover_source_account">{{t "Assigned account"}}</label>
                <select id="hover_source_account" class="modal_select">
                    {{#each accounts}}
                        <option value="{{id}}">
                            {{provider_name}}
                            ·
                            {{display_name}}
                        </option>
                    {{/each}}
                </select>
                <label for="hover_source_query">{{t "Find a permitted conversation"}}</label>
                <div class="hover-source-search-row">
                    <input
                      id="hover_source_query"
                      type="search"
                      maxlength="100"
                      autocomplete="off"
                      placeholder="{{t 'Search by Source name'}}"
                      />
                    <button
                      type="button"
                      class="button rounded hover-source-search-button"
                      >{{t "Search"}}</button>
                </div>
            </div>
            <div id="hover_source_discovery_status" class="hover-source-discovery-status" aria-live="polite"></div>
            <div id="hover_source_discovery_results"></div>
            <div id="hover_source_preview" class="hover-source-preview hide"></div>
            <div class="hover-source-window-grid">
                <div>
                    <label for="hover_source_history_window">{{t "History window"}}</label>
                    <select
                      id="hover_source_history_window"
                      class="modal_select"
                      >
                        <option value="today">{{t "Today"}}</option>
                        <option value="last_30_days">{{t "Last 30 days"}}</option>
                        <option value="custom">{{t "Custom start date"}}</option>
                    </select>
                    <p class="settings-field-description">
                        {{t "History is always bounded. All available history is never selected automatically."}}
                    </p>
                </div>
                <div class="hover-source-custom-date hide">
                    <label for="hover_source_custom_start_date">{{t "Start date"}}</label>
                    <input id="hover_source_custom_start_date" type="date" />
                </div>
            </div>
        {{else}}
            <div class="hover-source-empty-state">
                <i class="fa fa-plug" aria-hidden="true"></i>
                <p>
                    {{t "You need an approved Connected Account grant before discovering Sources."}}
                </p>
            </div>
        {{/if}}
    </section>
</form>
