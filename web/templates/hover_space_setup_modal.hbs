<form id="cf-space-setup-form" class="cf-space-workbench">
    <header class="cf-space-workbench__summary">
        <div class="cf-space-workbench__identity">
            <h2>{{space.name}}</h2>
            <div class="cf-space-workbench__category">
                {{> cofounder/components/icon name="folder-cog" compact=true}}
                <span>{{space.category.name}}</span>
            </div>
        </div>
        {{#if space.description}}
            <p class="cf-space-workbench__description">{{space.description}}</p>
        {{/if}}
        <p class="cf-space-workbench__setup-note">
            {{> cofounder/components/icon name="lock" compact=true}}
            <span>{{t
                    "This Space has no members or notifications until it is launched."
                }}</span>
        </p>
    </header>

    {{! Render attached Source metadata only when the caller confirms it is nonempty. }}
    {{#if has_attachments}}
        <section
          class="cf-space-workbench__section cf-space-workbench__section--sources"
          aria-labelledby="cf-space-sources-heading"
          >
            <div class="cf-space-workbench__section-heading">
                <h3 id="cf-space-sources-heading">{{t "Sources"}}</h3>
            </div>
            <ul class="cf-space-workbench__source-list">
                {{#each space.attachments}}
                    <li class="cf-space-workbench__source-row">
                        <span
                          class="cf-source-ledger__icon"
                          aria-hidden="true"
                          >
                            {{> cofounder/components/icon name=icon_name compact=true}}
                        </span>
                        <span class="cf-space-workbench__row-copy">
                            <strong>{{source.display_name}}</strong>
                            <small>{{source.account_display_name}}
                                ·
                                {{source.source_type}}</small>
                        </span>
                    </li>
                {{/each}}
            </ul>
        </section>
    {{/if}}

    <section
      class="cf-space-workbench__section cf-space-workbench__section--modules"
      data-cf-space-panel="modules"
      aria-labelledby="cf-space-modules-heading"
      >
        <div class="cf-space-workbench__section-heading">
            <div>
                <h3 id="cf-space-modules-heading">{{t "AI Modules"}}</h3>
                <p>{{t "Pinned automation"}}</p>
            </div>
            {{> cofounder/components/status tone="neutral" icon="pin" label=(t "Version pinned")}}
        </div>
        {{#if has_module_installations}}
            <div class="cf-space-workbench__installed-list">
                {{#each space.module_installations}}
                    <div class="cf-space-workbench__installed-row">
                        <span class="cf-space-workbench__row-copy">
                            <strong>{{name}}</strong>
                            <small>{{t "Version"}}
                                {{version}}
                                ·
                                {{state}}</small>
                        </span>
                        {{#unless (eq state "disabled")}}
                            <button
                              type="button"
                              class="cf-button cf-button--secondary cf-button--compact"
                              data-cf-space-action="disable-module"
                              data-cf-installation-id="{{id}}"
                              >
                                <span class="cf-button__label">{{t "Disable"}}</span>
                            </button>
                        {{/unless}}
                    </div>
                {{/each}}
            </div>
        {{/if}}
        {{#if has_module_catalog}}
            <div class="cf-space-workbench__module-catalog">
                {{#each module_catalog}}
                    {{#unless is_installed}}
                        <article
                          class="cf-space-workbench__module"
                          data-cf-module-card
                          data-cf-version-id="{{id}}"
                          >
                            <div class="cf-space-workbench__module-heading">
                                <span
                                  class="cf-space-workbench__module-icon"
                                  aria-hidden="true"
                                  >
                                    {{> cofounder/components/icon name=icon_name compact=true}}
                                </span>
                                <span class="cf-space-workbench__row-copy">
                                    <strong>{{name}}</strong>
                                    <small>{{t "Version"}}
                                        {{version}}
                                        ·
                                        {{destination_topic}}</small>
                                </span>
                            </div>
                            <p class="cf-space-workbench__module-description">{{description}}</p>
                            <fieldset class="cf-space-workbench__source-bindings">
                                <legend>{{t "Bind attached Sources"}}</legend>
                                {{#each attachments}}
                                    <label class="cf-space-workbench__check-row">
                                        <input
                                          type="checkbox"
                                          value="{{id}}"
                                          data-cf-module-attachment
                                          />
                                        <span>{{source.display_name}}</span>
                                    </label>
                                {{/each}}
                            </fieldset>
                            <div class="cf-space-workbench__policy-grid">
                                <label class="cf-field">
                                    <span class="cf-field__label">{{t "Trigger"}}</span>
                                    <select
                                      class="cf-field__control"
                                      data-cf-module-trigger
                                      >
                                        {{#if supports_manual}}
                                            <option value="manual">{{t "Manual"}}</option>
                                        {{/if}}
                                        {{#if supports_new_source}}
                                            <option value="new_source">{{t "New Source"}}</option>
                                        {{/if}}
                                        {{#if supports_schedule}}
                                            <option value="schedule">{{t "Schedule"}}</option>
                                        {{/if}}
                                    </select>
                                </label>
                                <div
                                  class="cf-space-workbench__debounce hide"
                                  data-cf-module-debounce
                                  >
                                    <span>{{t "Debounce"}}</span>
                                    <strong>{{t "5 minutes"}}</strong>
                                </div>
                                <div
                                  class="cf-space-workbench__schedule-fields hide"
                                  data-cf-module-schedule
                                  >
                                    <label class="cf-field">
                                        <span class="cf-field__label">{{t "Cadence"}}</span>
                                        <select
                                          class="cf-field__control"
                                          data-cf-module-cadence
                                          >
                                            <option value="daily">{{t "Daily"}}</option>
                                            <option value="weekly">{{t "Weekly"}}</option>
                                        </select>
                                    </label>
                                    <label class="cf-field">
                                        <span class="cf-field__label">{{t "Local time"}}</span>
                                        <input
                                          class="cf-field__control"
                                          type="time"
                                          value="09:00"
                                          data-cf-module-local-time
                                          />
                                    </label>
                                </div>
                            </div>
                            <details class="cf-space-workbench__backfill">
                                <summary>{{t "Earlier bounded history"}}</summary>
                                <label class="cf-field">
                                    <span class="cf-field__label">{{t
                                            "Start after Source availability"
                                        }}</span>
                                    <input
                                      class="cf-field__control"
                                      type="datetime-local"
                                      data-cf-module-backfill-start
                                      />
                                </label>
                                <label class="cf-space-workbench__check-row">
                                    <input
                                      type="checkbox"
                                      data-cf-module-backfill-confirm
                                      />
                                    <span>{{t
                                            "I confirm this earlier bounded backfill."
                                        }}</span>
                                </label>
                            </details>
                            <button
                              type="button"
                              class="cf-button cf-button--primary cf-space-workbench__module-action"
                              data-cf-space-action="install-module"
                              >
                                {{> cofounder/components/icon name="plus" compact=true}}
                                <span class="cf-button__label">{{t "Enable Module"}}</span>
                            </button>
                        </article>
                    {{/unless}}
                {{/each}}
            </div>
        {{/if}}
    </section>

    <section
      id="cf-space-membership-panel"
      class="cf-space-workbench__section cf-space-workbench__section--members"
      data-cf-space-panel="members"
      aria-labelledby="cf-space-members-heading"
      >
        <div class="cf-space-workbench__section-heading">
            <div>
                <h3 id="cf-space-members-heading">{{t "Teammates"}}</h3>
                <p>{{t "Access review"}}</p>
            </div>
            {{> cofounder/components/status tone="neutral" icon="eye-off" label=(t "Admins only in Setup")}}
        </div>

        <div class="cf-space-workbench__member-list">
            {{#each space.membership_suggestions}}
                <div class="cf-space-workbench__member-row" data-cf-member-row>
                    <span class="cf-space-workbench__row-copy">
                        <strong>{{full_name}}</strong>
                        <small>{{t "Verified internal match"}}</small>
                    </span>
                    <select
                      class="cf-field__control cf-space-workbench__role-select"
                      data-cf-member-role
                      data-cf-user-id="{{user_id}}"
                      aria-label="{{t 'Role'}}: {{full_name}}"
                      >
                        {{#if (eq suggested_role "contributor")}}
                            <option value="contributor" selected>{{t "Contributor"}}</option>
                            <option value="subscriber">{{t "Subscriber"}}</option>
                        {{else}}
                            <option value="contributor">{{t "Contributor"}}</option>
                            <option value="subscriber" selected>{{t "Subscriber"}}</option>
                        {{/if}}
                    </select>
                    <button
                      type="button"
                      class="cf-button cf-button--secondary cf-button--compact"
                      data-cf-membership-action="confirm-suggestion"
                      data-cf-user-id="{{user_id}}"
                      >
                        <span class="cf-button__label">{{t "Confirm"}}</span>
                    </button>
                    <button
                      type="button"
                      class="cf-button cf-button--ghost cf-button--compact"
                      data-cf-membership-action="remove"
                      data-cf-user-id="{{user_id}}"
                      >
                        <span class="cf-button__label">{{t "Remove"}}</span>
                    </button>
                </div>
            {{/each}}

            {{#each space.memberships}}
                <div class="cf-space-workbench__member-row" data-cf-member-row>
                    <span class="cf-space-workbench__row-copy">
                        <strong>{{full_name}}</strong>
                        <small>
                            {{#if is_administrator}}
                                {{t "Space Admin"}}
                            {{else}}
                                {{t "Confirmed member"}}
                            {{/if}}
                        </small>
                    </span>
                    {{#if is_administrator}}
                        <span class="cf-space-workbench__member-role">
                            {{#if (eq role "contributor")}}
                                {{t "Contributor"}}
                            {{else}}
                                {{t "Subscriber"}}
                            {{/if}}
                        </span>
                    {{else}}
                        <select
                          class="cf-field__control cf-space-workbench__role-select"
                          data-cf-member-role
                          data-cf-user-id="{{user_id}}"
                          aria-label="{{t 'Role'}}: {{full_name}}"
                          >
                            {{#if (eq role "contributor")}}
                                <option value="contributor" selected>{{t "Contributor"}}</option>
                                <option value="subscriber">{{t "Subscriber"}}</option>
                            {{else}}
                                <option value="contributor">{{t "Contributor"}}</option>
                                <option value="subscriber" selected>{{t "Subscriber"}}</option>
                            {{/if}}
                        </select>
                    {{/if}}
                    {{#unless is_administrator}}
                        <button
                          type="button"
                          class="cf-button cf-button--secondary cf-button--compact"
                          data-cf-membership-action="promote"
                          data-cf-user-id="{{user_id}}"
                          >
                            <span class="cf-button__label">{{t "Make admin"}}</span>
                        </button>
                        <button
                          type="button"
                          class="cf-button cf-button--ghost cf-button--compact"
                          data-cf-membership-action="remove"
                          data-cf-user-id="{{user_id}}"
                          >
                            <span class="cf-button__label">{{t "Remove"}}</span>
                        </button>
                    {{/unless}}
                </div>
            {{/each}}
        </div>

        {{#if has_eligible_users}}
            <div class="cf-space-workbench__member-add">
                <label class="cf-field" for="cf-member-user">
                    <span class="cf-field__label">{{t "Add an internal teammate"}}</span>
                    <select id="cf-member-user" class="cf-field__control">
                        {{#each eligible_users}}
                            <option value="{{user_id}}">{{full_name}}</option>
                        {{/each}}
                    </select>
                </label>
                <label class="cf-field" for="cf-member-role">
                    <span class="cf-field__label">{{t "Role"}}</span>
                    <select id="cf-member-role" class="cf-field__control">
                        <option value="contributor">{{t "Contributor"}}</option>
                        <option value="subscriber">{{t "Subscriber"}}</option>
                    </select>
                </label>
                <button
                  type="button"
                  class="cf-button cf-button--secondary"
                  data-cf-space-action="add-member"
                  >
                    {{> cofounder/components/icon name="user-plus" compact=true}}
                    <span class="cf-button__label">{{t "Add teammate"}}</span>
                </button>
            </div>
        {{/if}}

        <div class="cf-space-workbench__launch-row">
            <div class="cf-space-workbench__launch-copy">
                <span class="cf-space-workbench__row-copy">
                    {{#if launch_ready}}
                        <strong>{{t "Ready for final launch check"}}</strong>
                    {{else}}
                        <strong>{{t "Complete launch requirements"}}</strong>
                    {{/if}}
                    <small>{{t "Launch activates this private Space for confirmed members only."}}</small>
                </span>
                <ul
                  id="cf-space-launch-requirements"
                  class="cf-space-workbench__launch-requirements"
                  aria-label="{{t 'Launch requirements'}}"
                  >
                    {{#each launch_requirements}}
                        <li data-state="{{#if met}}met{{else}}open{{/if}}">
                            {{> cofounder/components/icon name=icon_name compact=true}}
                            <span>{{label}}</span>
                        </li>
                    {{/each}}
                </ul>
            </div>
            <button
              type="button"
              class="cf-button cf-button--primary"
              data-cf-space-action="launch-space"
              aria-describedby="cf-space-launch-requirements"
              {{#unless launch_ready}}disabled{{/unless}}
              >
                {{> cofounder/components/icon name="rocket" compact=true}}
                <span class="cf-button__label">
                    {{#if launch_ready}}
                        {{t "Run final check & launch"}}
                    {{else}}
                        {{t "Launch blocked"}}
                    {{/if}}
                </span>
            </button>
        </div>
    </section>

    <section
      id="cf-source-attachment-panel"
      class="cf-space-workbench__section cf-space-workbench__section--source-panel"
      data-cf-space-panel="source"
      aria-labelledby="cf-source-attachment-heading"
      >
        <div class="cf-space-workbench__section-heading">
            <div>
                <h3 id="cf-source-attachment-heading">{{t "Attach a Source"}}</h3>
                <p>{{t "Connected discovery"}}</p>
            </div>
            {{> cofounder/components/status tone="accent" icon="shield" label=(t "Safe metadata only")}}
        </div>
        {{! Account collections require an explicit boolean in Zulip templates. }}
        {{#if has_accounts}}
            <div class="cf-space-workbench__source-controls">
                <label class="cf-field" for="cf-source-account">
                    <span class="cf-field__label">{{t "Assigned account"}}</span>
                    <select id="cf-source-account" class="cf-field__control">
                        {{#each accounts}}
                            <option value="{{id}}">
                                {{provider_name}}
                                ·
                                {{display_name}}
                            </option>
                        {{/each}}
                    </select>
                </label>
                <div class="cf-field">
                    <label class="cf-field__label" for="cf-source-query">{{t
                            "Find a permitted conversation"
                        }}</label>
                    <div class="cf-space-workbench__search-row">
                        <input
                          id="cf-source-query"
                          class="cf-field__control"
                          type="search"
                          maxlength="100"
                          autocomplete="off"
                          placeholder="{{t 'Search by Source name'}}"
                          />
                        <button
                          type="button"
                          class="cf-button cf-button--secondary"
                          data-cf-space-action="search-source"
                          >
                            {{> cofounder/components/icon name="search" compact=true}}
                            <span class="cf-button__label">{{t "Search"}}</span>
                        </button>
                    </div>
                </div>
            </div>
            <div
              id="cf-source-discovery-status"
              class="cf-space-workbench__discovery-status"
              data-state="ready"
              aria-live="polite"
              >
            </div>
            <div id="cf-source-discovery-results"></div>
            <div
              id="cf-source-preview"
              class="cf-space-workbench__source-preview hide"
              aria-live="polite"
              >
            </div>
            <div class="cf-space-workbench__history-grid">
                <label class="cf-field" for="cf-source-history-window">
                    <span class="cf-field__label">{{t "History window"}}</span>
                    <select id="cf-source-history-window" class="cf-field__control">
                        <option value="today">{{t "Today"}}</option>
                        <option value="last_30_days">{{t "Last 30 days"}}</option>
                        <option value="custom">{{t "Custom start date"}}</option>
                    </select>
                    <span class="cf-field__hint">{{t
                            "History is always bounded. All available history is never selected automatically."
                        }}</span>
                </label>
                <label
                  class="cf-field hide"
                  for="cf-source-custom-start-date"
                  data-cf-source-custom-date
                  >
                    <span class="cf-field__label">{{t "Start date"}}</span>
                    <input
                      id="cf-source-custom-start-date"
                      class="cf-field__control"
                      type="date"
                      />
                </label>
            </div>
        {{else}}
            <div class="cf-space-workbench__empty-state">
                {{> cofounder/components/icon name="link-alt"}}
                <p>{{t "You need an approved Connected Account grant before discovering Sources."}}</p>
            </div>
        {{/if}}
    </section>
</form>
