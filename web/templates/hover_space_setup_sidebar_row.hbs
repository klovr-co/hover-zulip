<li class="cf-space-setup narrow-filter" data-cf-space-id="{{id}}">
    <a
      href="#hover/space/{{id}}/setup"
      class="cf-space-setup__main"
      draggable="false"
      >
        <span class="cf-space-setup__icon">
            {{> cofounder/components/icon name="lock" compact=true}}
        </span>
        <span class="cf-space-setup__name">{{name}}</span>
        <span class="cf-space-setup__status">{{t "Setup"}}</span>
    </a>
    {{! Keep the source ledger absent until the first attachment exists. }}
    {{#if has_hover_attached_sources}}
        <section
          class="cf-source-ledger"
          aria-label="{{t 'Attached sources'}}"
          >
            <div class="cf-source-ledger__header">
                <span>{{t "Sources"}}</span>
            </div>
            <ul class="cf-source-ledger__list">
                {{#each hover_attached_sources}}
                    <li>
                        <a
                          class="cf-source-ledger__item"
                          href="{{url}}"
                          data-cf-source-key="{{source_key}}"
                          >
                            <span
                              class="cf-source-ledger__icon"
                              aria-hidden="true"
                              >{{> cofounder/components/icon name=icon_name compact=true}}</span>
                            <span class="cf-source-ledger__copy">
                                <span
                                  class="cf-source-ledger__name"
                                  >{{name}}</span>
                                <span
                                  class="cf-source-ledger__detail"
                                  >{{detail}}</span>
                            </span>
                        </a>
                    </li>
                {{/each}}
            </ul>
        </section>
    {{/if}}
</li>
