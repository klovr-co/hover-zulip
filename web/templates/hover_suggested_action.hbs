<section
  class="hover-suggested-action"
  data-hover-suggested-action-message-id="{{message_id}}"
  aria-label="{{t 'Suggested Action'}}"
  tabindex="-1"
  >
    <div class="hover-suggested-action__heading">
        <h4>{{t "Suggested Action"}}</h4>
        <span class="hover-suggested-action__state">
            {{#if is_pending}}{{t "Awaiting confirmation"}}{{/if}}
            {{#if is_approved}}
                {{#if todo_is_completed}}
                    {{t "Completed Todo"}}
                {{else}}
                    {{t "Active Todo"}}
                {{/if}}
            {{/if}}
            {{#if is_not_action}}{{t "Not an action"}}{{/if}}
        </span>
    </div>
    <p class="hover-suggested-action__wording">{{wording}}</p>
    <dl class="hover-suggested-action__facts">
        <div><dt>{{t "Responsibility"}}</dt><dd>{{responsibility}}</dd></div>
        <div><dt>{{t "Due"}}</dt><dd>{{due_date}}</dd></div>
    </dl>
    {{#if is_not_action}}
        <p class="hover-suggested-action__history">
            {{#tr}}Marked by {{latest_actor}} at {{latest_time}}{{/tr}}
            {{#if latest_reason}} — {{latest_reason}}{{/if}}
        </p>
    {{/if}}
    {{#if is_approved}}
        <div
          class="hover-suggested-action__todo"
          data-hover-todo-id="{{todo_id}}"
          tabindex="0"
          >
            <p>
                {{#if todo_is_active}}{{#tr}}Todo #{{todo_id}}
                        is active{{/tr}}{{/if}}
                {{#if todo_is_completed}}{{#tr}}Todo #{{todo_id}}
                        is completed{{/tr}}{{/if}}
            </p>
            <p>{{#tr}}Assigned to {{todo_assignee}}{{/tr}}</p>
            {{#if todo_latest_actor}}
                <p>
                    {{#tr}}
                        Last changed by {{todo_latest_actor}} at {{todo_latest_time}}
                    {{/tr}}
                </p>
            {{/if}}
            <div class="hover-suggested-action__controls">
                {{#if todo_is_active}}
                    <label>
                        <span>{{t "Assign to"}}</span>
                        <select
                          data-hover-todo-assignee
                          aria-label="{{t 'Assign Todo'}}"
                          >
                            {{#if todo_has_assignee}}
                                <option value="{{todo_assignee_user_id}}">
                                    {{todo_assignee}}
                                </option>
                            {{else}}
                                <option value="">
                                    {{t "Choose a teammate"}}
                                </option>
                            {{/if}}
                            {{#each todo_assignable_users}}
                                <option value="{{this.user_id}}">
                                    {{this.full_name}}
                                </option>
                            {{/each}}
                        </select>
                    </label>
                    <button
                      type="button"
                      class="button rounded"
                      data-hover-todo-operation="assign"
                      data-hover-todo-id="{{todo_id}}"
                      >{{t "Assign"}}</button>
                    <button
                      type="button"
                      class="button rounded sea-green"
                      data-hover-todo-operation="complete"
                      data-hover-todo-id="{{todo_id}}"
                      >{{t "Complete"}}</button>
                {{/if}}
                {{#if todo_is_completed}}
                    <button
                      type="button"
                      class="button rounded"
                      data-hover-todo-operation="reopen"
                      data-hover-todo-id="{{todo_id}}"
                      >{{t "Reopen"}}</button>
                {{/if}}
            </div>
            <span
              class="hover-suggested-action__status"
              data-hover-todo-status
              role="status"
              aria-live="polite"
              ></span>
        </div>
    {{else}}
        <div class="hover-suggested-action__controls">
            {{#if is_pending}}
                <div class="hover-suggested-action__refinements">
                    <label>
                        <span>{{t "Action wording"}}</span>
                        <textarea
                          maxlength="50000"
                          data-hover-action-wording
                          aria-label="{{t 'Action wording'}}"
                          >{{wording}}</textarea>
                    </label>
                    <label>
                        <span>{{t "Assign to"}}</span>
                        <select
                          data-hover-action-assignee
                          aria-label="{{t 'Suggested Action assignee'}}"
                          >
                            <option value="">{{t "Unassigned"}}</option>
                            {{#if approval_has_assignee}}
                                <option value="{{approval_assignee_user_id}}" selected>
                                    {{responsibility}}
                                </option>
                            {{/if}}
                            {{#each approval_assignable_users}}
                                <option value="{{this.user_id}}">{{this.full_name}}</option>
                            {{/each}}
                        </select>
                    </label>
                    <label>
                        <span>{{t "Due date"}}</span>
                        <input
                          type="date"
                          value="{{approval_due_date}}"
                          data-hover-action-due-date
                          aria-label="{{t 'Suggested Action due date'}}"
                          />
                    </label>
                </div>
                <button
                  type="button"
                  class="button rounded sea-green"
                  data-hover-action-decision="approve"
                  data-hover-message-id="{{message_id}}"
                  >{{t "Approve"}}</button>
                <input
                  type="text"
                  maxlength="1000"
                  data-hover-action-reason
                  aria-label="{{t 'Optional reason for Not an action'}}"
                  placeholder="{{t 'Optional reason'}}"
                  />
                <button
                  type="button"
                  class="button rounded"
                  data-hover-action-decision="not_action"
                  data-hover-message-id="{{message_id}}"
                  >{{t "Not an action"}}</button>
            {{/if}}
            {{#if is_not_action}}
                <button
                  type="button"
                  class="button rounded"
                  data-hover-action-decision="restore"
                  data-hover-message-id="{{message_id}}"
                  >{{t "Restore"}}</button>
            {{/if}}
        </div>
    {{/if}}
    <span
      class="hover-suggested-action__status"
      data-hover-action-status
      role="status"
      aria-live="polite"
      ></span>
</section>
