<div
  id="reminders-overlay"
  class="overlay"
  data-overlay="reminders"
  data-cf-todos="true"
  tabindex="-1"
  >
    <div class="flex overlay-content">
        <main
          class="overlay-messages-container overlay-container reminders-container cf-todos"
          aria-labelledby="cf-todos-heading"
          >
            <div class="overlay-messages-header">
                <div>
                    <h1 id="cf-todos-heading">{{t "Todos"}}</h1>
                    <p>{{t "Accountable work from your Spaces"}}</p>
                </div>
                {{> cofounder/components/icon_button intent="neutral" icon="close" aria-label=(t "Close") custom_classes="exit cf-todos__close" omit_legacy_classes=true}}
            </div>
            <div class="cf-todos__list" aria-live="polite">
                {{#if empty}}
                    <section
                      class="cf-todos__empty"
                      aria-labelledby="cf-todos-empty-heading"
                      aria-describedby="cf-todos-empty-description"
                      >
                        <strong id="cf-todos-empty-heading">{{t "No Todos yet."}}</strong>
                        <p id="cf-todos-empty-description">
                            {{t "Approved Suggested Actions will appear here."}}
                        </p>
                    </section>
                {{/if}}
                {{#each todos}}
                    <article
                      class="cf-todo-card{{#if is_completed}} cf-todo-card--completed{{else}} cf-todo-card--active{{/if}}"
                      data-cf-todo-id="{{id}}"
                      tabindex="0"
                      aria-labelledby="cf-todo-card-heading-{{id}}"
                      >
                        <div class="cf-todo-card__heading">
                            <span class="cf-todo-card__space">{{space.name}}</span>
                            {{> cofounder/components/status tone=state_tone label=state_label custom_classes="cf-todo-card__state"}}
                        </div>
                        <h2 id="cf-todo-card-heading-{{id}}">{{wording}}</h2>
                        <dl class="cf-todo-card__facts">
                            <div>
                                <dt>{{t "Assignee"}}</dt>
                                <dd data-cf-todo-assignee-label>{{assignee_label}}</dd>
                            </div>
                            <div>
                                <dt>{{t "Due"}}</dt>
                                <dd>{{due_label}}</dd>
                            </div>
                        </dl>
                        {{#if latest_event}}
                            <p class="cf-todo-card__history">
                                {{#tr}}
                                    Last changed by
                                    {{latest_event.actor.full_name}}
                                    at
                                    {{latest_event.occurred_at}}
                                {{/tr}}
                            </p>
                        {{/if}}
                        <div class="cf-todo-card__links">
                            <a href="{{source_hash}}">{{t "Open in Space"}}</a>
                            {{#if generated_item.evidence_url}}
                                <button
                                  type="button"
                                  class="cf-button cf-button--ghost cf-button--compact"
                                  data-cf-evidence-url="{{generated_item.evidence_url}}"
                                  >
                                    {{#tr}}View sources ({{generated_item.evidence_count}}){{/tr}}
                                </button>
                            {{/if}}
                        </div>
                        <div class="cf-todo-card__controls">
                            {{#if is_active}}
                                <label>
                                    <span>{{t "Assign to"}}</span>
                                    <select
                                      class="cf-field__control cf-todo-card__assignee"
                                      data-cf-todo-assignee
                                      data-cf-current-assignee="{{#if assignee}}{{assignee.user_id}}{{/if}}"
                                      aria-label="{{t 'Assign to Todo'}}"
                                      >
                                        {{#if assignee}}
                                            <option
                                              value="{{assignee.user_id}}"
                                              >
                                                {{assignee.full_name}}
                                            </option>
                                        {{else}}
                                            <option value="">{{t "Choose a teammate"}}</option>
                                        {{/if}}
                                        {{#each assignable_options}}
                                            <option
                                              value="{{this.user_id}}"
                                              >
                                                {{this.full_name}}
                                            </option>
                                        {{/each}}
                                    </select>
                                </label>
                                <button
                                  type="button"
                                  class="cf-button cf-button--secondary"
                                  data-cf-todo-operation="assign"
                                  data-cf-todo-id="{{id}}"
                                  disabled
                                  >
                                    {{t "Assign"}}
                                </button>
                                <button
                                  type="button"
                                  class="cf-button cf-button--success"
                                  data-cf-todo-operation="complete"
                                  data-cf-todo-id="{{id}}"
                                  >
                                    {{t "Complete"}}
                                </button>
                            {{/if}}
                            {{#if is_completed}}
                                <button
                                  type="button"
                                  class="cf-button cf-button--secondary"
                                  data-cf-todo-operation="reopen"
                                  data-cf-todo-id="{{id}}"
                                  >
                                    {{t "Reopen"}}
                                </button>
                            {{/if}}
                        </div>
                        <span
                          class="cf-todo-card__status"
                          data-cf-todo-status
                          role="status"
                          aria-live="polite"
                          aria-atomic="true"
                          >
                        </span>
                    </article>
                {{/each}}
            </div>
        </main>
    </div>
</div>
