<form id="hover_topic_create_form" class="hover-topic-create">
    <fieldset class="hover-topic-create__types">
        <legend>{{t "Choose a topic type"}}</legend>
        <p>{{t "Pick the kind of conversation you want to create."}}</p>
        <label>
            <input
              type="radio"
              name="hover_topic_kind"
              value="regular"
              checked
              />
            <span>
                <strong>{{t "Regular"}}</strong>
                <small>
                    {{t
                      "A conversation with teammates"
                      }}
                </small>
            </span>
        </label>
        {{#if can_create_source}}
            <label>
                <input type="radio" name="hover_topic_kind" value="source" />
                <span>
                    <strong>{{t "Source"}}</strong>
                    <small>
                        {{t
                          "Live GitHub or PostHog activity"
                          }}
                    </small>
                </span>
            </label>
        {{/if}}
        {{#if can_create_summary}}
            <label>
                <input type="radio" name="hover_topic_kind" value="summary" />
                <span>
                    <strong>{{t "Summary"}}</strong>
                    <small>
                        {{t
                          "A scheduled overview from selected topics"
                          }}
                    </small>
                </span>
            </label>
        {{/if}}
    </fieldset>

    <section class="hover-topic-create__panel" data-hover-topic-panel="regular">
        <header class="hover-topic-create__section-heading">
            <h3>{{t "Name your topic"}}</h3>
            <p>{{t "Use a short name your teammates will recognize."}}</p>
        </header>
        <div class="hover-topic-create__field">
            <label for="hover_regular_topic_name">{{t "Topic name"}}</label>
            <input
              id="hover_regular_topic_name"
              type="text"
              maxlength="60"
              value="{{prefilled_topic}}"
              required
              />
            <small>
                {{t
                  "The topic is created when you send its first message."
                  }}
            </small>
        </div>
    </section>

    <section
      class="hover-topic-create__panel hide"
      data-hover-topic-panel="source"
      >
        <header class="hover-topic-create__section-heading">
            <h3>{{t "Choose a live source"}}</h3>
            <p>
                {{t
                  "Create a dedicated GitHub or PostHog webhook, or attach an approved destination."
                  }}
            </p>
        </header>
        <fieldset class="hover-topic-create__options">
            <legend>{{t "Setup method"}}</legend>
            <label>
                <input type="radio" name="hover_source_mode" value="native" checked />
                <span>{{t "Create a live webhook"}}</span>
            </label>
            {{#if has_accounts}}
                <label>
                    <input type="radio" name="hover_source_mode" value="existing" />
                    <span>{{t "Use an approved connected account"}}</span>
                </label>
            {{/if}}
        </fieldset>
        <div data-hover-source-mode="native">
            <div class="hover-topic-create__field">
                <label for="hover_topic_source_provider">{{t "Provider"}}</label>
                <select id="hover_topic_source_provider">
                    <option value="github">GitHub</option>
                    <option value="posthog">PostHog</option>
                </select>
            </div>
            <div class="hover-topic-create__field">
                <label for="hover_topic_native_source_name">{{t "Source name"}}</label>
                <input id="hover_topic_native_source_name" type="text" maxlength="100" />
                <small>{{t "For example, a repository or PostHog project name."}}</small>
            </div>
        </div>
        {{#if has_accounts}}
            <div class="hide" data-hover-source-mode="existing">
                <div class="hover-topic-create__field">
                    <label for="hover_topic_source_account">
                        {{t
                          "Connected account"
                          }}
                    </label>
                    <select id="hover_topic_source_account">
                        {{#each accounts}}
                            <option value="{{this.id}}">
                                {{this.provider_name}}
                                ·
                                {{this.display_name}}
                            </option>
                        {{/each}}
                    </select>
                </div>
                <div class="hover-topic-create__source-search">
                    <input
                      id="hover_topic_source_query"
                      type="search"
                      placeholder="{{t 'Search permitted Sources'}}"
                      />
                    <button id="hover_topic_source_search" type="button">
                        {{t
                          "Search"
                          }}
                    </button>
                </div>
                <p id="hover_topic_source_status" aria-live="polite"></p>
                <div id="hover_topic_source_results"></div>
            </div>
        {{/if}}
        <div id="hover_topic_native_source_result" class="hide" aria-live="polite">
            <h4>{{t "Webhook ready"}}</h4>
            <p>{{t "Copy this URL now. It contains the Source credential."}}</p>
            <div class="hover-topic-create__source-search">
                <input id="hover_topic_native_webhook_url" type="text" readonly />
                <button id="hover_topic_copy_webhook" type="button">{{t "Copy"}}</button>
            </div>
            <p class="hide" data-hover-native-guidance="github">
                {{t
                  "Add it as a GitHub repository webhook, choose application/json, and send the events you want summarized."
                  }}
            </p>
            <p class="hide" data-hover-native-guidance="posthog">
                {{t
                  "Add it as a Slack Incoming webhook destination in a PostHog workflow and send a test event."
                  }}
            </p>
            <p>{{t "Rotating this webhook later invalidates this URL."}}</p>
        </div>
    </section>

    <section
      class="hover-topic-create__panel hide"
      data-hover-topic-panel="summary"
      >
        <header class="hover-topic-create__section-heading">
            <h3>{{t "Configure your Summary"}}</h3>
            <p>
                {{t
                  "Choose what it covers, when it runs, and who can read it."
                  }}
            </p>
        </header>
        <div class="hover-topic-create__field">
            <label for="hover_summary_name">{{t "Summary name"}}</label>
            <input
              id="hover_summary_name"
              type="text"
              maxlength="60"
              required
              />
        </div>
        <fieldset class="hover-topic-create__options">
            <legend>{{t "Inputs"}}</legend>
            <p>{{t "Select the topics this Summary will include."}}</p>
            {{#each summary_inputs}}
                <label>
                    <input
                      type="checkbox"
                      name="hover_summary_input"
                      value="{{this.value}}"
                      />
                    <span>
                        {{this.topic_name}}
                        <small>{{this.kind}}</small>
                    </span>
                </label>
            {{/each}}
        </fieldset>
        <fieldset class="hover-topic-create__options">
            <legend>{{t "Generation schedule"}}</legend>
            <p>{{t "Set when Hover generates a new edition."}}</p>
            <div class="hover-topic-create__schedule">
                <label for="hover_summary_interval">{{t "Generate every"}}</label>
                <select id="hover_summary_interval">
                    <option value="3600">{{t "1 hour"}}</option>
                    <option value="21600">{{t "6 hours"}}</option>
                    <option value="43200">{{t "12 hours"}}</option>
                    <option value="86400" selected>{{t "1 day"}}</option>
                    <option value="604800">{{t "1 week"}}</option>
                    <option value="custom">{{t "Custom"}}</option>
                </select>
                <label class="hide" data-hover-summary-custom for="hover_summary_custom_hours">
                    {{t "Custom hours"}}
                    <input
                      id="hover_summary_custom_hours"
                      type="number"
                      min="1"
                      max="720"
                      step="1"
                      value="24"
                      />
                </label>
                <small>{{timezone}}</small>
            </div>
        </fieldset>
        <fieldset class="hover-topic-create__options">
            <legend>{{t "Members"}}</legend>
            <p>
                {{t
                  "Only selected members can open this Summary or its history."
                  }}
            </p>
            {{#each members}}
                <label>
                    {{#if this.selected}}
                        <input
                          type="checkbox"
                          name="hover_summary_member"
                          value="{{this.user_id}}"
                          checked
                          disabled
                          />
                    {{else}}
                        <input
                          type="checkbox"
                          name="hover_summary_member"
                          value="{{this.user_id}}"
                          />
                    {{/if}}
                    <span>{{this.full_name}}</span>
                </label>
            {{/each}}
        </fieldset>
    </section>
</form>
