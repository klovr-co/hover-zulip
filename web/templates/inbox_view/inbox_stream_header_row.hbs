<div id="inbox-stream-header-{{stream_id}}" class="cf-conversation-list__row cf-conversation-list__row--channel inbox-header {{#if is_hidden}}hidden_by_filters{{/if}} {{#if is_collapsed}}inbox-collapsed-state{{/if}}" data-col-index="{{ column_indexes.FULL_ROW }}" tabindex="0" data-stream-id="{{stream_id}}" style="background: {{stream_header_color}};">
    <div class="inbox-focus-border">
        <div class="inbox-left-part-wrapper">
            <div class="inbox-left-part">
                <div class="inbox-header-name">
                    <span class="stream-privacy-original-color-{{stream_id}} stream-privacy filter-icon" style="color: {{stream_color}}">
                        {{> ../stream_privacy . }}
                    </span>
                    <span class="inbox-header-name-text">{{stream_name}}</span>
                    {{#if is_archived}}
                        <span class="inbox-header-stream-archived">
                            <span class="archived-indicator">({{t 'archived' }})</span>
                        </span>
                    {{/if}}
                </div>
                <button type="button" class="cf-conversation-list__collapse collapsible-button toggle-inbox-header-icon {{#if is_collapsed}}icon-collapsed-state{{/if}}" tabindex="-1" aria-label="{{t 'Toggle channel'}}">{{> ../cofounder/components/icon name="chevron-down" compact=true custom_classes="channel-row-chevron"}}</button>
                <span class="cf-conversation-list__mention unread_mention_info tippy-zulip-tooltip
                  {{#unless mention_in_unread}}hidden{{/unless}}"
                  data-tippy-content="{{t 'You have unread mentions'}}">@</span>
                <div class="unread-count-focus-outline" tabindex="0" data-col-index="{{ column_indexes.UNREAD_COUNT }}">
                    <span class="cf-conversation-list__badge unread_count tippy-zulip-delayed-tooltip on_hover_topic_read"
                      data-stream-id="{{stream_id}}" data-tippy-content="{{t 'Mark as read' }}"
                      aria-label="{{t 'Mark as read' }}">{{unread_count}}</span>
                </div>
            </div>
        </div>
        <div class="inbox-right-part-wrapper">
            <div class="inbox-right-part">
                {{#if is_muted}}
                <span class="channel-visibility-policy-indicator toggle-channel-visibility tippy-zulip-tooltip" data-stream-id="{{stream_id}}" tabindex="0" data-col-index="{{ column_indexes.TOPIC_VISIBILITY }}" data-tooltip-template-id="inbox-channel-mute-toggle-tooltip-template">
                    {{> ../cofounder/components/icon name="mute" compact=true custom_classes="recipient_bar_icon"}}
                </span>
                {{/if}}
                <button type="button" class="cf-conversation-list__action inbox-action-button inbox-stream-menu" data-stream-id="{{stream_id}}" tabindex="0" data-col-index="{{ column_indexes.ACTION_MENU }}" aria-label="{{t 'Channel actions'}}">
                    {{> ../cofounder/components/icon name="more-vertical" compact=true}}
                </button>
            </div>
        </div>
    </div>
</div>
