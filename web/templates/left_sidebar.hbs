<div class="left-sidebar" id="left-sidebar" role="navigation" aria-label="{{t 'Workspace navigation'}}">
    <div id="left-sidebar-search">
        <div class="input-wrapper-for-tooltip tippy-zulip-delayed-tooltip" data-tooltip-template-id="filter-left-sidebar-tooltip-template">
            {{#> components/input_wrapper input_type="filter-input" custom_classes="left-sidebar-search-section" icon="search" input_button_icon="close" input_button_aria_label=(t "Clear navigation filter") cofounder=true}}
                <input type="text" class="input-element left-sidebar-search-input" autocomplete="off" placeholder="{{#if hover_enabled}}{{t 'Filter Home and Spaces' }}{{else}}{{t 'Filter left sidebar' }}{{/if}}" aria-label="{{#if hover_enabled}}{{t 'Filter Home and Spaces' }}{{else}}{{t 'Filter left sidebar' }}{{/if}}" />
            {{/components/input_wrapper}}
        </div>
        {{> cofounder/components/icon_button id="add_streams_button" icon="plus" intent="neutral" custom_classes="add-stream-icon-container hidden-for-spectators" aria-label=(t "Browse or create channels") omit_legacy_classes=true}}
        {{> cofounder/components/icon_button icon="more-vertical" intent="neutral" custom_classes="sidebar-menu-icon channel-folders-sidebar-menu-icon hidden-for-spectators" aria-label=(t "Show channel folders") omit_legacy_classes=true}}
    </div>
    <ul id="left-sidebar-empty-list-message" class="hidden">
        {{> empty_list_widget_for_list
          empty_list_message=(t "No matches.")
          }}
    </ul>
    <div id="left-sidebar-topic-search-hint" class="hidden">
        <a tabindex="0" role="button" class="bottom_left_row left-sidebar-topic-search-hint-link">
            {{> cofounder/components/icon name="search" compact=true}}
            <span class="left-sidebar-topic-search-hint-label"></span>
        </a>
    </div>
    <div id="left-sidebar-navigation-area" class="left-sidebar-navigation-area">
        <div id="views-label-container" class="left-sidebar-section-header showing-expanded-navigation{{#if is_spectator}} remove-pointer-for-spectator{{/if}}">
            {{> cofounder/components/icon_button id="toggle-top-left-navigation-area-icon" icon="chevron-right" intent="neutral" custom_classes="cf-sidebar-heading-chevron sidebar-heading-icon rotate-icon-down views-tooltip-target hidden-for-spectators" aria-label=(t "Toggle views") omit_legacy_classes=true}}
            {{~!-- squash whitespace --~}}
            <h4 class="left-sidebar-title"><span class="views-tooltip-target">{{ LEFT_SIDEBAR_NAVIGATION_AREA_TITLE }}</span></h4>
            <ul id="left-sidebar-navigation-list-condensed" class="filters">
                {{#each primary_condensed_views}}
                    {{> left_sidebar_primary_condensed_view_item . }}
                {{/each}}
                <li class="top_left_condensed_unread_marker left-sidebar-navigation-condensed-item">
                    <span class="unread_count normal-count"></span>
                </li>
            </ul>
            {{> cofounder/components/icon_button icon="more-vertical" intent="neutral" custom_classes="left-sidebar-navigation-menu-icon" aria-label=(t "Other views") omit_legacy_classes=true}}
        </div>
        <ul id="left-sidebar-navigation-list" class="left-sidebar-navigation-list filters">
            {{> left_sidebar_expanded_view_items_list expanded_views=expanded_views}}
        </ul>
    </div>
    {{~!-- squash whitespace --~}}
    <div id="left_sidebar_scroll_container" class="scrolling_list" data-simplebar data-simplebar-tab-index="-1">
        {{> cofounder/components/dm_section_header
          id="direct-messages-section-header"
          custom_classes="zoomed-out"
          is_modal=false
          has_toggle=true
          has_filter=false
          title=LEFT_SIDEBAR_DIRECT_MESSAGES_TITLE
          }}
        <div class="direct-messages-container zoomed-out hidden-for-spectators">
            <div id="direct-messages-list"></div>
        </div>
        <div class="direct-message-section-bottom-divider-container">
            <hr class="direct-message-section-bottom-divider"/>
        </div>
        {{#if hover_enabled}}
            <div class="hover-spaces-heading">
                <h4 class="left-sidebar-title">{{t "Spaces"}}</h4>
                {{#if can_create_spaces}}
                    {{> cofounder/components/icon_button id="add_hover_space_button" icon="plus" intent="neutral" aria-label=(t "Create Space") data-tippy-content=(t "Create Space") omit_legacy_classes=true}}
                {{/if}}
            </div>
        {{/if}}
        <div id="streams_list">
            <div id="stream-filters-container">
                <ul id="stream_filters" class="filters"></ul>
                {{#unless is_guest }}
                    <div id="subscribe-to-more-streams"></div>
                {{/unless}}
                <div id="login-to-more-streams" class="only-visible-for-spectators login_button">
                    <a class="subscribe-more-link" tabindex="0">
                        {{> cofounder/components/icon name="log-in" compact=true custom_classes="subscribe-more-icon"}}
                        <span class="subscribe-more-label">{{~t "LOG IN TO BROWSE MORE" ~}}</span>
                    </a>
                </div>
            </div>
        </div>
    </div>
    <div id="left-sidebar-modal">
        <div class="left-sidebar-modal-close-area" tabindex="0">
            <div class="left-sidebar-modal-back">
                {{> cofounder/components/icon name="chevron-left" compact=true}}
                <span>Back</span>
            </div>
            {{> cofounder/components/icon name="close" compact=true custom_classes="left-sidebar-modal-close-icon"}}
        </div>
        <div id="left-sidebar-modal-content">
            <div id="direct-messages-modal" class="no-display">
                {{#> cofounder/components/dm_section_header
                  id="direct-messages-modal-section-header"
                  custom_classes=""
                  is_modal=true
                  has_toggle=false
                  has_filter=true
                  title=(t "ALL DIRECT MESSAGES")
                  }}
                    <div class="direct-messages-search-section left-sidebar-filter-input-container">
                        {{#> components/input_wrapper input_type="filter-input" icon="search" input_button_icon="close" input_button_aria_label=(t "Clear direct message filter") cofounder=true}}
                            <input type="text" class="input-element direct-messages-list-filter home-page-input" autocomplete="off" placeholder="{{t 'Filter direct messages' }}" aria-label="{{t 'Filter direct messages' }}" />
                        {{/components/input_wrapper}}
                    </div>
                {{/cofounder/components/dm_section_header}}
                <div id="modal-direct-messages-list" class="scrolling_list" data-simplebar data-simplebar-tab-index="-1"></div>
            </div>
            <div id="more-topics-modal"></div>
        </div>
    </div>
</div>
