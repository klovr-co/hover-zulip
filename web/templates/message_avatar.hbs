<div class="cf-message-item__avatar-trigger u-{{msg/sender_id}} sender_info_hover view_user_card_tooltip no-select" aria-hidden="true" data-is-bot="{{#if sender_is_bot}}true{{else}}false{{/if}}">
    <div class="cf-message-item__avatar-frame">
        <div class="cf-message-item__avatar{{#if sender_is_guest}} guest-avatar{{/if}}{{#if sender_is_deactivated}} deactivated{{/if}}{{#if is_hidden}} cf-message-item__avatar--muted muted-sender-avatar{{/if}}">
            <img loading="lazy" src="{{small_avatar_url}}" alt="" class="cf-message-item__avatar-image no-drag"/>
            {{#if sender_is_deactivated}}
                <span class="cf-message-item__avatar-state deactivated-user-icon">{{> cofounder/components/icon name="circle-off" compact=true}}</span>
            {{/if}}
        </div>
    </div>
</div>
{{~! remove whitespace ~}}
