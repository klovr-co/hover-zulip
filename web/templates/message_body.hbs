{{#if include_sender}}
    {{> message_avatar . ~}}
{{/if}}
<span class="cf-message-item__sender-line">
    {{#if include_sender}}
        <button type="button" class="cf-message-item__sender sender_info_hover">
            <span class="cf-message-item__sender-name view_user_card_tooltip" data-is-bot="{{#if sender_is_bot}}true{{else}}false{{/if}}">
                {{> user_full_name name=msg/sender_full_name should_add_guest_user_indicator=should_add_guest_indicator_for_sender is_hidden=is_hidden}}
            </span>
            {{#unless status_message}}
                {{#unless is_hidden}}
                {{> status_emoji msg/status_emoji_info}}
                {{/unless}}
            {{/unless}}
        </button>
        {{#unless is_hidden}}
            {{#if sender_is_bot}}
                <span class="cf-message-item__bot" aria-label="{{t 'Bot' }}">{{> cofounder/components/icon name="bot" compact=true}}</span>
            {{/if}}
            {{#if status_message}}
                <span class="cf-message-item__content rendered_markdown status-message">{{rendered_markdown status_message}}</span>
                {{#if message_edit_notices_for_status_message}}
                    {{> edited_notice .}}
                {{/if}}
            {{/if}}
            {{#if message_edit_notices_alongside_sender}}
                {{> edited_notice .}}
            {{/if}}
        {{/unless}}
    {{/if}}
</span>

<a {{#unless msg/locally_echoed}}href="{{ msg/url }}"{{/unless}} class="cf-message-item__time">
    {{#unless include_sender}}
    <span class="copy-paste-text">&nbsp;</span>
    {{/unless}}
    {{timestr}}
</a>

{{#if (and (not msg/failed_request) msg/locally_echoed)}}
    <span data-tooltip-template-id="slow-send-spinner-tooltip-template" class="cf-message-item__pending-indicator{{#unless msg/show_slow_send_spinner }} hidden{{/unless}}">{{> cofounder/components/icon name="loader-circle" compact=true}}</span>
{{/if}}

<div class="cf-message-actions no-select">
    {{#if msg/locally_echoed}}
        {{#if msg/failed_request}}
            {{> message_controls_failed_msg}}
            {{ else }}
            {{> message_controls .}}
        {{/if}}
    {{else}}
        {{> message_controls .}}
    {{/if}}
</div>

{{#unless status_message}}
    {{#unless is_hidden}}
    <div class="cf-message-item__content rendered_markdown">
        {{#if is_hover_response}}
        <div class="cf-review-response{{#if is_hover_review}} cf-review-response--review{{/if}}">
            <span>{{#if is_hover_review}}{{t "Review"}}{{else}}{{t "Reply"}}{{/if}}</span>
            <small>{{t "to Hover update"}}</small>
        </div>
        {{#if hover_response_clarification_required}}
        <div class="cf-review-clarification" role="status">
            <strong>{{t "Clarification needed"}}</strong>
            {{t "Choose the field and exact new value before Hover changes its interpretation."}}
        </div>
        {{/if}}
        {{#if is_hover_review_request}}
        <div class="cf-review-request">
            <strong>{{t "Review request"}}</strong>
            {{> cofounder/components/status tone=hover_review_request_state_tone label=hover_review_request_state_label custom_classes="cf-review-request__state"}}
        </div>
        {{/if}}
        {{/if}}
        {{#if is_hover_generated_update}}
        <div class="cf-generated-update__label">
            {{#if is_hover_suggested_action}}
                <span class="cf-generated-update__chip">{{#if hover_module_name}}{{hover_module_name}}{{else}}{{t "Suggested Actions"}}{{/if}}</span>
            {{else}}
                <span class="cf-generated-update__chip">{{#if hover_output_label}}{{hover_output_label}}{{else}}{{#if hover_module_name}}{{hover_module_name}}{{else}}{{t "AI update"}}{{/if}}{{/if}}</span>
            {{/if}}
            <span class="cf-generated-update__context">{{hover_source_context}}</span>
            {{#unless is_hover_suggested_action}}
                {{#if hover_state}}{{> cofounder/components/status tone=hover_state_tone label=hover_state custom_classes="cf-generated-update__state"}}{{/if}}
                {{#if hover_importance_tone}}{{> cofounder/components/status tone=hover_importance_tone label=hover_importance custom_classes="cf-generated-update__importance"}}{{/if}}
            {{/unless}}
        </div>
        {{/if}}
        {{#if use_match_properties}}
            {{rendered_markdown msg/match_content}}
        {{else}}
            {{rendered_markdown msg/content}}
        {{/if}}
        {{#if has_hover_revisions}}
            {{> hover_revision_history revisions=hover_revisions}}
        {{/if}}
        {{#if has_hover_disputed_details}}
            {{> hover_disputed_details details=hover_disputed_details message_id=msg/id}}
        {{/if}}
    </div>
    {{else}}
    <div class="cf-message-item__content rendered_markdown">
        {{> message_hidden_dialog}}
    </div>
    {{/unless}}
{{/unless}}

{{#if is_hover_suggested_action}}
    {{> hover_suggested_action hover_suggested_action}}
{{/if}}

{{#if is_hover_generated_update}}
<div class="cf-generated-update__actions" aria-label="{{t 'Update details' }}">
    <button type="button" class="cf-button cf-button--ghost cf-button--compact cf-generated-update__details" data-cf-generated-message-id="{{msg/id}}"><span class="cf-button__label">{{t "Details"}}</span></button>
    {{#if hover_has_history}}
    <button type="button" class="cf-button cf-button--ghost cf-button--compact cf-generated-update__history" data-cf-generated-message-id="{{msg/id}}"><span class="cf-button__label">{{#tr}}View history ({{hover_history_count}}){{/tr}}</span></button>
    {{/if}}
    {{#if hover_is_earlier}}<span class="cf-generated-update__earlier">{{t "Earlier state"}}</span>{{/if}}
</div>
{{/if}}

{{#if message_edit_notices_in_left_col}}
{{> edited_notice .}}
{{/if}}

<div class="cf-message-item__length-controller"></div>

{{#if has_hover_source_integrations}}
    <div class="cf-message-feedback">
        {{> cofounder/components/source_actions integrations=hover_source_integrations evidence_url=hover_evidence_url}}
        {{#unless (or is_hidden (eq msg.message_reactions.length 0))}}
            {{> message_reactions . }}
        {{/unless}}
    </div>
{{else}}
    {{#unless (or is_hidden (eq msg.message_reactions.length 0))}}
        {{> message_reactions . }}
    {{/unless}}
{{/if}}

{{#unless (eq msg.reminders.length 0)}}
    {{> message_reminders . }}
{{/unless}}
