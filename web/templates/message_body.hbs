{{#if include_sender}}
    {{> message_avatar . ~}}
{{/if}}
<span class="message_sender">
    {{#if include_sender}}
        <span class="sender_info_hover sender_name" role="button" tabindex="0">
            <span class="view_user_card_tooltip sender_name_text" data-is-bot="{{#if sender_is_bot}}true{{else}}false{{/if}}">
                {{> user_full_name name=msg/sender_full_name should_add_guest_user_indicator=should_add_guest_indicator_for_sender is_hidden=is_hidden}}
            </span>
            {{#unless status_message}}
                {{#unless is_hidden}}
                {{> status_emoji msg/status_emoji_info}}
                {{/unless}}
            {{/unless}}
        </span>
        {{#unless is_hidden}}
            {{#if sender_is_bot}}
                <i class="zulip-icon zulip-icon-bot" aria-label="{{t 'Bot' }}"></i>
            {{/if}}
            {{#if status_message}}
                <span class="message_content rendered_markdown status-message">{{rendered_markdown status_message}}</span>
                {{#if message_edit_notices_for_status_message}}
                    {{> edited_notice .}}
                {{/if}}
            {{/if}}
            {{#if message_edit_notices_alongside_sender}}
                {{> edited_notice .}}
            {{/if}}
        {{/unless}}
    {{/if}}
</span>

<a {{#unless msg/locally_echoed}}href="{{ msg/url }}"{{/unless}} class="message-time">
    {{#unless include_sender}}
    <span class="copy-paste-text">&nbsp;</span>
    {{/unless}}
    {{timestr}}
</a>

{{#if (and (not msg/failed_request) msg/locally_echoed)}}
    <span data-tooltip-template-id="slow-send-spinner-tooltip-template" class="fa fa-circle-o-notch slow-send-spinner{{#unless msg/show_slow_send_spinner }} hidden{{/unless}}"></span>
{{/if}}

<div class="message_controls no-select">
    {{#if msg/locally_echoed}}
        {{#if msg/failed_request}}
            {{> message_controls_failed_msg}}
            {{ else }}
            {{> message_controls .}}
        {{/if}}
    {{else}}
        {{> message_controls .}}
    {{/if}}
</div>

{{#unless status_message}}
    {{#unless is_hidden}}
    <div class="message_content rendered_markdown">
        {{#if is_hover_generated_update}}
        <div class="hover-generated-update-label">
            <span class="hover-generated-update-label__chip">{{#if hover_output_label}}{{hover_output_label}}{{else}}{{#if hover_module_name}}{{hover_module_name}}{{else}}{{t "AI update"}}{{/if}}{{/if}}</span>
            <span class="hover-generated-update-label__context">{{hover_source_context}}</span>
            {{#if hover_state}}<span class="hover-generated-update-state hover-generated-update-state--{{hover_state}}">{{hover_state}}</span>{{/if}}
            {{#if hover_importance}}<span class="hover-generated-update-importance hover-generated-update-importance--{{hover_importance}}">{{hover_importance}}</span>{{/if}}
        </div>
        {{/if}}
        {{#if use_match_properties}}
            {{rendered_markdown msg/match_content}}
        {{else}}
            {{rendered_markdown msg/content}}
        {{/if}}
    </div>
    {{else}}
    <div class="message_content rendered_markdown">
        {{> message_hidden_dialog}}
    </div>
    {{/unless}}
{{/unless}}

{{#if is_hover_generated_update}}
<div class="hover-generated-update-actions" aria-label="{{t 'Update details' }}">
    <button type="button" class="hover-generated-details-button" data-hover-message-id="{{msg/id}}">{{t "Details"}}</button>
    {{#if hover_has_history}}
    <button type="button" class="hover-generated-history-button" data-hover-message-id="{{msg/id}}">{{#tr}}View history ({{hover_history_count}}){{/tr}}</button>
    {{/if}}
    {{#if hover_is_earlier}}<span class="hover-generated-earlier-label">{{t "Earlier state"}}</span>{{/if}}
</div>
{{/if}}

{{#if message_edit_notices_in_left_col}}
{{> edited_notice .}}
{{/if}}

<div class="message_length_controller"></div>

{{#if has_hover_source_integrations}}
    <div class="hover-message-reactions">
        {{> hover_source_reactions integrations=hover_source_integrations evidence_url=hover_evidence_url}}
        {{#unless (or is_hidden (eq msg.message_reactions.length 0))}}
            {{> message_reactions . }}
        {{/unless}}
    </div>
{{else}}
    {{#unless (or is_hidden (eq msg.message_reactions.length 0))}}
        {{> message_reactions . }}
    {{/unless}}
{{/if}}

{{#unless (eq msg.reminders.length 0)}}
    {{> message_reminders . }}
{{/unless}}
