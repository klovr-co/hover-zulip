{{#unless is_archived}}
    {{#if msg/sent_by_me}}
        <div class="cf-message-actions__edit">
            <button type="button" class="cf-message-actions__button cf-message-actions__edit-button edit_content_button edit_message_button" aria-label="{{t 'Edit message' }} (e)">
                {{> cofounder/components/icon name="edit" size="sm"}}
            </button>
            <button type="button" class="cf-message-actions__button cf-message-actions__move-button move_message_button edit_message_button" aria-label="{{t 'Move message' }} (m)">
                {{> cofounder/components/icon name="move" size="sm"}}
            </button>
        </div>
    {{/if}}

    {{#unless msg/sent_by_me}}
        <button type="button" class="cf-message-actions__button cf-message-actions__reaction-button" data-tooltip-template-id="add-emoji-tooltip-template" aria-label="{{t 'Add emoji reaction' }} (:)" aria-haspopup="dialog">
            {{> cofounder/components/icon name="smile" size="sm"}}
        </button>
    {{/unless}}
{{/unless}}

<button type="button" class="cf-message-actions__button cf-message-actions__more-button" data-tooltip-template-id="message-actions-tooltip-template" aria-haspopup="menu" aria-label="{{t 'Message actions' }}">
    {{> cofounder/components/icon name="more-vertical" size="sm"}}
</button>

<button type="button" class="cf-message-actions__button cf-message-actions__star-button{{#if msg/starred}} cf-message-actions__star-button--selected{{/if}}" data-tooltip-template-id="{{#if msg/starred}}unstar{{else}}star{{/if}}-message-tooltip-template" aria-label="{{#if msg/starred}}{{t 'Unstar message' }}{{else}}{{t 'Star message' }}{{/if}}" aria-pressed="{{#if msg/starred}}true{{else}}false{{/if}}" {{#if msg/locally_echoed}}disabled{{/if}}>
    {{> cofounder/components/icon name="star" size="sm"}}
</button>
