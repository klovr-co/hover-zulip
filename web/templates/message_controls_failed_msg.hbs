<button type="button" class="cf-message-actions__button cf-message-actions__button--danger cf-message-actions__failed-button refresh-failed-message" data-tippy-content="{{t 'Retry' }}" aria-label="{{t 'Retry' }}">
    {{> cofounder/components/icon name="refresh" size="sm"}}
</button>

<button type="button" class="cf-message-actions__button cf-message-actions__button--danger cf-message-actions__failed-button remove-failed-message" data-tooltip-template-id="dismiss-failed-send-button-tooltip-template" aria-label="{{t 'Dismiss' }}">
    {{> cofounder/components/icon name="circle-x" size="sm"}}
</button>
