<div class="cf-message-reactions" aria-label="{{t 'Message reactions' }}">
    {{#each this/msg/message_reactions}}
        {{> message_reaction . is_archived=../is_archived}}
    {{/each}}
    {{#unless is_archived}}
        <button type="button" class="cf-message-reactions__add" aria-haspopup="dialog" data-tooltip-template-id="add-emoji-tooltip-template" aria-label="{{t 'Add emoji reaction' }} (:)">
            {{> cofounder/components/icon name="smile" size="sm"}}
            <span class="cf-message-reactions__add-label" aria-hidden="true">+</span>
        </button>
    {{/unless}}
</div>
