{{#> ../cofounder/components/notice . intent=banner_type}}
    {{#if banner_text}}
    <p class="cf-notice__content">{{banner_text}}</p>
    {{else}}
    <div class="cf-notice__content">{{> @partial-block .}}</div>
    {{/if}}
    {{#if button_text}}
    <div class="cf-notice__actions">
        {{#if button_link}}
        <a class="cf-button cf-button--secondary cf-notice__action" href="{{button_link}}">{{button_text}}</a>
        {{else}}
        <button type="button" class="cf-button cf-button--secondary cf-notice__action">{{button_text}}</button>
        {{/if}}
    </div>
    {{/if}}
{{/../cofounder/components/notice}}
