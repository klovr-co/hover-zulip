<div class="cf-menu popover-menu" data-simplebar data-simplebar-tab-index="-1">
    <ul role="menu" class="cf-menu__list popover-menu-list">
        {{#if is_home_view}}
        {{#if unread_messages_present}}
        <li role="none" class="link-item cf-menu__item popover-menu-list-item">
            <a role="menuitem" class="cf-menu__action popover-menu-link mark_all_messages_as_read" tabindex="0">
                {{> ../../cofounder/components/icon name="check" compact=true custom_classes="cf-menu__icon popover-menu-icon"}}
                <span class="cf-menu__label popover-menu-label">{{t "Mark messages as read" }}</span>
            </a>
        </li>
        {{/if}}
        <li role="none" class="link-item cf-menu__item popover-menu-list-item">
            <a role="menuitem" class="cf-menu__action popover-menu-link toggle_display_unread_message_count" tabindex="0">
                {{#if show_unread_count}}
                {{> ../../cofounder/components/icon name="eye-off" compact=true custom_classes="cf-menu__icon popover-menu-icon"}}
                <span class="cf-menu__label popover-menu-label">{{t "Hide unread counter" }}</span>
                {{else}}
                {{> ../../cofounder/components/icon name="eye" compact=true custom_classes="cf-menu__icon popover-menu-icon"}}
                <span class="cf-menu__label popover-menu-label">{{t "Show unread counter" }}</span>
                {{/if}}
            </a>
        </li>
        {{else}}
        <li role="none" class="link-item cf-menu__item popover-menu-list-item no-auto-hide-left-sidebar-overlay">
            <a role="menuitem" class="set-home-view cf-menu__action popover-menu-link" data-view-code="{{view_code}}" tabindex="0">
                {{> ../../cofounder/components/icon name="home" compact=true custom_classes="cf-menu__icon popover-menu-icon"}}
                <span class="cf-menu__label popover-menu-label">
                    {{#tr}}
                        Make <z-highlight>combined feed</z-highlight> my home view
                        {{#*inline "z-highlight"}}<b class="highlighted-element">{{> @partial-block}}</b>{{/inline}}
                    {{/tr}}
                </span>
            </a>
        </li>
        {{/if}}
    </ul>
</div>
