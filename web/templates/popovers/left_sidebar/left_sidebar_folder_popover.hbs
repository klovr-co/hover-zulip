<div
  class="cf-menu popover-menu"
  id="channel-folder-menu-popover"
  data-simplebar
  data-simplebar-tab-index="-1"
  >
    <ul role="menu" class="cf-menu__list popover-menu-list">
        <li role="none" class="link-item cf-menu__item popover-menu-list-item">
            <a
              role="menuitem"
              id="folder_popover_view_channels"
              class="cf-menu__action popover-menu-link"
              tabindex="0"
              >
                {{> ../../cofounder/components/icon name="hash" compact=true custom_classes="cf-menu__icon popover-menu-icon"}}
                <span class="cf-menu__label popover-menu-label">{{t "View channels"}}</span>
            </a>
        </li>
        {{#if can_manage_folder}}
            <li role="none" class="link-item cf-menu__item popover-menu-list-item">
                <a
                  role="menuitem"
                  id="folder_popover_manage_folder"
                  class="cf-menu__action popover-menu-link"
                  tabindex="0"
                  >
                    {{> ../../cofounder/components/icon name="folder-cog" compact=true custom_classes="cf-menu__icon popover-menu-icon"}}
                    <span class="cf-menu__label popover-menu-label">{{t
                            "Manage folder"
                        }}</span>
                </a>
            </li>
        {{/if}}
    </ul>
</div>
