<div class="cf-menu popover-menu no-auto-hide-left-sidebar-overlay" data-simplebar data-simplebar-tab-index="-1">
    <ul role="menu" class="cf-menu__list popover-menu-list">
        {{#if show_unstar_all_button}}
        <li role="none" class="link-item cf-menu__item popover-menu-list-item">
            <a role="menuitem" id="unstar_all_messages" class="cf-menu__action popover-menu-link" tabindex="0">
                {{> ../../cofounder/components/icon name="star" compact=true custom_classes="cf-menu__icon popover-menu-icon"}}
                <span class="cf-menu__label popover-menu-label">{{t "Unstar all messages" }}</span>
            </a>
        </li>
        {{/if}}
        <li role="none" class="link-item cf-menu__item popover-menu-list-item">
            <a role="menuitem" id="toggle_display_starred_msg_count" class="cf-menu__action popover-menu-link" tabindex="0">
                {{#if starred_message_counts}}
                {{> ../../cofounder/components/icon name="eye-off" compact=true custom_classes="cf-menu__icon popover-menu-icon"}}
                <span class="cf-menu__label popover-menu-label">{{t "Hide starred message count" }}</span>
                {{else}}
                {{> ../../cofounder/components/icon name="eye" compact=true custom_classes="cf-menu__icon popover-menu-icon"}}
                <span class="cf-menu__label popover-menu-label">{{t "Show starred message count" }}</span>
                {{/if}}
            </a>
        </li>
    </ul>
</div>
