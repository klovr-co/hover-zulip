<div class="cf-menu popover-menu no-auto-hide-left-sidebar-overlay" id="topic-actions-menu-popover" data-simplebar data-simplebar-tab-index="-1">
    <ul role="menu" aria-label="{{t 'Topic actions'}} — {{topic_display_name}}" class="cf-menu__list popover-menu-list">
        <li role="none" class="popover-topic-header text-item cf-menu__item popover-menu-list-item">
            <span class="popover-topic-name {{#if is_empty_string_topic}}empty-topic-display{{/if}}">{{topic_display_name}}</span>
        </li>
        {{!-- Group 1 --}}
        {{#unless is_spectator}}
            {{#unless stream_archived}}
            <li role="separator" class="cf-menu__separator popover-menu-separator"></li>
            <li role="none" class="cf-menu__item popover-menu-list-item">
                <div role="group" class="cf-menu__choice-group" aria-label="{{t 'Topic visibility' }}">
                    <input type="radio" id="sidebar-topic-muted-policy" class="cf-menu__choice-input" name="sidebar-topic-visibility-select" data-visibility-policy="{{all_visibility_policies.MUTED}}" tabindex="-1" aria-hidden="true" {{#if (eq visibility_policy all_visibility_policies.MUTED)}}checked{{/if}} />
                    <label role="menuitemradio" class="cf-menu__choice tippy-zulip-delayed-tooltip" for="sidebar-topic-muted-policy" aria-label="{{t 'Mute' }}" aria-checked="{{#if (eq visibility_policy all_visibility_policies.MUTED)}}true{{else}}false{{/if}}" data-tippy-content="{{t 'Mute' }}" tabindex="0">
                        {{> ../../cofounder/components/icon name="mute" compact=true}}
                    </label>
                    <input type="radio" id="sidebar-topic-inherit-policy" class="cf-menu__choice-input" name="sidebar-topic-visibility-select" data-visibility-policy="{{all_visibility_policies.INHERIT}}" tabindex="-1" aria-hidden="true" {{#if (eq visibility_policy all_visibility_policies.INHERIT)}}checked{{/if}} />
                    <label role="menuitemradio" class="cf-menu__choice tippy-zulip-delayed-tooltip" for="sidebar-topic-inherit-policy" aria-label="{{t 'Default' }}" aria-checked="{{#if (eq visibility_policy all_visibility_policies.INHERIT)}}true{{else}}false{{/if}}" data-tippy-content="{{t 'Default' }}" tabindex="0">
                        {{> ../../cofounder/components/icon name="inherit" compact=true}}
                    </label>
                    {{#if (or stream_muted topic_unmuted)}}
                    <input type="radio" id="sidebar-topic-unmuted-policy" class="cf-menu__choice-input" name="sidebar-topic-visibility-select" data-visibility-policy="{{all_visibility_policies.UNMUTED}}" tabindex="-1" aria-hidden="true" {{#if (eq visibility_policy all_visibility_policies.UNMUTED)}}checked{{/if}} />
                    <label role="menuitemradio" class="cf-menu__choice tippy-zulip-delayed-tooltip" for="sidebar-topic-unmuted-policy" aria-label="{{t 'Unmute' }}" aria-checked="{{#if (eq visibility_policy all_visibility_policies.UNMUTED)}}true{{else}}false{{/if}}" data-tippy-content="{{t 'Unmute' }}" tabindex="0">
                        {{> ../../cofounder/components/icon name="unmute" compact=true}}
                    </label>
                    {{/if}}
                    <input type="radio" id="sidebar-topic-followed-policy" class="cf-menu__choice-input" name="sidebar-topic-visibility-select" data-visibility-policy="{{all_visibility_policies.FOLLOWED}}" tabindex="-1" aria-hidden="true" {{#if (eq visibility_policy all_visibility_policies.FOLLOWED)}}checked{{/if}} />
                    <label role="menuitemradio" class="cf-menu__choice tippy-zulip-delayed-tooltip" for="sidebar-topic-followed-policy" aria-label="{{t 'Follow' }}" aria-checked="{{#if (eq visibility_policy all_visibility_policies.FOLLOWED)}}true{{else}}false{{/if}}" data-tippy-content="{{t 'Follow' }}" tabindex="0">
                        {{> ../../cofounder/components/icon name="follow" compact=true}}
                    </label>
                </div>
            </li>
            {{/unless}}
        {{/unless}}
        {{#if is_topic_empty}}
            <li role="separator" class="cf-menu__separator popover-menu-separator"></li>
            <li role="none" class="cf-menu__item popover-menu-list-item text-item italic">
                <span class="cf-menu__label popover-menu-label">{{t "There are no messages in this topic." }}</span>
            </li>
        {{else}}
            {{!-- Group 2 --}}
            <li role="separator" class="cf-menu__separator popover-menu-separator"></li>
            {{#if (and show_ai_features can_summarize_topics)}}
            <li role="none" class="link-item cf-menu__item popover-menu-list-item">
                <button type="button" role="menuitem" class="sidebar-popover-summarize-topic cf-menu__action popover-menu-link" tabindex="0">
                    {{> ../../cofounder/components/icon name="sparkles" compact=true custom_classes="cf-menu__icon popover-menu-icon"}}
                    <span class="cf-menu__label popover-menu-label">{{t "Summarize recent messages"}}</span>
                </button>
            </li>
            {{/if}}
            {{#if has_starred_messages}}
            <li role="none" class="link-item cf-menu__item popover-menu-list-item hidden-for-spectators">
                <button type="button" role="menuitem" class="sidebar-popover-unstar-all-in-topic cf-menu__action popover-menu-link" tabindex="0">
                    {{> ../../cofounder/components/icon name="star" compact=true custom_classes="cf-menu__icon popover-menu-icon"}}
                    <span class="cf-menu__label popover-menu-label">{{t "Unstar all messages in topic" }}</span>
                </button>
            </li>
            {{/if}}
            {{#if has_unread_messages}}
            <li role="none" class="link-item cf-menu__item popover-menu-list-item hidden-for-spectators">
                <button type="button" role="menuitem" class="sidebar-popover-mark-topic-read cf-menu__action popover-menu-link" tabindex="0">
                    {{> ../../cofounder/components/icon name="check" compact=true custom_classes="cf-menu__icon popover-menu-icon"}}
                    <span class="cf-menu__label popover-menu-label">{{t "Mark all messages as read" }}</span>
                </button>
            </li>
            {{else}}
            <li role="none" class="link-item cf-menu__item popover-menu-list-item hidden-for-spectators">
                <button type="button" role="menuitem" class="sidebar-popover-mark-topic-unread cf-menu__action popover-menu-link" tabindex="0">
                    {{> ../../cofounder/components/icon name="mail" compact=true custom_classes="cf-menu__icon popover-menu-icon"}}
                    <span class="cf-menu__label popover-menu-label">{{t "Mark all messages as unread" }}</span>
                </button>
            </li>
            {{/if}}
            <li role="none" class="link-item cf-menu__item popover-menu-list-item">
                <button type="button" role="menuitem" class="sidebar-popover-copy-link-to-topic cf-menu__action popover-menu-link" data-clipboard-text="{{ url }}" tabindex="0">
                    {{> ../../cofounder/components/icon name="link-alt" compact=true custom_classes="cf-menu__icon popover-menu-icon"}}
                    <span class="cf-menu__label popover-menu-label">{{t "Copy link to topic" }}</span>
                </button>
            </li>
            {{!-- Group 3 --}}
            {{#if (or can_move_topic can_rename_topic is_realm_admin)}}
                {{#unless stream_archived}}
                <li role="separator" class="cf-menu__separator popover-menu-separator"></li>
                {{/unless}}
            {{/if}}
            {{#if can_move_topic}}
            <li role="none" class="link-item cf-menu__item popover-menu-list-item">
                <button type="button" role="menuitem" class="sidebar-popover-move-topic-messages cf-menu__action popover-menu-link" tabindex="0">
                    {{> ../../cofounder/components/icon name="move" compact=true custom_classes="cf-menu__icon popover-menu-icon"}}
                    <span class="cf-menu__label popover-menu-label">{{t "Move topic" }}</span>
                </button>
            </li>
            {{else if can_rename_topic}}
            <li role="none" class="link-item cf-menu__item popover-menu-list-item">
                <button type="button" role="menuitem" class="sidebar-popover-rename-topic-messages cf-menu__action popover-menu-link" tabindex="0">
                    {{> ../../cofounder/components/icon name="edit" compact=true custom_classes="cf-menu__icon popover-menu-icon"}}
                    <span class="cf-menu__label popover-menu-label">{{t "Rename topic" }}</span>
                </button>
            </li>
            {{/if}}
            {{#if (and can_resolve_topic (not is_empty_string_topic))}}
            <li role="none" class="link-item cf-menu__item popover-menu-list-item">
                <button type="button" role="menuitem" class="sidebar-popover-toggle-resolved cf-menu__action popover-menu-link" tabindex="0">
                    {{# if topic_is_resolved }}
                    {{> ../../cofounder/components/icon name="circle-x" compact=true custom_classes="cf-menu__icon popover-menu-icon"}}
                    <span class="cf-menu__label popover-menu-label">{{t "Mark as unresolved"}}</span>
                    {{else}}
                    {{> ../../cofounder/components/icon name="check" compact=true custom_classes="cf-menu__icon popover-menu-icon"}}
                    <span class="cf-menu__label popover-menu-label">{{t "Mark as resolved"}}</span>
                    {{/if}}
                </button>
            </li>
            {{/if}}
            {{#if (and is_realm_admin (not stream_archived))}}
            <li role="none" class="link-item cf-menu__item popover-menu-list-item">
                <button type="button" role="menuitem" class="sidebar-popover-delete-topic-messages cf-menu__action cf-menu__action--danger popover-menu-link" tabindex="0">
                    {{> ../../cofounder/components/icon name="trash" compact=true custom_classes="cf-menu__icon popover-menu-icon"}}
                    <span class="cf-menu__label popover-menu-label">{{t "Delete topic"}}</span>
                </button>
            </li>
            {{/if}}
        {{/if}}
    </ul>
</div>
