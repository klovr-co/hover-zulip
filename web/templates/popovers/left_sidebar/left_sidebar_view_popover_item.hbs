<li role="none" class="link-item cf-menu__item popover-menu-list-item views-popover-menu-{{css_class_suffix}}">
    <a href="#{{fragment}}" role="menuitem" class="cf-menu__action popover-menu-link tippy-left-sidebar-tooltip" data-tooltip-template-id="{{tooltip_template_id}}" tabindex="0">
        {{> ../../cofounder/components/icon name=cf_icon compact=true custom_classes="cf-menu__icon popover-menu-icon"}}
        {{#if has_unread_count}}
        <span class="label-and-unread-wrapper">
            <span class="cf-menu__label popover-menu-label">{{name}}</span>
            <span class="unread_count {{unread_count_type}}">{{#unless (eq unread_count 0)}}{{unread_count}}{{/unless}}</span>
            {{#if supports_masked_unread}}
            <span class="masked_unread_count">
                {{> ../../cofounder/components/icon name="masked-unread" compact=true custom_classes="masked-unread-icon"}}
            </span>
            {{/if}}
        </span>
        {{else}}
        <span class="cf-menu__label popover-menu-label">{{name}}</span>
        {{/if}}
    </a>
</li>
