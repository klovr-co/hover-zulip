<div class="cf-menu popover-menu" id="message-actions-menu-dropdown" data-simplebar data-simplebar-tab-index="-1">
    <ul role="menu" class="cf-menu__list popover-menu-list">
        {{!-- Group 1 --}}
        {{#if should_display_quote_message}}
        <li role="none" class="link-item cf-menu__item popover-menu-list-item">
            <a role="menuitem" data-message-id="{{message_id}}" class="respond_button cf-menu__action popover-menu-link" tabindex="0">
                {{> ../cofounder/components/icon name="quote" compact=true custom_classes="cf-menu__icon popover-menu-icon"}}
                <span class="cf-menu__label popover-menu-label">{{t "Quote message" }}</span>
                {{popover_hotkey_hints ">"}}
            </a>
        </li>
        <li role="none" class="link-item cf-menu__item popover-menu-list-item">
            <a role="menuitem" data-message-id="{{message_id}}" class="forward_button cf-menu__action popover-menu-link" tabindex="0">
                {{> ../cofounder/components/icon name="send" compact=true custom_classes="cf-menu__icon popover-menu-icon"}}
                <span class="cf-menu__label popover-menu-label">{{t "Forward message" }}</span>
                {{popover_hotkey_hints "<"}}
            </a>
        </li>
        {{/if}}
        {{!-- Group 2 --}}
        {{#if (or editability_menu_item move_message_menu_item should_display_delete_option should_display_message_report_option)}}
        <li role="separator" class="cf-menu__separator popover-menu-separator"></li>
        {{/if}}
        {{#if editability_menu_item}}
        <li role="none" class="link-item cf-menu__item popover-menu-list-item">
            <a role="menuitem" data-message-id="{{message_id}}" class="popover_edit_message cf-menu__action popover-menu-link" tabindex="0">
                {{> ../cofounder/components/icon name="edit" compact=true custom_classes="cf-menu__icon popover-menu-icon"}}
                <span class="cf-menu__label popover-menu-label">{{editability_menu_item}}</span>
                {{popover_hotkey_hints "E"}}
            </a>
        </li>
        {{/if}}
        {{#if move_message_menu_item}}
        <li role="none" class="link-item cf-menu__item popover-menu-list-item">
            <a role="menuitem" data-message-id="{{message_id}}" class="popover_move_message cf-menu__action popover-menu-link" tabindex="0">
                {{> ../cofounder/components/icon name="move" compact=true custom_classes="cf-menu__icon popover-menu-icon"}}
                <span class="cf-menu__label popover-menu-label">{{move_message_menu_item}}</span>
                {{popover_hotkey_hints "M"}}
            </a>
        </li>
        {{/if}}
        {{#if should_display_delete_option}}
        <li role="none" class="link-item cf-menu__item popover-menu-list-item">
            <a role="menuitem" data-message-id="{{message_id}}" class="delete_message cf-menu__action cf-menu__action--danger popover-menu-link" tabindex="0">
                {{> ../cofounder/components/icon name="trash" compact=true custom_classes="cf-menu__icon popover-menu-icon"}}
                <span class="cf-menu__label popover-menu-label">{{t "Delete message" }}</span>
            </a>
        </li>
        {{/if}}
        {{#if should_display_message_report_option}}
        <li role="none" class="link-item cf-menu__item popover-menu-list-item">
            <a role="menuitem" data-message-id="{{message_id}}" class="popover_report_message cf-menu__action popover-menu-link" tabindex="0">
                {{> ../cofounder/components/icon name="warning" compact=true custom_classes="cf-menu__icon popover-menu-icon"}}
                <span class="cf-menu__label popover-menu-label">{{t "Report message" }}</span>
            </a>
        </li>
        {{/if}}
        {{!-- Group 3 --}}
        {{#if should_display_add_reaction_option}}
        <li role="separator" class="cf-menu__separator popover-menu-separator"></li>
        <li role="none" class="link-item cf-menu__item popover-menu-list-item">
            <a role="menuitem" data-message-id="{{message_id}}" class="cf-message-actions-menu__reaction cf-menu__action popover-menu-link" tabindex="0">
                {{> ../cofounder/components/icon name="smile" compact=true custom_classes="cf-menu__icon popover-menu-icon"}}
                <span class="cf-menu__label popover-menu-label">{{t "Add emoji reaction" }}</span>
                {{popover_hotkey_hints ":"}}
            </a>
        </li>
        {{/if}}
        {{!-- Group 4 --}}
        {{#if (or should_display_mark_as_unread should_display_remind_me_option should_display_collapse should_display_uncollapse)}}
        <li role="separator" class="cf-menu__separator popover-menu-separator"></li>
        {{/if}}
        {{#if should_display_mark_as_unread}}
        <li role="none" class="link-item cf-menu__item popover-menu-list-item">
            <a role="menuitem" data-message-id="{{message_id}}" class="mark_as_unread cf-menu__action popover-menu-link" tabindex="0">
                {{> ../cofounder/components/icon name="mail" compact=true custom_classes="cf-menu__icon popover-menu-icon"}}
                <span class="cf-menu__label popover-menu-label">{{t "Mark as unread from here" }}</span>
                {{popover_hotkey_hints "Shift" "U"}}
            </a>
        </li>
        {{/if}}
        {{#if should_display_remind_me_option}}
        <li role="none" class="link-item cf-menu__item popover-menu-list-item">
            <a role="menuitem" data-message-id="{{message_id}}" class="message-reminder cf-menu__action popover-menu-link" tabindex="0">
                {{> ../cofounder/components/icon name="alarm" compact=true custom_classes="cf-menu__icon popover-menu-icon"}}
                <span class="cf-menu__label popover-menu-label">{{t "Remind me about this" }}</span>
            </a>
        </li>
        {{/if}}
        {{#if should_display_collapse}}
        <li role="none" class="link-item cf-menu__item popover-menu-list-item">
            <a role="menuitem" data-message-id="{{message_id}}" class="popover_toggle_collapse cf-menu__action popover-menu-link" tabindex="0">
                {{> ../cofounder/components/icon name="minimize" compact=true custom_classes="cf-menu__icon popover-menu-icon"}}
                <span class="cf-menu__label popover-menu-label">{{t "Collapse message" }}</span>
                {{popover_hotkey_hints "-"}}
            </a>
        </li>
        {{/if}}
        {{#if should_display_uncollapse}}
        <li role="none" class="link-item cf-menu__item popover-menu-list-item">
            <a role="menuitem" data-message-id="{{message_id}}" class="popover_toggle_collapse cf-menu__action popover-menu-link" tabindex="0">
                {{> ../cofounder/components/icon name="expand" compact=true custom_classes="cf-menu__icon popover-menu-icon"}}
                <span class="cf-menu__label popover-menu-label">{{t "Expand message" }}</span>
                {{popover_hotkey_hints "-"}}
            </a>
        </li>
        {{/if}}
        {{!-- Group 5 --}}
        <li role="separator" class="cf-menu__separator popover-menu-separator hidden-for-spectators"></li>
        {{#if view_source_menu_item}}
        <li role="none" class="link-item cf-menu__item popover-menu-list-item">
            <a role="menuitem" data-message-id="{{message_id}}" class="popover_view_source cf-menu__action popover-menu-link" tabindex="0">
                {{> ../cofounder/components/icon name="code" compact=true custom_classes="cf-menu__icon popover-menu-icon"}}
                <span class="cf-menu__label popover-menu-label">{{view_source_menu_item}}</span>
                {{popover_hotkey_hints "E"}}
            </a>
        </li>
        {{/if}}
        {{#if should_display_read_receipts_option}}
        <li role="none" class="link-item cf-menu__item popover-menu-list-item">
            <a role="menuitem" data-message-id="{{message_id}}" class="view_read_receipts cf-menu__action popover-menu-link" tabindex="0">
                {{> ../cofounder/components/icon name="eye" compact=true custom_classes="cf-menu__icon popover-menu-icon"}}
                <span class="cf-menu__label popover-menu-label">{{t "View read receipts" }}</span>
                {{popover_hotkey_hints "Shift" "V"}}
            </a>
        </li>
        {{/if}}
        <li role="none" class="link-item cf-menu__item popover-menu-list-item">
            <a role="menuitem" class="copy_link navigate-link-on-enter cf-menu__action popover-menu-link" data-message-id="{{message_id}}" data-clipboard-text="{{ conversation_time_url }}" tabindex="0">
                {{> ../cofounder/components/icon name="link-alt" compact=true custom_classes="cf-menu__icon popover-menu-icon"}}
                <span class="cf-menu__label popover-menu-label">{{t "Copy link to message" }}</span>
                {{popover_hotkey_hints "L"}}
            </a>
        </li>
    </ul>
</div>
