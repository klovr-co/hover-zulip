<div class="cf-menu popover-menu" id="gear-menu-dropdown" data-simplebar data-simplebar-tab-index="-1">
    <div class="org-info-container">
        <div class="org-info org-name">{{realm_name}}</div>
        <div class="org-info org-url">{{realm_url}}</div>
        {{#if is_self_hosted }}
        <div class="org-info org-version">
            <a href="#about-zulip" class="navigate-link-on-enter cf-menu__action popover-menu-link">{{version_display_string}}</a>
        </div>
        {{#if server_needs_upgrade }}
        <div class="org-info org-upgrade">
            <a href="https://zulip.readthedocs.io/en/stable/production/upgrade.html" target="_blank" rel="noopener noreferrer" class="navigate-link-on-enter cf-menu__action popover-menu-link">{{t 'Upgrade to the latest release' }}</a>
        </div>
        {{/if}}
        {{else}}
        <div class="org-info org-plan hidden-for-spectators">
            {{#if is_demo_organization }}
            <a href="/help/demo-organizations" target="_blank" rel="noopener noreferrer" class="navigate-link-on-enter cf-menu__action popover-menu-link">{{t "Demo organization" }}</a>
            {{else if is_plan_limited }}
            <a href="/plans/" target="_blank" rel="noopener noreferrer" class="navigate-link-on-enter cf-menu__action popover-menu-link">Zulip Cloud Free</a>
            {{else if is_plan_standard}}
            <a href="/plans/" target="_blank" rel="noopener noreferrer" class="navigate-link-on-enter cf-menu__action popover-menu-link">Zulip Cloud Standard</a>
            {{else if is_plan_standard_sponsored_for_free}}
            <a href="/plans/" target="_blank" rel="noopener noreferrer" class="navigate-link-on-enter cf-menu__action popover-menu-link">Zulip Cloud Standard (sponsored)</a>
            {{else if is_plan_plus}}
            <a href="/plans/" target="_blank" rel="noopener noreferrer" class="navigate-link-on-enter cf-menu__action popover-menu-link">Zulip Cloud Plus</a>
            {{/if}}
        </div>
        {{/if}}
        {{#if (and (not is_self_hosted) user_has_billing_access (not is_plan_standard_sponsored_for_free)) }}
        {{#if sponsorship_pending }}
        <div class="org-info org-upgrade">
            <a href="/sponsorship/" target="_blank" rel="noopener noreferrer" class="navigate-link-on-enter cf-menu__action popover-menu-link">{{t "Sponsorship request pending" }}</a>
        </div>
        {{else}}
        {{#if (and is_demo_organization is_owner) }}
        <div class="org-info org-upgrade">
            <a class="convert-demo-organization cf-menu__action popover-menu-link">{{t "Convert into permanent organization" }}</a>
        </div>
        {{/if}}
        {{#if (and is_plan_limited (not is_demo_organization))}}
        <div class="org-info org-upgrade">
            <a href="/upgrade/" target="_blank" rel="noopener noreferrer" class="navigate-link-on-enter cf-menu__action popover-menu-link">{{t "Upgrade to {standard_plan_name}" }}</a>
        </div>
        {{/if}}
        {{#unless (or is_org_on_paid_plan is_demo_organization)}}
        {{#if is_education_org }}
        <div class="org-info org-upgrade">
            <a href="/sponsorship/" target="_blank" rel="noopener noreferrer" class="navigate-link-on-enter cf-menu__action popover-menu-link">{{t 'Request education pricing' }}</a>
        </div>
        {{else if (not is_business_org) }}
        <div class="org-info org-upgrade">
            <a href="/sponsorship/" target="_blank" rel="noopener noreferrer" class="navigate-link-on-enter cf-menu__action popover-menu-link">{{t 'Request sponsorship' }}</a>
        </div>
        {{/if}}
        {{/unless}}
        {{/if}}
        {{/if}}
    </div>
    <ul role="menu" aria-label="{{t 'Workspace menu'}}" class="cf-menu__list popover-menu-list">
        {{!-- Group 1 --}}
        <li role="none" class="link-item cf-menu__item popover-menu-list-item hidden-for-spectators">
            <a role="menuitem" href="#channels/subscribed" class="navigate-link-on-enter cf-menu__action popover-menu-link">
                {{> ../../cofounder/components/icon name="hash" compact=true custom_classes="cf-menu__icon popover-menu-icon"}}
                <span class="cf-menu__label popover-menu-label">{{t 'Channel settings' }}</span>
            </a>
        </li>
        <li role="none" class="link-item cf-menu__item popover-menu-list-item admin-menu-item hidden-for-spectators">
            <a role="menuitem" href="#organization" class="navigate-link-on-enter cf-menu__action popover-menu-link">
                {{> ../../cofounder/components/icon name="building" compact=true custom_classes="cf-menu__icon popover-menu-icon"}}
                <span class="cf-menu__label popover-menu-label">{{t 'Organization settings' }}</span>
            </a>
        </li>
        {{#unless is_guest}}
        <li role="none" class="link-item cf-menu__item popover-menu-list-item hidden-for-spectators">
            <a role="menuitem" href="#groups/your" class="navigate-link-on-enter cf-menu__action popover-menu-link">
                {{> ../../cofounder/components/icon name="users" compact=true custom_classes="cf-menu__icon popover-menu-icon"}}
                <span class="cf-menu__label popover-menu-label">{{t 'Group settings' }}</span>
            </a>
        </li>
        {{/unless}}
        <li role="none" class="link-item cf-menu__item popover-menu-list-item hidden-for-spectators">
            <a role="menuitem" href="#settings" class="navigate-link-on-enter cf-menu__action popover-menu-link">
                {{> ../../cofounder/components/icon name="sliders" compact=true custom_classes="cf-menu__icon popover-menu-icon"}}
                <span class="cf-menu__label popover-menu-label">{{t 'Personal settings' }}</span>
            </a>
        </li>
        {{#unless is_guest}}
        <li role="none" class="link-item cf-menu__item popover-menu-list-item hidden-for-spectators">
            <a role="menuitem" href="/stats" target="_blank" rel="noopener noreferrer" class="navigate-link-on-enter cf-menu__action popover-menu-link">
                {{> ../../cofounder/components/icon name="bar-chart" compact=true custom_classes="cf-menu__icon popover-menu-icon"}}
                <span class="cf-menu__label popover-menu-label">{{t 'Usage statistics' }}</span>
            </a>
        </li>
        {{/unless}}
        <li role="none" class="cf-menu__item popover-menu-list-item only-visible-for-spectators">
            <div role="group" class="theme-switcher cf-menu__choice-group" aria-label="{{t 'App theme' }}">
                <input type="radio" id="select-automatic-theme" class="cf-menu__choice-input" name="theme-select" data-theme-code="{{color_scheme_values.automatic.code}}" tabindex="-1" aria-hidden="true" {{#if (eq user_color_scheme color_scheme_values.automatic.code)}}checked{{/if}} />
                <label role="menuitemradio" class="cf-menu__choice tippy-zulip-delayed-tooltip" for="select-automatic-theme" aria-label="{{t 'Select automatic theme' }}" aria-checked="{{#if (eq user_color_scheme color_scheme_values.automatic.code)}}true{{else}}false{{/if}}" data-tooltip-template-id="automatic-theme-template" tabindex="0">
                    {{> ../../cofounder/components/icon name="monitor" compact=true}}
                </label>
                <input type="radio" id="select-light-theme" class="cf-menu__choice-input" name="theme-select" data-theme-code="{{color_scheme_values.light.code}}" tabindex="-1" aria-hidden="true" {{#if (eq user_color_scheme color_scheme_values.light.code)}}checked{{/if}} />
                <label role="menuitemradio" class="cf-menu__choice tippy-zulip-delayed-tooltip" for="select-light-theme" aria-label="{{t 'Select light theme' }}" aria-checked="{{#if (eq user_color_scheme color_scheme_values.light.code)}}true{{else}}false{{/if}}" data-tippy-content="{{t 'Light theme' }}" tabindex="0">
                    {{> ../../cofounder/components/icon name="sun" compact=true}}
                </label>
                <input type="radio" id="select-dark-theme" class="cf-menu__choice-input" name="theme-select" data-theme-code="{{color_scheme_values.dark.code}}" tabindex="-1" aria-hidden="true" {{#if (eq user_color_scheme color_scheme_values.dark.code)}}checked{{/if}} />
                <label role="menuitemradio" class="cf-menu__choice tippy-zulip-delayed-tooltip" for="select-dark-theme" aria-label="{{t 'Select dark theme' }}" aria-checked="{{#if (eq user_color_scheme color_scheme_values.dark.code)}}true{{else}}false{{/if}}" data-tippy-content="{{t 'Dark theme' }}" tabindex="0">
                    {{> ../../cofounder/components/icon name="moon" compact=true}}
                </label>
            </div>
        </li>
        <li role="none" class="cf-menu__item popover-menu-list-item only-visible-for-spectators">
            <div class="info-density-controls">
                {{> ../../settings/info_density_control_button_group
                  property="web_font_size_px"
                  default_icon_name="type"
                  property_value=web_font_size_px
                  for_settings_ui=false
                  prefix="gear_menu_"
                  }}
                {{> ../../settings/info_density_control_button_group
                  property="web_line_height_percent"
                  default_icon_name="line-height"
                  property_value=web_line_height_percent
                  for_settings_ui=false
                  prefix="gear_menu_"
                  }}
            </div>
        </li>
        <li role="none" class="link-item cf-menu__item popover-menu-list-item only-visible-for-spectators">
            <a role="menuitem" tabindex="0" class="change-language-spectator cf-menu__action popover-menu-link">
                {{> ../../cofounder/components/icon name="globe" compact=true custom_classes="cf-menu__icon popover-menu-icon"}}
                <span class="cf-menu__label popover-menu-label">{{t 'Select language' }}</span>
            </a>
        </li>
        {{!-- Group 2 --}}
        <li role="separator" class="cf-menu__separator popover-menu-separator"></li>
        <li role="none" class="link-item cf-menu__item popover-menu-list-item">
            <a role="menuitem" href="{{ apps_page_url }}" target="_blank" rel="noopener noreferrer" class="navigate-link-on-enter cf-menu__action popover-menu-link">
                {{> ../../cofounder/components/icon name="monitor" compact=true custom_classes="cf-menu__icon popover-menu-icon"}}
                <span class="cf-menu__label popover-menu-label">{{t 'Desktop & mobile apps' }}</span>
            </a>
        </li>
        <li role="none" class="link-item cf-menu__item popover-menu-list-item">
            <a role="menuitem" href="/integrations/" target="_blank" rel="noopener noreferrer" class="navigate-link-on-enter cf-menu__action popover-menu-link">
                {{> ../../cofounder/components/icon name="git-pull-request" compact=true custom_classes="cf-menu__icon popover-menu-icon"}}
                <span class="cf-menu__label popover-menu-label">{{t 'Integrations' }}</span>
            </a>
        </li>
        <li role="none" class="link-item cf-menu__item popover-menu-list-item">
            <a role="menuitem" href="/api/" target="_blank" rel="noopener noreferrer" class="navigate-link-on-enter cf-menu__action popover-menu-link">
                {{> ../../cofounder/components/icon name="file-text" compact=true custom_classes="cf-menu__icon popover-menu-icon"}}
                <span class="cf-menu__label popover-menu-label">{{t 'API documentation' }}</span>
            </a>
        </li>
        {{#if (and user_has_billing_access show_billing)}}
        <li role="none" class="link-item cf-menu__item popover-menu-list-item">
            <a role="menuitem" href="/billing/" target="_blank" rel="noopener noreferrer" class="navigate-link-on-enter cf-menu__action popover-menu-link">
                {{> ../../cofounder/components/icon name="credit-card" compact=true custom_classes="cf-menu__icon popover-menu-icon"}}
                <span class="cf-menu__label popover-menu-label">{{t 'Billing' }}</span>
            </a>
        </li>
        {{/if}}
        {{#if promote_sponsoring_zulip}}
        <li role="none" class="link-item cf-menu__item popover-menu-list-item">
            <a role="menuitem" href="https://zulip.com/help/support-zulip-project" target="_blank" rel="noopener noreferrer" class="navigate-link-on-enter cf-menu__action popover-menu-link">
                {{> ../../cofounder/components/icon name="heart" compact=true custom_classes="cf-menu__icon popover-menu-icon"}}
                <span class="cf-menu__label popover-menu-label">{{t 'Support Zulip' }}</span>
            </a>
        </li>
        {{/if}}
        {{#if user_has_billing_access}}
        {{#if show_remote_billing }}
        <li role="none" class="link-item cf-menu__item popover-menu-list-item">
            <a role="menuitem" href="/self-hosted-billing/" id="open-self-hosted-billing" target="_blank" rel="noopener noreferrer" class="navigate-link-on-enter cf-menu__action popover-menu-link">
                {{> ../../cofounder/components/icon name="rocket" compact=true custom_classes="cf-menu__icon popover-menu-icon"}}
                <span class="cf-menu__label popover-menu-label">{{t 'Plan management' }}</span>
            </a>
        </li>
        {{/if}}
        {{#if show_plans}}
        {{!-- This will be hidden for self hosted realms since they will have corporate disabled. --}}
        <li role="none" class="link-item cf-menu__item popover-menu-list-item">
            <a role="menuitem" href="/plans/" target="_blank" rel="noopener noreferrer" class="navigate-link-on-enter cf-menu__action popover-menu-link">
                {{> ../../cofounder/components/icon name="rocket" compact=true custom_classes="cf-menu__icon popover-menu-icon"}}
                <span class="cf-menu__label popover-menu-label">{{t 'Plans and pricing' }}</span>
            </a>
        </li>
        {{/if}}
        {{/if}}
        {{!-- Group 3 --}}
        {{#if (or can_invite_users_by_email can_create_multiuse_invite is_spectator)}}
        <li role="separator" class="cf-menu__separator popover-menu-separator"></li>
        {{/if}}
        {{#if (or can_invite_users_by_email can_create_multiuse_invite)}}
        <li role="none" class="link-item cf-menu__item popover-menu-list-item">
            <button type="button" role="menuitem" class="invite-user-link cf-menu__action popover-menu-link">
                {{> ../../cofounder/components/icon name="user-plus" compact=true custom_classes="cf-menu__icon popover-menu-icon"}}
                <span class="cf-menu__label popover-menu-label">{{t 'Invite users' }}</span>
            </button>
        </li>
        {{/if}}
        <li role="none" class="link-item cf-menu__item popover-menu-list-item only-visible-for-spectators">
            <a role="menuitem" href="{{login_link}}" class="navigate-link-on-enter cf-menu__action popover-menu-link">
                {{> ../../cofounder/components/icon name="log-in" compact=true custom_classes="cf-menu__icon popover-menu-icon"}}
                <span class="cf-menu__label popover-menu-label">{{t 'Log in' }}</span>
            </a>
        </li>
    </ul>
</div>
