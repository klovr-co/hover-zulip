<div class="cf-menu popover-menu" id="help-menu-dropdown" data-simplebar data-simplebar-tab-index="-1">
    <ul role="menu" aria-label="{{t 'Help menu'}}" class="cf-menu__list popover-menu-list">
        <li role="none" class="link-item cf-menu__item popover-menu-list-item">
            <a role="menuitem" href="/help/" target="_blank" rel="noopener noreferrer" class="navigate-link-on-enter cf-menu__action popover-menu-link">
                {{> ../../cofounder/components/icon name="circle-help" compact=true custom_classes="cf-menu__icon popover-menu-icon"}}
                <span class="cf-menu__label popover-menu-label">{{t 'Help center' }}</span>
            </a>
        </li>
        <li role="none" class="link-item cf-menu__item popover-menu-list-item">
            <button type="button" role="menuitem" class="cf-menu__action popover-menu-link" data-overlay-trigger="keyboard-shortcuts">
                {{> ../../cofounder/components/icon name="keyboard" compact=true custom_classes="cf-menu__icon popover-menu-icon"}}
                <span class="cf-menu__label popover-menu-label">{{t 'Keyboard shortcuts' }}</span>
                {{popover_hotkey_hints "?"}}
            </button>
        </li>
        <li role="none" class="link-item cf-menu__item popover-menu-list-item hidden-for-spectators">
            <button type="button" role="menuitem" class="cf-menu__action popover-menu-link" data-overlay-trigger="message-formatting">
                {{> ../../cofounder/components/icon name="edit" compact=true custom_classes="cf-menu__icon popover-menu-icon"}}
                <span class="cf-menu__label popover-menu-label">{{t 'Message formatting' }}</span>
            </button>
        </li>
        <li role="none" class="link-item cf-menu__item popover-menu-list-item">
            <button type="button" role="menuitem" class="cf-menu__action popover-menu-link" data-overlay-trigger="search-operators">
                {{> ../../cofounder/components/icon name="search" compact=true custom_classes="cf-menu__icon popover-menu-icon"}}
                <span class="cf-menu__label popover-menu-label">{{t 'Search filters' }}</span>
            </button>
        </li>
        <li role="none" class="link-item cf-menu__item popover-menu-list-item" id="gear_menu_about_zulip">
            <a role="menuitem" href="#about-zulip" class="navigate-link-on-enter cf-menu__action popover-menu-link">
                {{> ../../cofounder/components/icon name="info" compact=true custom_classes="cf-menu__icon popover-menu-icon"}}
                <span class="cf-menu__label popover-menu-label">{{t "About Zulip" }}</span>
            </a>
        </li>
        {{#if corporate_enabled}}
        <li role="none" class="link-item cf-menu__item popover-menu-list-item">
            <a role="menuitem" href="/help/contact-support" target="_blank" rel="noopener noreferrer" class="navigate-link-on-enter cf-menu__action popover-menu-link">
                {{> ../../cofounder/components/icon name="life-buoy" compact=true custom_classes="cf-menu__icon popover-menu-icon"}}
                <span class="cf-menu__label popover-menu-label">{{t 'Contact support' }}</span>
            </a>
        </li>
        {{#if (or is_admin is_owner)}}
        <li role="none" class="link-item cf-menu__item popover-menu-list-item">
            <a role="menuitem" href="/contact-sales" target="_blank" rel="noopener noreferrer" class="navigate-link-on-enter cf-menu__action popover-menu-link">
                {{> ../../cofounder/components/icon name="handshake" compact=true custom_classes="cf-menu__icon popover-menu-icon"}}
                <span class="cf-menu__label popover-menu-label">{{t 'Contact sales' }}</span>
            </a>
        </li>
        {{/if}}
        {{/if}}
    </ul>
</div>
