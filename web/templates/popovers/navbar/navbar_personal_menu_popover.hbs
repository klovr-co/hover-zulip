<div class="cf-menu popover-menu" id="personal-menu-dropdown" data-simplebar data-simplebar-tab-index="-1">
    <nav class="personal-menu-nav">
        <header class="personal-menu-header">
            <div class="avatar">
                <img class="avatar-image{{#if user_is_guest}} guest-avatar{{/if}}" src="{{user_avatar}}" alt=""/>

                {{#if is_active }}
                {{> ../../cofounder/components/presence_dot user_circle_class=user_circle_class user_id=user_id custom_classes="status-circle user-circle hidden-for-spectators"}}
                {{/if}}

            </div>
            <div class="text-area">
                <p class="full-name">{{user_full_name}}</p>
                <p class="user-type">{{user_type}}</p>
            </div>
        </header>
        <section class="dropdown-menu-list-section personal-menu-actions" data-user-id="{{user_id}}">
            <ul role="menu" aria-label="{{t 'Personal menu'}}" class="cf-menu__list popover-menu-list">
                {{#if status_content_available}}
                <li role="none" class="text-item cf-menu__item popover-menu-list-item">
                    <span class="personal-menu-status-wrapper">
                        {{#if status_emoji_info}}
                            {{#if status_emoji_info.emoji_alt_code}}
                            <span class="emoji_alt_code">&nbsp;:{{status_emoji_info.emoji_name}}:</span>
                            {{else if status_emoji_info.url}}
                            <img src="{{status_emoji_info.url}}" class="emoji status_emoji" />
                            {{else}}
                            <span class="emoji status_emoji emoji-{{status_emoji_info.emoji_code}}"></span>
                            {{/if}}
                        {{/if}}
                        <span class="status_text personal-menu-status-text">
                            {{#if show_placeholder_for_status_text}}
                                <i class="personal-menu-no-status-text">{{t "No status text"}}</i>
                            {{else}}
                                {{status_text}}
                            {{/if}}
                        </span>
                    </span>
                    <a role="menuitem" tabindex="0" class="personal-menu-clear-status cf-menu__action popover-menu-link" aria-label="{{t 'Clear status'}}" data-tippy-content="{{t 'Clear your status' }}">
                        {{> ../../cofounder/components/icon name="circle-x" compact=true custom_classes="personal-menu-clear-status-icon cf-menu__icon popover-menu-icon"}}
                    </a>
                </li>
                {{!-- Group 1 --}}
                <li role="none" class="link-item cf-menu__item popover-menu-list-item">
                    <a role="menuitem" tabindex="0" class="update_status_text cf-menu__action popover-menu-link">
                        {{> ../../cofounder/components/icon name="smile" compact=true custom_classes="cf-menu__icon popover-menu-icon"}}
                        <span class="cf-menu__label popover-menu-label">{{t 'Edit status' }}</span>
                        {{popover_hotkey_hints "Shift" "Y"}}
                    </a>
                </li>
                {{else}}
                <li role="none" class="link-item hidden-for-spectators cf-menu__item popover-menu-list-item">
                    <a role="menuitem" tabindex="0" class="update_status_text cf-menu__action popover-menu-link">
                        {{> ../../cofounder/components/icon name="smile" compact=true custom_classes="cf-menu__icon popover-menu-icon"}}
                        <span class="cf-menu__label popover-menu-label">{{t 'Set status' }}</span>
                        {{popover_hotkey_hints "Shift" "Y"}}
                    </a>
                </li>
                {{/if}}
                {{#if invisible_mode}}
                <li role="none" class="link-item hidden-for-spectators cf-menu__item popover-menu-list-item">
                    <a role="menuitem" tabindex="0" class="invisible_mode_turn_off cf-menu__action popover-menu-link">
                        {{> ../../cofounder/components/icon name="play" compact=true custom_classes="cf-menu__icon popover-menu-icon"}}
                        <span class="cf-menu__label popover-menu-label">{{t 'Turn off invisible mode' }}</span>
                    </a>
                </li>
                {{else}}
                <li role="none" class="link-item hidden-for-spectators cf-menu__item popover-menu-list-item">
                    <a role="menuitem" tabindex="0" class="invisible_mode_turn_on cf-menu__action popover-menu-link">
                        {{> ../../cofounder/components/icon name="eye-off" compact=true custom_classes="cf-menu__icon popover-menu-icon"}}
                        <span class="cf-menu__label popover-menu-label">{{t 'Go invisible' }}</span>
                    </a>
                </li>
                {{/if}}
                {{!-- Group 2 --}}
                <li role="separator" class="cf-menu__separator popover-menu-separator"></li>
                <li role="none" class="link-item cf-menu__item popover-menu-list-item">
                    <a role="menuitem" href="#user/{{user_id}}" tabindex="0" class="view_full_user_profile cf-menu__action popover-menu-link navigate-link-on-enter">
                        {{> ../../cofounder/components/icon name="user" compact=true custom_classes="cf-menu__icon popover-menu-icon"}}
                        <span class="cf-menu__label popover-menu-label">{{t 'View your profile' }}</span>
                    </a>
                </li>
                <li role="none" class="link-item cf-menu__item popover-menu-list-item">
                    <a role="menuitem" tabindex="0" class="narrow-self-direct-message cf-menu__action popover-menu-link">
                        {{> ../../cofounder/components/icon name="users" compact=true custom_classes="cf-menu__icon popover-menu-icon"}}
                        <span class="cf-menu__label popover-menu-label">{{t 'View messages with yourself' }}</span>
                    </a>
                </li>
                <li role="none" class="link-item cf-menu__item popover-menu-list-item">
                    <a role="menuitem" tabindex="0" class="narrow-messages-sent cf-menu__action popover-menu-link">
                        {{> ../../cofounder/components/icon name="messages" compact=true custom_classes="cf-menu__icon popover-menu-icon"}}
                        <span class="cf-menu__label popover-menu-label">{{t 'View messages sent' }}</span>
                    </a>
                </li>
                {{!-- Group 3 --}}
                <li role="separator" class="cf-menu__separator popover-menu-separator"></li>
                <li role="none" class="link-item cf-menu__item popover-menu-list-item">
                    <a role="menuitem" href="#settings/profile" class="open-profile-settings cf-menu__action popover-menu-link">
                        {{> ../../cofounder/components/icon name="sliders" compact=true custom_classes="cf-menu__icon popover-menu-icon"}}
                        <span class="cf-menu__label popover-menu-label">{{t 'Settings' }}</span>
                    </a>
                </li>
                <li role="none" class="cf-menu__item popover-menu-list-item">
                    <div role="group" class="theme-switcher cf-menu__choice-group popover-menu-tab-group" aria-label="{{t 'App theme' }}">
                        <input type="radio" id="select-automatic-theme" class="cf-menu__choice-input" name="theme-select" data-theme-code="{{color_scheme_values.automatic.code}}" tabindex="-1" aria-hidden="true" {{#if (eq user_color_scheme color_scheme_values.automatic.code)}}checked{{/if}} />
                        <label role="menuitemradio" class="cf-menu__choice tippy-zulip-delayed-tooltip" for="select-automatic-theme" aria-label="{{t 'Select automatic theme' }}" aria-checked="{{#if (eq user_color_scheme color_scheme_values.automatic.code)}}true{{else}}false{{/if}}" data-tooltip-template-id="automatic-theme-template" tabindex="0">
                            {{> ../../cofounder/components/icon name="monitor" compact=true}}
                        </label>
                        <input type="radio" id="select-light-theme" class="cf-menu__choice-input" name="theme-select" data-theme-code="{{color_scheme_values.light.code}}" tabindex="-1" aria-hidden="true" {{#if (eq user_color_scheme color_scheme_values.light.code)}}checked{{/if}} />
                        <label role="menuitemradio" class="cf-menu__choice tippy-zulip-delayed-tooltip" for="select-light-theme" aria-label="{{t 'Select light theme' }}" aria-checked="{{#if (eq user_color_scheme color_scheme_values.light.code)}}true{{else}}false{{/if}}" data-tippy-content="{{t 'Light theme' }}" tabindex="0">
                            {{> ../../cofounder/components/icon name="sun" compact=true}}
                        </label>
                        <input type="radio" id="select-dark-theme" class="cf-menu__choice-input" name="theme-select" data-theme-code="{{color_scheme_values.dark.code}}" tabindex="-1" aria-hidden="true" {{#if (eq user_color_scheme color_scheme_values.dark.code)}}checked{{/if}} />
                        <label role="menuitemradio" class="cf-menu__choice tippy-zulip-delayed-tooltip" for="select-dark-theme" aria-label="{{t 'Select dark theme' }}" aria-checked="{{#if (eq user_color_scheme color_scheme_values.dark.code)}}true{{else}}false{{/if}}" data-tippy-content="{{t 'Dark theme' }}" tabindex="0">
                            {{> ../../cofounder/components/icon name="moon" compact=true}}
                        </label>
                    </div>
                </li>
                <li role="none" class="cf-menu__item popover-menu-list-item">
                    <div class="info-density-controls">
                        {{> ../../settings/info_density_control_button_group
                          property="web_font_size_px"
                          default_icon_name="type"
                          property_value=web_font_size_px
                          for_settings_ui=false
                          prefix="personal_menu_"
                          }}
                        {{> ../../settings/info_density_control_button_group
                          property="web_line_height_percent"
                          default_icon_name="line-height"
                          property_value=web_line_height_percent
                          for_settings_ui=false
                          prefix="personal_menu_"
                          }}
                    </div>
                </li>
                {{!-- Group 4 --}}
                <li role="separator" class="cf-menu__separator popover-menu-separator"></li>
                <li role="none" class="link-item cf-menu__item popover-menu-list-item">
                    <a role="menuitem" class="logout_button hidden-for-spectators cf-menu__action popover-menu-link" tabindex="0">
                        {{> ../../cofounder/components/icon name="log-out" compact=true custom_classes="cf-menu__icon popover-menu-icon"}}
                        <span class="cf-menu__label popover-menu-label">{{t 'Log out' }}</span>
                    </a>
                </li>
            </ul>
        </section>
    </nav>
</div>
