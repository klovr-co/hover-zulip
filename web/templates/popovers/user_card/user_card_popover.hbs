<div class="cf-menu cf-user-card popover-menu user-card-popover-actions no-auto-hide-right-sidebar-overlay" id="user_card_popover" data-simplebar data-simplebar-tab-index="-1">
    <div class="popover-menu-user-header">
        <div class="popover-menu-user-avatar-container {{#if (not is_active)}}deactivated{{/if}}">
            <img class="popover-menu-user-avatar{{#if user_is_guest}} guest-avatar{{/if}}" src="{{user_avatar}}" alt="" />
            {{#if (and is_active (not is_bot))}}
                {{> ../../cofounder/components/presence_dot user_circle_class=user_circle_class user_id=user_id custom_classes="popover-menu-user-presence hidden-for-spectators"}}
            {{/if}}
            {{#if (not is_active)}}
                <span class="popover-menu-user-presence conversation-partners-icon deactivated-user-icon user_circle">{{> ../../cofounder/components/icon name="circle-off" compact=true}}</span>
            {{/if}}
        </div>
        <div class="popover-menu-user-info">
            <div class="popover-menu-user-full-name text-select" data-tippy-content="{{user_full_name}}">
                {{> ../../user_full_name name=user_full_name}}
                {{#if is_bot}}
                    {{> ../../cofounder/components/icon name="bot" compact=true}}
                {{/if}}
            </div>
            <div class="popover-menu-user-type">
                {{#if is_bot}}
                    {{#if is_system_bot}}
                        <div>{{t "System bot" }}</div>
                    {{else}}
                        <div>{{t "Bot" }}
                            {{~#unless (eq user_type "Member")}}
                                <span class="lowercase">({{user_type}})</span>
                            {{/unless~}}
                        </div>
                    {{/if}}
                {{else}}
                    <div>{{ user_type }}</div>
                {{/if}}
            </div>
        </div>
    </div>
    <ul role="menu" class="cf-menu__list popover-menu-list" data-user-id="{{user_id}}">
        {{#if status_content_available}}
            <li role="none" class="text-item cf-menu__item popover-menu-list-item hidden-for-spectators">
                <span class="personal-menu-status-wrapper">
                    {{#if status_emoji_info}}
                        {{#if status_emoji_info.emoji_alt_code}}
                            <span class="emoji_alt_code">&nbsp;:{{status_emoji_info.emoji_name}}:</span>
                        {{else if status_emoji_info.url}}
                            <img src="{{status_emoji_info.url}}" class="emoji status_emoji" alt="" data-tippy-content=":{{status_emoji_info.emoji_name}}:"/>
                        {{else}}
                            <span class="emoji status_emoji emoji-{{status_emoji_info.emoji_code}}" data-tippy-content=":{{status_emoji_info.emoji_name}}:"></span>
                        {{/if}}
                    {{/if}}
                    <span class="status_text personal-menu-status-text">
                        {{#if show_placeholder_for_status_text}}
                            <i class="personal-menu-no-status-text">{{t "No status text"}}</i>
                        {{else}}
                            {{status_text}}
                        {{/if}}
                    </span>
                </span>
                {{#if is_me}}
                    <a role="menuitem" tabindex="0" class="personal-menu-clear-status user-card-clear-status-button cf-menu__action popover-menu-link" aria-label="{{t 'Clear status'}}" data-tippy-content="{{t 'Clear your status' }}">
                        {{> ../../cofounder/components/icon name="circle-off" compact=true custom_classes="personal-menu-clear-status-icon cf-menu__icon popover-menu-icon"}}
                    </a>
                {{/if}}
            </li>
        {{/if}}
        {{#if is_me}}
            {{#if status_content_available}}
                <li role="none" class="link-item cf-menu__item popover-menu-list-item hidden-for-spectators">
                    <a role="menuitem" tabindex="0" class="update_status_text cf-menu__action popover-menu-link">
                        {{> ../../cofounder/components/icon name="smile" compact=true custom_classes="cf-menu__icon popover-menu-icon"}}
                        <span class="cf-menu__label popover-menu-label">{{t 'Edit status' }}</span>
                        {{popover_hotkey_hints "Shift" "Y"}}
                    </a>
                </li>
            {{else}}
                <li role="none" class="link-item cf-menu__item popover-menu-list-item hidden-for-spectators">
                    <a role="menuitem" tabindex="0" class="update_status_text cf-menu__action popover-menu-link">
                        {{> ../../cofounder/components/icon name="smile" compact=true custom_classes="cf-menu__icon popover-menu-icon"}}
                        <span class="cf-menu__label popover-menu-label">{{t 'Set status' }}</span>
                        {{popover_hotkey_hints "Shift" "Y"}}
                    </a>
                </li>
            {{/if}}
            {{#if invisible_mode}}
                <li role="none" class="link-item cf-menu__item popover-menu-list-item">
                    <a role="menuitem" tabindex="0" class="invisible_mode_turn_off cf-menu__action popover-menu-link">
                        {{> ../../cofounder/components/icon name="play" compact=true custom_classes="cf-menu__icon popover-menu-icon"}}
                        <span class="cf-menu__label popover-menu-label">{{t 'Turn off invisible mode' }}</span>
                    </a>
                </li>
            {{else}}
                <li role="none" class="link-item cf-menu__item popover-menu-list-item hidden-for-spectators">
                    <a role="menuitem" tabindex="0" class="invisible_mode_turn_on cf-menu__action popover-menu-link">
                        {{> ../../cofounder/components/icon name="eye-off" compact=true custom_classes="cf-menu__icon popover-menu-icon"}}
                        <span class="cf-menu__label popover-menu-label">{{t 'Go invisible' }}</span>
                    </a>
                </li>
            {{/if}}
        {{/if}}
        {{#if (or is_me status_content_available)}}
            <li role="separator" class="cf-menu__separator popover-menu-separator hidden-for-spectators"></li>
        {{/if}}
        {{#if show_last_active_status}}
            <li role="none" class="cf-menu__item popover-menu-list-item text-item hidden-for-spectators">
                {{> ../../cofounder/components/icon name="clock" compact=true custom_classes="cf-menu__icon popover-menu-icon"}}
                <span class="cf-menu__label popover-menu-label user-last-seen-time">{{user_last_seen_time_status}}</span>
            </li>
        {{/if}}
        {{#if is_active}}
            {{#if user_time}}
                <li role="none" class="cf-menu__item popover-menu-list-item text-item hidden-for-spectators">
                    {{> ../../cofounder/components/icon name="clock" compact=true custom_classes="cf-menu__icon popover-menu-icon"}}
                    <span class="cf-menu__label popover-menu-label">{{t "{user_time} local time" user_time=user_time}}</span>
                </li>
            {{/if}}
        {{else}}
            <li role="none" class="cf-menu__item popover-menu-list-item text-item italic hidden-for-spectators">
                {{#if is_bot}}
                    <span class="cf-menu__label popover-menu-label">{{t "This bot has been deactivated." }}</span>
                {{else}}
                    <span class="cf-menu__label popover-menu-label">{{t "This user has been deactivated." }}</span>
                {{/if}}
            </li>
        {{/if}}
        {{#if (and is_imported_stub is_active)}}
            {{#unless is_bot}}
            <li role="none" class="cf-menu__item popover-menu-list-item text-item italic hidden-for-spectators">
                <span class="cf-menu__label popover-menu-label">{{t "This user has not activated their imported account." }}</span>
            </li>
            {{/unless}}
        {{/if}}
        {{#if spectator_view}}
            <li role="none" class="cf-menu__item popover-menu-list-item text-item">
                <span class="cf-menu__label popover-menu-label">{{t "Joined {date_joined}" }}</span>
            </li>
        {{/if}}
        <li role="separator" class="cf-menu__separator popover-menu-separator hidden-for-spectators"></li>
        {{#if is_bot}}
            {{#if bot_owner}}
                <li role="none" class="cf-menu__item popover-menu-list-item user-card-popover-bot-owner-field text-item hidden-for-spectators">
                    <span class="bot_owner" data-tippy-content="{{ bot_owner.full_name }}">{{t "Bot owner" }}:</span>
                    {{> ../../user_display_only_pill display_value=bot_owner.full_name user_id=bot_owner.user_id img_src=bot_owner.avatar_url is_active=true}}
                </li>
            {{/if}}
        {{/if}}
        {{#if is_active }}
            {{#if user_email}}
                <li role="none" class="cf-menu__item popover-menu-list-item text-item user-card-popover-email-field hidden-for-spectators">
                    <span class="user_popover_email">{{ user_email }}</span>
                    {{> ../../cofounder/components/icon_button icon="copy" intent="neutral" squared=true id="popover-menu-copy-email" custom_classes="popover-menu-link copy-button hide_copy_icon" aria-label=(t "Copy email") data-tippy-content=(t "Copy email") data-clipboard-text=user_email}}
                </li>
            {{/if}}
        {{/if}}
        {{> ./user_card_popover_custom_fields profile_fields=display_profile_fields}}
        <li role="none" class="cf-menu__item popover-menu-list-item link-item hidden-for-spectators">
            <a role="menuitem" class="cf-menu__action popover-menu-link view_full_user_profile" tabindex="0">
                {{> ../../cofounder/components/icon name="user" compact=true custom_classes="cf-menu__icon popover-menu-icon"}}
                {{#if is_me}}
                    <span class="cf-menu__label popover-menu-label">{{t "View your profile" }}</span>
                {{else}}
                    <span class="cf-menu__label popover-menu-label">{{t "View profile" }}</span>
                {{/if}}
            </a>
        </li>
        {{#if can_send_private_message}}
            <li role="none" class="cf-menu__item popover-menu-list-item link-item hidden-for-spectators">
                <a role="menuitem" class="cf-menu__action popover-menu-link {{ private_message_class }}" tabindex="0">
                    {{> ../../cofounder/components/icon name="messages" compact=true custom_classes="cf-menu__icon popover-menu-icon"}}
                    <span class="cf-menu__label popover-menu-label">{{t "Send direct message" }}</span>
                    {{#if is_sender_popover}}
                        {{popover_hotkey_hints "Shift" "R"}}
                    {{/if}}
                </a>
            </li>
        {{/if}}
        {{#unless is_me}}
            <li role="none" class="cf-menu__item popover-menu-list-item link-item hidden-for-spectators">
                {{#if has_message_context}}
                    <a role="menuitem" class="cf-menu__action popover-menu-link mention_user" tabindex="0">
                        {{> ../../cofounder/components/icon name="at-sign" compact=true custom_classes="cf-menu__icon popover-menu-icon"}}
                        {{#if is_bot}}
                            <span class="cf-menu__label popover-menu-label">{{t "Reply mentioning bot" }}</span>
                        {{else}}
                            <span class="cf-menu__label popover-menu-label">{{t "Reply mentioning user" }}</span>
                        {{/if}}
                        {{#if is_sender_popover}}
                            {{popover_hotkey_hints "@"}}
                        {{/if}}
                    </a>
                {{else}}
                    <a role="menuitem" class="cf-menu__action popover-menu-link copy_mention_syntax" tabindex="0" data-clipboard-text="{{ user_mention_syntax }}">
                        {{> ../../cofounder/components/icon name="at-sign" compact=true custom_classes="cf-menu__icon popover-menu-icon"}}
                        <span class="cf-menu__label popover-menu-label">{{t "Copy mention syntax" }}</span>
                        {{#if is_sender_popover}}
                            {{popover_hotkey_hints "@"}}
                        {{/if}}
                    </a>
                {{/if}}
            </li>
        {{/unless}}
        {{#if is_me}}
            <li role="none" class="cf-menu__item popover-menu-list-item link-item hidden-for-spectators">
                <a role="menuitem" class="cf-menu__action popover-menu-link edit-your-profile" tabindex="0">
                    {{> ../../cofounder/components/icon name="sliders" compact=true custom_classes="cf-menu__icon popover-menu-icon"}}
                    <span class="cf-menu__label popover-menu-label">{{t "Edit your profile" }}</span>
                </a>
            </li>
        {{/if}}
        <li role="separator" class="cf-menu__separator popover-menu-separator hidden-for-spectators"></li>
        <li role="none" class="cf-menu__item popover-menu-list-item link-item">
            <a role="menuitem" href="{{ pm_with_url }}" class="narrow_to_private_messages cf-menu__action popover-menu-link hidden-for-spectators" tabindex="0">
                {{> ../../cofounder/components/icon name="user" compact=true custom_classes="cf-menu__icon popover-menu-icon"}}
                {{#if is_me}}
                    <span class="cf-menu__label popover-menu-label">{{t "View messages with yourself" }}</span>
                {{else}}
                    <span class="cf-menu__label popover-menu-label">{{t "View direct messages" }}</span>
                {{/if}}
            </a>
        </li>
        <li role="none" class="cf-menu__item popover-menu-list-item link-item">
            <a role="menuitem" href="{{ sent_by_url }}" class="narrow_to_messages_sent cf-menu__action popover-menu-link hidden-for-spectators" tabindex="0">
                {{> ../../cofounder/components/icon name="messages" compact=true custom_classes="cf-menu__icon popover-menu-icon"}}
                <span class="cf-menu__label popover-menu-label">{{t "View messages sent" }}</span>
            </a>
        </li>
        {{#if show_manage_section}}
            <li role="separator" class="cf-menu__separator popover-menu-separator hidden-for-spectators"></li>
            {{#if can_mute}}
                <li role="none" class="cf-menu__item popover-menu-list-item link-item">
                    <a role="menuitem" class="sidebar-popover-mute-user cf-menu__action popover-menu-link hidden-for-spectators" tabindex="0">
                        {{> ../../cofounder/components/icon name="eye-off" compact=true custom_classes="cf-menu__icon popover-menu-icon"}}
                        {{#if is_bot}}
                            <span class="cf-menu__label popover-menu-label">{{t "Mute this bot" }}</span>
                        {{else}}
                            <span class="cf-menu__label popover-menu-label">{{t "Mute this user" }}</span>
                        {{/if}}
                    </a>
                </li>
            {{/if}}
            {{#if can_unmute}}
                <li role="none" class="cf-menu__item popover-menu-list-item link-item">
                    <a role="menuitem" class="sidebar-popover-unmute-user cf-menu__action popover-menu-link hidden-for-spectators" tabindex="0">
                        {{> ../../cofounder/components/icon name="eye" compact=true custom_classes="cf-menu__icon popover-menu-icon"}}
                        {{#if is_bot}}
                            <span class="cf-menu__label popover-menu-label">{{t "Unmute this bot" }}</span>
                        {{else}}
                            <span class="cf-menu__label popover-menu-label">{{t "Unmute this user" }}</span>
                        {{/if}}
                    </a>
                </li>
            {{/if}}
            {{#if can_manage_user}}
                <li role="separator" class="cf-menu__separator popover-menu-separator hidden-for-spectators"></li>
                <li role="none" class="cf-menu__item popover-menu-list-item link-item">
                    <a role="menuitem" class="sidebar-popover-manage-user cf-menu__action popover-menu-link hidden-for-spectators" tabindex="0">
                        {{> ../../cofounder/components/icon name="sliders" compact=true custom_classes="cf-menu__icon popover-menu-icon"}}
                        {{#if is_bot}}
                            <span class="cf-menu__label popover-menu-label">{{t "Manage this bot" }}</span>
                        {{else}}
                            <span class="cf-menu__label popover-menu-label">{{t "Manage this user" }}</span>
                        {{/if}}
                    </a>
                </li>
                {{#if (not is_active)}}
                    <li role="none" class="cf-menu__item popover-menu-list-item link-item">
                        <a role="menuitem" class="sidebar-popover-reactivate-user cf-menu__action popover-menu-link hidden-for-spectators" tabindex="0">
                            {{> ../../cofounder/components/icon name="user-plus" compact=true custom_classes="cf-menu__icon popover-menu-icon"}}
                            {{#if is_bot}}
                                <span class="cf-menu__label popover-menu-label">{{t "Reactivate this bot" }}</span>
                            {{else}}
                                <span class="cf-menu__label popover-menu-label">{{t "Reactivate this user" }}</span>
                            {{/if}}
                        </a>
                    </li>
                {{/if}}
            {{/if}}
        {{/if}}
    </ul>
</div>
