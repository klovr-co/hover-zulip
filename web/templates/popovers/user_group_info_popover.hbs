<div class="cf-menu popover-menu user-group-info-popover" data-simplebar data-simplebar-tab-index="-1">
    <ul role="menu" class="cf-menu__list popover-menu-list">
        <li role="none" class="link-item cf-menu__item popover-menu-list-item">
            <div class="popover-group-menu-info">
                <div class="popover-group-menu-name-container">
                    {{> ../cofounder/components/icon name="users" compact=true custom_classes="cf-menu__icon popover-menu-icon"}}
                    <span class="popover-group-menu-name">{{group_name}}</span>
                </div>
                {{#if group_description}}
                    <div class="popover-group-menu-description">{{group_description}}</div>
                {{/if}}
            </div>
        </li>
        {{#unless (and (eq displayed_members.length 0) (eq displayed_subgroups.length 0))}}
            {{#if user_can_access_all_other_users}}
                <li role="none" class="cf-menu__item popover-menu-list-item text-item italic">
                    {{#tr}}
                        {members_count, plural, =1 {1 member} other {# members}}
                    {{/tr}}
                </li>
            {{/if}}
        {{/unless}}
        {{#if deactivated}}
            <li role="none" class="cf-menu__item popover-menu-list-item text-item italic hidden-for-spectators">
                <span class="cf-menu__label popover-menu-label">{{t "This group has been deactivated." }}</span>
            </li>
        {{/if}}
        <li role="separator" class="cf-menu__separator popover-menu-separator"></li>
        <li role="none" class="cf-menu__item popover-menu-list-item">
            {{#unless (and (eq displayed_members.length 0) (eq displayed_subgroups.length 0))}}
                <ul class="cf-menu__list popover-menu-list popover-group-menu-member-list" data-simplebar data-simplebar-tab-index="-1" data-simplebar-auto-hide="false">
                    {{#each displayed_subgroups}}
                        <li class="popover-group-menu-member">
                            {{> ../cofounder/components/icon name="users" compact=true custom_classes="popover-group-member-icon cf-menu__icon popover-menu-icon"}}
                            <span class="popover-group-menu-member-name">{{name}}</span>
                        </li>
                    {{/each}}
                    {{#each displayed_members}}
                        <li class="popover-group-menu-member">
                            {{#if is_bot}}
                                {{> ../cofounder/components/icon name="bot" compact=true custom_classes="popover-group-member-icon"}}
                            {{else}}
                                {{> ../cofounder/components/presence_dot
                                  user_circle_class=user_circle_class
                                  user_id=user_id
                                  tooltip_content=user_last_seen_time_status
                                  custom_classes="popover-group-member-icon user-circle popover-group-menu-user-presence hidden-for-spectators"
                                  }}
                            {{/if}}
                            <span class="popover-group-menu-member-name">{{full_name}}</span>
                        </li>
                    {{/each}}
                    {{#unless display_all_subgroups_and_members}}
                        <li class="popover-group-menu-member">
                            <span class="popover-group-menu-member-name">
                                {{#if is_system_group}}
                                    {{#if has_bots}}
                                        {{#tr class="popover-group-menu-member"}}
                                            View all <z-link-users>users</z-link-users> and <z-link-bots>bots</z-link-bots>
                                            {{#*inline "z-link-users"}}<a href="#organization/users">{{> @partial-block}}</a>{{/inline}}
                                            {{#*inline "z-link-bots"}}<a href="#organization/bots">{{> @partial-block}}</a>{{/inline}}
                                        {{/tr}}
                                    {{else}}
                                        <a href="#organization/users" role="menuitem">
                                            {{t "View all users"}}
                                        </a>
                                    {{/if}}
                                {{else}}
                                    <a href="{{group_members_url}}" role="menuitem">
                                        {{t "View all members"}}
                                    </a>
                                {{/if}}
                            </span>
                        </li>
                    {{/unless}}
                </ul>
            {{else}}
                <span class="popover-group-menu-placeholder"><i>{{t 'This group has no members.'}}</i></span>
            {{/unless}}
        </li>
        {{#unless is_guest}}
            <li role="separator" class="cf-menu__separator popover-menu-separator hidden-for-spectators"></li>
            <li role="none" class="link-item cf-menu__item popover-menu-list-item hidden-for-spectators">
                <a href="{{group_edit_url}}" role="menuitem" class="navigate-link-on-enter cf-menu__action popover-menu-link" tabindex="0">
                    {{> ../cofounder/components/icon name="sliders" compact=true custom_classes="cf-menu__icon popover-menu-icon"}}
                    <span class="cf-menu__label popover-menu-label">{{t "Group settings" }}</span>
                </a>
            </li>
        {{/unless}}
    </ul>
</div>
