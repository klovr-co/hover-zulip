{{> ./dropdown_widget widget_name="recent-view-filter" cofounder=true custom_classes="cf-data-table__filter-select"}}
{{#if show_folder_filter}}
<div id="recent_view_folder_filter_container" class="tippy-zulip-delayed-tooltip" data-tippy-content="{{ folder_filter_tooltip }}">
    {{> cofounder/components/icon_button id="recent_view_folder_filter_button" intent="neutral" icon="folder-chevron" custom_classes="recent-view-folder-filter-button" aria-label=(t 'Filter by folder') }}
</div>
{{/if}}
{{> cofounder/components/filter_chip data_filter="include_private" label=(t 'Include DMs') selected=filter_pm disabled=is_spectator custom_classes="button-recent-filters" }}
{{> cofounder/components/filter_chip data_filter="unread" label=(t 'Unread') selected=filter_unread disabled=is_spectator custom_classes="button-recent-filters" }}
{{> cofounder/components/filter_chip data_filter="participated" label=(t 'Participated') selected=filter_participated disabled=is_spectator custom_classes="button-recent-filters" }}
