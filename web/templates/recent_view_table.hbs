<div id="recent_view_filter_buttons" class="cf-data-table__toolbar" role="group" aria-label="{{t 'Conversation filters' }}">
    <div id="recent_filters_group">
        {{> recent_view_filters .}}
    </div>
    {{#> components/input_wrapper . input_type="filter-input" id="recent-view-search-wrapper" icon="search" input_button_icon="close" cofounder=true custom_classes="cf-data-table__search"}}
        <input type="text" id="recent_view_search" class="input-element user-list-filter" value="{{ search_val }}" autocomplete="off" placeholder="{{t 'Filter topics' }}" aria-label="{{t 'Filter conversations' }}" />
    {{/components/input_wrapper}}
</div>
<div class="cf-data-table__header-frame table_fix_head">
    <div class="recent-view-container">
        <table class="cf-data-table cf-data-table--header table table-responsive">
            <thead id="recent-view-table-headers">
                <tr>
                    <th class="cf-data-table__heading recent-view-topic-header">
                        <div class="recent-view-header-wrapper">
                            <button type="button" class="cf-data-table__sort cf-data-table__sort-button recent-view-channel-sort-header" data-sort="channel_sort">
                                {{t 'Channel' }}
                                {{> cofounder/components/icon name="chevron-down" compact=true custom_classes="table-sortable-arrow" }}
                            </button>
                            {{> cofounder/components/icon name="chevron-right" compact=true custom_classes="recent-view-header-chevron" }}
                            <button type="button" class="cf-data-table__sort cf-data-table__sort-button recent-view-conversation-sort-header" data-sort="conversation_sort">
                                {{t 'Conversation' }}
                                {{> cofounder/components/icon name="chevron-down" compact=true custom_classes="table-sortable-arrow" }}
                            </button>
                            <button type="button" class="cf-data-table__sort cf-data-table__sort-button cf-data-table__sort--icon-only recent-view-unread-sort-header hidden-for-spectators tippy-zulip-delayed-tooltip" data-sort="unread_sort" data-tippy-content="{{t 'Sort by unread message count' }}" aria-label="{{t 'Sort by unread message count' }}">
                                {{> cofounder/components/icon name="chevron-down" compact=true custom_classes="table-sortable-arrow" }}
                            </button>
                        </div>
                    </th>
                    <th class='cf-data-table__heading recent-view-participants-header participants_header'>
                        <div class="recent-view-header-wrapper">
                            {{t 'Participants' }}
                        </div>
                    </th>
                    <th class="cf-data-table__heading recent-view-last-msg-time-header last_msg_time_header">
                        <div class="recent-view-header-wrapper">
                            <button type="button" data-sort="numeric" data-sort-prop="last_msg_id" class="cf-data-table__sort cf-data-table__sort-button recent-view-last-msg-time-sort active descend">
                                <span>{{t 'Time' }}</span>
                                {{> cofounder/components/icon name="chevron-down" compact=true custom_classes="table-sortable-arrow" }}
                            </button>
                        </div>
                    </th>
                </tr>
            </thead>
        </table>
    </div>
</div>
