<div class="right-sidebar cf-people-sidebar" id="right-sidebar" role="navigation" aria-label="{{t 'People' }}">
    <div class="right-sidebar-items cf-people-sidebar__items">
        <div id="user-list" class="cf-people-sidebar__body">
            <div id="userlist-header" class="cf-people-sidebar__header">
                {{> cofounder/components/search_field
                  wrapper_id="userlist-header-search"
                  input_classes="user-list-filter"
                  placeholder=(t "Filter people")
                  aria-label=(t "Filter people")
                  autocomplete="off"
                  clear_button_classes="input-close-filter-button"
                  clear_button_aria_label=(t "Clear people filter")
                  }}
                {{> cofounder/components/icon_button
                  id="buddy-list-menu-icon"
                  icon="more-vertical"
                  intent="neutral"
                  component_classes="cf-people-sidebar__menu"
                  aria-label=(t "People list options")
                  omit_legacy_classes=true
                  }}
            </div>
            <div id="buddy_list_wrapper" class="scrolling_list cf-people-sidebar__scroll" data-simplebar data-simplebar-tab-index="-1">
                <div id="buddy-list-participants-container" class="cf-people-sidebar__section">
                    <div class="cf-people-sidebar__section-header"></div>
                    <ul id="buddy-list-participants" class="cf-people-sidebar__list"></ul>
                </div>
                <div id="buddy-list-users-matching-view-container" class="cf-people-sidebar__section">
                    <div class="cf-people-sidebar__section-header"></div>
                    <ul id="buddy-list-users-matching-view" class="cf-people-sidebar__list"></ul>
                    <div class="cf-people-sidebar__link-row cf-people-sidebar__subscribers-link"></div>
                </div>
                <div id="buddy-list-other-users-container" class="cf-people-sidebar__section">
                    <div class="cf-people-sidebar__section-header"></div>
                    <ul id="buddy-list-other-users" class="cf-people-sidebar__list"></ul>
                    <div class="cf-people-sidebar__link-row cf-people-sidebar__all-users-link"></div>
                </div>
                <div id="buddy_list_wrapper_padding"></div>
                <div class="cf-people-sidebar__invite">
                    <a class="cf-people-sidebar__link cf-people-sidebar__invite-action" role="button" tabindex="0">
                        <span class="cf-people-sidebar__link-label">
                            {{t 'Invite to organization' }}
                        </span>
                    </a>
                </div>
            </div>
            <div id="buddy-list-loading-subscribers"></div>
        </div>
    </div>
</div>
