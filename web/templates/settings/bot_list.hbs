<div class="cf-data-table__header settings_panel_list_header">
    <h3 class="settings-table-title">{{section_title}}</h3>
    <div class="alert-notification"></div>
    <div class="cf-data-table__filters bot-filters">
        {{> ../dropdown_widget widget_name=dropdown_widget_name cofounder=true}}
        {{> filter_text_input placeholder=(t 'Filter') aria_label=(t 'Filter bots')}}
    </div>
</div>

<div class="cf-data-table__scroll progressive-table-wrapper" data-simplebar data-simplebar-tab-index="-1">
    <table class="cf-data-table cf-data-table--settings table table-striped wrapped-table">
        <thead class="table-sticky-headers">
            <tr>
                <th class="active" data-sort="alphabetic" data-sort-prop="full_name">{{t "Name" }}
                    {{> ../cofounder/components/icon name="chevron-down" compact=true custom_classes="table-sortable-arrow"}}
                </th>
                <th class="settings-email-column" data-sort="email">{{t "Email" }}
                    {{> ../cofounder/components/icon name="chevron-down" compact=true custom_classes="table-sortable-arrow"}}
                </th>
                <th class="user_role" data-sort="role">{{t "Role" }}
                    {{> ../cofounder/components/icon name="chevron-down" compact=true custom_classes="table-sortable-arrow"}}
                </th>
                <th data-sort="bot_owner">{{t "Owner" }}
                    {{> ../cofounder/components/icon name="chevron-down" compact=true custom_classes="table-sortable-arrow"}}
                </th>
                <th data-sort="alphabetic" data-sort-prop="bot_type" class="bot_type">{{t "Bot type" }}
                    {{> ../cofounder/components/icon name="chevron-down" compact=true custom_classes="table-sortable-arrow"}}
                </th>
                <th class="actions">{{t "Actions" }}</th>
            </tr>
        </thead>
        <tbody id="{{prefix}}_{{section_name}}_table" class="bot-table"
          data-empty="{{#if (eq section_name 'all_bots')}}{{t 'There are no active bots in this organization.' }}{{else}}{{t 'You have no active bots'}}{{/if}}" data-search-results-empty="{{#if (eq section_name 'all_bots')}}{{t 'No bots match your current filter.' }}{{else}}{{t 'None of your bots match your current filter.' }}{{/if}}"></tbody>
    </table>
</div>
<div id="{{prefix}}_page_{{section_name}}_loading_indicator" class="loading-indicator"></div>
