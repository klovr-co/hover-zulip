{{#if is_admin}}
    <div
      id="connected-account-settings"
      class="settings-section cf-connected-account-settings-entry {{#unless realm_hover_enabled}}hide{{/unless}}"
      data-name="connected-account-settings"
      >
        <div class="cf-connected-accounts__heading">
            <div>
                <p class="cf-connected-accounts__kicker">{{t "Hover access boundary"}}</p>
                <h3 class="settings-table-title">{{t "Connected Accounts"}}</h3>
            </div>
            {{> ../cofounder/components/status tone="success" icon="shield" label=(t "Credentials stay private") custom_classes="cf-connected-accounts__privacy-status"}}
        </div>
        <p class="settings-field-description cf-connected-accounts__intro">
            {{t
              "Approve accounts, then grant teammates either specific source selectors or explicit access to all selectors. Empty selector grants deny access. Provider tokens, routing details, and private phone identifiers never appear here."
              }}
        </p>
        <div class="cf-connected-accounts__status" id="connected-account-status">
        </div>
        <div
          id="cf-connected-accounts-list"
          class="cf-connected-accounts__list"
          data-empty="{{t 'No Connected Accounts are available.'}}"
          >
        </div>
    </div>
{{/if}}
