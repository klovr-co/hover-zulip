<div class="cf-settings-section general-settings {{#if for_realm_settings}}settings-subsection-parent{{else}}subsection-parent{{/if}}">
    <!-- this is inline block so that the alert notification can sit beside
    it. If there's not an alert, don't make it inline-block.-->
    <div class="cf-settings-section__header subsection-header">
        <h3 class="settings-subsection-title">{{t "General" }}</h3>
        {{> settings_save_discard_widget section_name="general-settings" show_save_discard_buttons=for_realm_settings }}
    </div>
    {{#unless for_realm_settings}}
        {{> ../dropdown_widget_with_label
          widget_name="default_language"
          cofounder=true
          label=settings_label.default_language_settings_label
          value_type="string"
          help_link="/help/change-your-language"}}
    {{/unless}}

    <div class="cf-settings-field-row input-group">
        <label for="{{prefix}}twenty_four_hour_time" class="cf-settings-field-row__label settings-field-label">
            {{ settings_label.twenty_four_hour_time }}
            {{#if for_realm_settings}}
                {{> ../components/icon_button icon="reset" intent="neutral" custom_classes="reset-user-setting-to-default" data-tippy-content=(t "Reset users to default") aria-label=(t "Reset users to default") }}
            {{/if}}
        </label>
        <select name="twenty_four_hour_time" class="cf-field__control cf-settings-field-row__control setting_twenty_four_hour_time prop-element settings_select bootstrap-focus-style" id="{{prefix}}twenty_four_hour_time" data-setting-widget-type="string">
            {{#each (object_values twenty_four_hour_time_values)}}
                <option value='{{#if this.value}}true{{else}}false{{/if}}'>{{ this.description }}</option>
            {{/each}}
        </select>
    </div>
    <div class="cf-settings-field-row input-group">
        <label for="{{prefix}}color_scheme" class="cf-settings-field-row__label settings-field-label">
            {{t "Theme" }}
            {{#if for_realm_settings}}
                {{> ../components/icon_button icon="reset" intent="neutral" custom_classes="reset-user-setting-to-default" data-tippy-content=(t "Reset users to default") aria-label=(t "Reset users to default") }}
            {{/if}}
        </label>
        <div id="{{prefix}}color_scheme" class="cf-settings-choice-group tab-picker prop-element" data-setting-widget-type="radio-group" data-setting-choice-type="number">
            <input type="radio" id="{{prefix}}theme_select_automatic" class="tab-option setting_color_scheme" data-setting-widget-type="number" name="{{prefix}}theme_select" value="{{color_scheme_values.automatic.code}}" />
            <label class="cf-settings-choice-group__option tab-option-content tippy-zulip-delayed-tooltip" for="{{prefix}}theme_select_automatic" aria-label="{{t 'Select automatic theme' }}" data-tooltip-template-id="automatic-theme-template" tabindex="0">
                {{> ../cofounder/components/icon name="monitor" compact=true}}
            </label>
            <input type="radio" id="{{prefix}}theme_select_light" class="tab-option setting_color_scheme" data-setting-widget-type="number" name="{{prefix}}theme_select" value="{{color_scheme_values.light.code}}" />
            <label class="cf-settings-choice-group__option tab-option-content tippy-zulip-delayed-tooltip" for="{{prefix}}theme_select_light" aria-label="{{t 'Select light theme' }}" data-tippy-content="{{t 'Light theme' }}" tabindex="0">
                {{> ../cofounder/components/icon name="sun" compact=true}}
            </label>
            <input type="radio" id="{{prefix}}theme_select_dark" class="tab-option setting_color_scheme" data-setting-widget-type="number" name="{{prefix}}theme_select" value="{{color_scheme_values.dark.code}}" />
            <label class="cf-settings-choice-group__option tab-option-content tippy-zulip-delayed-tooltip" for="{{prefix}}theme_select_dark" aria-label="{{t 'Select dark theme' }}" data-tippy-content="{{t 'Dark theme' }}" tabindex="0">
                {{> ../cofounder/components/icon name="moon" compact=true}}
            </label>
            <span class="slider"></span>
        </div>
    </div>

    {{> settings_checkbox
      setting_name="enter_sends"
      is_checked=settings_object.enter_sends
      label=settings_label.enter_sends
      prefix=prefix
      show_reset_button=for_realm_settings}}

    <div class="cf-settings-density information-density-settings">
        <div class="cf-settings-density__control font-size-setting info-density-controls">
            <div class="cf-settings-density__label title">
                {{t "Font size"}}
                {{#if for_realm_settings}}
                {{> ../components/icon_button icon="reset" intent="neutral" custom_classes="reset-user-setting-to-default" data-tippy-content=(t "Reset users to default") aria-label=(t "Reset users to default") }}
                {{/if}}
            </div>
            {{> info_density_control_button_group
              property="web_font_size_px"
              default_icon_name="type"
              property_value=settings_object.web_font_size_px
              display_value=settings_object.web_font_size_px
              for_settings_ui=true
              prefix=prefix
              }}
        </div>
        <div class="cf-settings-density__control line-height-setting info-density-controls">
            <div class="cf-settings-density__label title">
                {{t "Line spacing"}}
                {{#if for_realm_settings}}
                {{> ../components/icon_button icon="reset" intent="neutral" custom_classes="reset-user-setting-to-default" data-tippy-content=(t "Reset users to default") aria-label=(t "Reset users to default") }}
                {{/if}}
            </div>
            {{> info_density_control_button_group
              property="web_line_height_percent"
              default_icon_name="line-height"
              property_value=settings_object.web_line_height_percent
              display_value=web_line_height_percent_display_value
              for_settings_ui=true
              prefix=prefix
              }}
        </div>
    </div>
</div>
