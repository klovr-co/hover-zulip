{{#if show_save_discard_buttons}}
<div class="save-button-controls hide">
    <div class="inline-block subsection-changes-save">
        {{> ../cofounder/components/button custom_classes="save-button" variant="primary" label=(t "Save changes") }}
    </div>
    <div class="inline-block subsection-changes-discard">
        {{> ../cofounder/components/button custom_classes="discard-button" variant="secondary" label=(t "Discard") }}
    </div>
</div>
{{/if}}
<div class="alert-notification {{#if section_name}}{{section_name}}-status{{/if}}"></div>
