<div id="settings_page" class="cf-settings-shell overlay-content overlay-container">
    <div class="cf-settings-shell__mobile-header settings-header mobile">
        <button type="button" class="cf-icon-button cf-icon-button--neutral cf-settings-shell__back" aria-label="{{t 'Back to settings'}}">
            {{> cofounder/components/icon name="chevron-left" compact=true}}
        </button>
        <h1>{{t "Settings" }}<span class="section"></span></h1>
        <button type="button" class="cf-icon-button cf-icon-button--neutral cf-settings-shell__close exit" aria-label="{{t 'Close settings'}}">
            {{> cofounder/components/icon name="close" compact=true}}
        </button>
    </div>
    <div class="cf-settings-shell__sidebar sidebar-wrapper">
        <div class="tab-container"></div>
        <div class="cf-settings-nav sidebar left" data-simplebar data-simplebar-tab-index="-1">
            <nav class="sidebar-list dark-grey small-text" aria-label="{{t 'Settings sections'}}">
                <ul class="cf-settings-nav__list normal-settings-list">
                    {{> cofounder/components/settings_nav_item section="profile" icon="user" label=(t "Profile")}}
                    {{> cofounder/components/settings_nav_item section="account-and-privacy" icon="lock" label=(t "Account & privacy")}}
                    {{> cofounder/components/settings_nav_item section="preferences" icon="sliders" label=(t "Preferences")}}
                    {{> cofounder/components/settings_nav_item section="notifications" icon="alarm" label=(t "Notifications")}}
                    {{#unless is_guest}}
                        {{> cofounder/components/settings_nav_item section="bots" icon="bot" label=(t "Bots") locked=(not (or can_create_new_bots can_manage_bot)) lock_tooltip=(t "You do not have permission to create or manage bots.")}}
                    {{/unless}}
                    {{> cofounder/components/settings_nav_item section="alert-words" icon="book" label=(t "Alert words")}}
                    {{#if show_uploaded_files_section}}
                        {{> cofounder/components/settings_nav_item section="uploaded-files" icon="paperclip" label=(t "Uploaded files")}}
                    {{/if}}
                    {{> cofounder/components/settings_nav_item section="topics" icon="hash" label=(t "Topics")}}
                    {{> cofounder/components/settings_nav_item section="muted-users" icon="eye-off" label=(t "Muted users")}}
                </ul>

                <ul class="cf-settings-nav__list org-settings-list">
                    {{> cofounder/components/settings_nav_item section="organization-profile" icon="users" label=(t "Organization profile") locked=(not is_admin) lock_tooltip=(t "Only organization administrators can edit these settings.")}}
                    {{> cofounder/components/settings_nav_item section="organization-settings" icon="sliders" label=(t "Organization settings") collapsible=true hide_org_settings=(not is_admin) locked=(not is_admin) lock_tooltip=(t "Only organization administrators can edit these settings")}}
                    {{> cofounder/components/settings_nav_item section="organization-permissions" icon="lock" label=(t "Organization permissions") collapsible=true hide_org_settings=(not is_admin) locked=(not is_admin) lock_tooltip=(t "Only organization administrators can edit these settings.")}}
                    {{> cofounder/components/settings_nav_item section="emoji-settings" icon="smile" label=(t "Custom emoji") locked=show_emoji_settings_lock lock_tooltip=(t "You do not have permission to add custom emoji.")}}
                    {{> cofounder/components/settings_nav_item section="linkifier-settings" icon="at-sign" label=(t "Linkifiers") locked=(not is_admin) lock_tooltip=(t "Only organization administrators can edit these settings.")}}
                    {{> cofounder/components/settings_nav_item section="playground-settings" icon="external-link" label=(t "Code playgrounds") locked=(not is_admin) lock_tooltip=(t "Only organization administrators can edit these settings.")}}
                    {{#unless is_guest}}
                        {{> cofounder/components/settings_nav_item section="users" icon="users" label=(t "Users") locked=(not can_edit_user_panel) lock_tooltip=(t "Only organization administrators can edit these settings.")}}
                    {{/unless}}
                    {{#unless is_guest}}
                        {{> cofounder/components/settings_nav_item section="bots" icon="bot" label=(t "Bots") locked=(not (or can_create_new_bots can_manage_bot)) lock_tooltip=(t "You do not have permission to create or manage bots.")}}
                    {{/unless}}
                    {{#if is_admin}}
                        {{> cofounder/components/settings_nav_item section="profile-field-settings" icon="user" label=(t "Custom profile fields")}}
                    {{/if}}
                    {{> cofounder/components/settings_nav_item section="organization-level-user-defaults" icon="sliders" label=(t "Default user settings") collapsible=true hide_org_settings=(not is_admin) locked=(not is_admin) lock_tooltip=(t "Only organization administrators can edit these settings.")}}
                    {{> cofounder/components/settings_nav_item section="channel-folders" icon="folder-cog" label=(t "Channel folders") collapsible=true hide_org_settings=(not is_admin) locked=(not is_admin) lock_tooltip=(t "Only organization administrators can edit these settings.")}}
                    {{#if is_admin}}
                        {{> cofounder/components/settings_nav_item section="connected-account-settings" icon="link-alt" label=(t "Connected Accounts") custom_classes="cf-connected-account-settings-entry" hidden=(not realm_hover_enabled)}}
                    {{/if}}
                    {{#unless is_guest}}
                        {{> cofounder/components/settings_nav_item section="default-channels-list" icon="hash" label=(t "Default channels") collapsible=true hide_org_settings=(not is_admin) locked=(not is_admin) lock_tooltip=(t "Only organization administrators can edit these settings.")}}
                    {{/unless}}
                    {{> cofounder/components/settings_nav_item section="auth-methods" icon="lock" label=(t "Authentication methods") collapsible=true hide_org_settings=(not is_admin) locked=(not is_owner) lock_tooltip=(t "Only organization owners can edit these settings.")}}
                    {{#if is_admin}}
                        {{> cofounder/components/settings_nav_item section="data-exports-admin" icon="archive" label=(t "Data exports")}}
                    {{/if}}
                    {{#unless is_admin}}
                        {{> cofounder/components/settings_nav_item icon="chevron-down" label=(t "Show more") custom_classes="collapse-settings-button" icon_id="toggle_collapse_chevron" label_id="toggle_collapse"}}
                    {{/unless}}
                </ul>
            </nav>
        </div>
    </div>
    <div class="cf-settings-shell__content content-wrapper right">
        <div class="cf-settings-shell__header settings-header">
            <h1><span class="header-prefix"></span><span class="section"></span></h1>
            <button type="button" class="cf-icon-button cf-icon-button--neutral cf-settings-shell__close exit" aria-label="{{t 'Close settings'}}">
                {{> cofounder/components/icon name="close" compact=true}}
            </button>
        </div>
        <div id="settings_content" class="cf-settings-shell__viewport" data-simplebar data-simplebar-tab-index="-1" data-simplebar-auto-hide="false">
            <div class="organization-box organization">

            </div>
            <div class="settings-box">
            </div>
        </div>
    </div>
</div>
