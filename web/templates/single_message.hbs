<div id="message-row-{{message_list_id}}-{{msg/id}}" data-message-id="{{msg/id}}"
  class="cf-message-item{{#unless msg/is_stream}} cf-message-item--private{{/unless}}{{#if include_sender}} cf-message-item--with-sender{{/if}}{{#if mention_classname}} {{mention_classname}}{{/if}}{{#if msg.unread}} cf-message-item--unread{{/if}}{{#if msg.locally_echoed}} cf-message-item--pending{{/if}}{{#if is_hidden}} cf-message-item--muted{{/if}}{{#if is_hover_generated_update}} cf-message-item--generated-update{{/if}}"
  {{#if hover_module_key}}data-cf-module-key="{{hover_module_key}}"{{/if}}
  {{#if cf_lineage_state}}data-cf-lineage="{{cf_lineage_state}}"{{/if}}
  {{#if cf_is_source_record}}data-cf-source-record{{/if}}
  {{#if cf_filter_source_ids}}data-cf-filter-source-ids="{{cf_filter_source_ids}}"{{/if}}
  role="listitem">
    {{#if (or want_subscription_status_divider want_date_divider)}}
    <div class="cf-message-item__unread-marker cf-message-item__unread-marker--divider"><div class="cf-message-item__unread-fill"></div></div>
    <div class="cf-message-item__divider no-select">
        {{#if want_subscription_status_divider}}
        <span class="stream-status">
            {{#if msg/historical }}
                {{#tr}}
                    You unsubscribed from <z-stream-name></z-stream-name>.
                    {{#*inline "z-stream-name"}}{{> stream_privacy . }} {{msg/display_recipient}}{{/inline}}
                {{/tr}}
            {{else}}
                {{#tr}}
                    You subscribed to <z-stream-name></z-stream-name>.
                    {{#*inline "z-stream-name"}}{{> stream_privacy . }} {{msg/display_recipient}}{{/inline}}
                {{/tr}}
            {{/if}}
        </span>
        {{/if}}
        {{#if want_date_divider}}
            <div class="date-divider-content">
                <span class="scroll-to-time" role="button" tabindex="0">
                    {{{date_divider_html}}}
                </span>
            </div>
        {{/if}}
    </div>
    {{/if}}
    <div class="cf-message-item__unread-marker" aria-hidden="true"><div class="cf-message-item__unread-fill"></div></div>
    {{#if msg.unread}}<span class="cf-message-item__unread-label">{{t "Unread message"}}</span>{{/if}}
    <div class="cf-message-item__frame">
        <div class="cf-message-item__body{{#if status_message}} cf-message-item__body--status is-me-message{{/if}}">
            {{> message_body .}}
            {{!-- message_edit_form.hbs is inserted here when editing a message. --}}
        </div>
    </div>
</div>
