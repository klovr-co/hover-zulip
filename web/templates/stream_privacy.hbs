{{! This controls whether the swatch next to streams in the left sidebar has a lock icon. }}
{{~#if is_archived ~}}
{{> cofounder/components/icon name="archive" compact=true}}
{{~else if invite_only ~}}
{{> cofounder/components/icon name="lock" compact=true}}
{{~else if is_web_public ~}}
{{> cofounder/components/icon name="globe" compact=true}}
{{~else~}}
{{> cofounder/components/icon name="hash" compact=true}}
{{~/if~}}
