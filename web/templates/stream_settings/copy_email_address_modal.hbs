<div class="copy-email-modal">
    {{> ../dropdown_widget_with_label
      widget_name="sender_channel_email_address"
      cofounder=true
      label=(t 'Who should be the sender of the Zulip messages for this email address?')}}
    <fieldset class="cf-email-options">
        <legend class="cf-email-options__legend question-which-parts">
            {{t "Which parts of the emails should be included in the Zulip messages?"}}
        </legend>
        {{#each tags}}
            {{#if (eq this.name "prefer-html") }}
            <hr class="cf-email-options__divider" />
            {{/if}}
            <div class="input-group" id="{{this.name}}-input-group">
                <label class="checkbox cf-email-options__option">
                    <input class="tag-checkbox" id="{{ this.name }}" type="checkbox"/>
                    <span class="rendered-checkbox"></span>
                    <span class="cf-email-options__label">{{this.description}}</span>
                </label>
            </div>
        {{/each}}
    </fieldset>
    <hr class="copy-email-modal__divider" />
    <h2 class="stream-email-header">
        {{t "Channel email address:"}}
    </h2>
    {{> ../cofounder/components/copy_field value=email_address value_classes="email-address" button_classes="copy-button tippy-zulip-tooltip copy-email-address" copy_label=(t "Copy email address") custom_classes="stream-email"}}
</div>
