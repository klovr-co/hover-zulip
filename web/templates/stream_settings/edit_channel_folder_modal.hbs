<div id="channel_folder_banner" class="banner-wrapper"></div>
<div class="channel-folder-name-container cf-channel-folder-form__field">
    <label for="edit_channel_folder_name" class="modal-field-label cf-field__label">
        {{t 'Channel folder name' }}
    </label>
    <input type="text" id="edit_channel_folder_name" class="modal_text_input cf-field__control" name="channel_folder_name" maxlength="{{ max_channel_folder_name_length }}" value="{{name}}" required {{#unless can_manage_folder}} disabled {{/unless}}/>
</div>
<div class="cf-channel-folder-form__field">
    <label for="edit_channel_folder_description" class="modal-field-label cf-field__label">
        {{t 'Description' }}
    </label>
    <textarea id="edit_channel_folder_description" class="modal-textarea cf-field__control" name="channel_folder_description" maxlength="{{ max_channel_folder_description_length }}" {{#unless can_manage_folder}} disabled {{/unless}}>{{~description~}}</textarea>
</div>
<section class="cf-channel-folder-form__section" aria-labelledby="edit_channel_folder_channels_heading">
    <div>
        <h2 id="edit_channel_folder_channels_heading" class="folder-channels-list-header">
            {{t 'Channels' }}
        </h2>
    </div>
    <div class="stream-list-container" data-folder-id="{{folder_id}}">
        {{> ../cofounder/components/search_field placeholder=(t "Filter") aria-label=(t "Filter channels") input_classes="stream-search" clear_button_classes="input-close-filter-button" clear_button_aria_label=(t "Clear filter") custom_classes="stream-search-container"}}
        <div class="edit-channel-folder-stream-list modal-list-scroll-container" data-simplebar data-simplebar-tab-index="-1">
            <ul class="folder-stream-list modal-item-list" aria-labelledby="edit_channel_folder_channels_heading" aria-live="polite" data-empty="{{t 'No channel in channel folder.' }}" data-search-results-empty="{{t 'No matching channels.' }}"></ul>
        </div>
    </div>
</section>
{{#if can_manage_folder}}
<section class="cf-channel-folder-form__section" aria-labelledby="edit_channel_folder_add_heading">
    <div>
        <h2 id="edit_channel_folder_add_heading" class="folder-channels-list-header">
            {{t 'Add a channel' }}
        </h2>
    </div>
    <div class="add_channel_folder_widget">
        {{> ../dropdown_widget widget_name="add_channel_folder" cofounder=true default_text=(t "Select a channel") aria-label=(t "Channel to add")}}
        {{> ../cofounder/components/button label=(t "Add") custom_classes="add-channel-button" variant="secondary" aria-label=(t "Add selected channel to folder") disabled=true }}
    </div>
</section>
{{/if}}
