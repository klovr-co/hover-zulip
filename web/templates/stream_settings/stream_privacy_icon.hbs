{{! This controls whether the swatch next to streams in the stream edit page has a lock icon. }}
{{#if is_archived}}
<div class="large-icon" {{#if title_icon_color}}style="color: {{title_icon_color}}"{{/if}}>
    {{> ../cofounder/components/icon name="archive" }}
</div>
{{else if invite_only}}
<div class="large-icon" {{#if title_icon_color}}style="color: {{title_icon_color}}"{{/if}}>
    {{> ../cofounder/components/icon name="lock" }}
</div>
{{else if is_web_public}}
<div class="large-icon" {{#if title_icon_color}}style="color: {{title_icon_color}}"{{/if}}>
    {{> ../cofounder/components/icon name="globe" }}
</div>
{{else}}
<div class="large-icon" {{#if title_icon_color}}style="color: {{title_icon_color}}"{{/if}}>
    {{> ../cofounder/components/icon name="hash" }}
</div>
{{/if}}
