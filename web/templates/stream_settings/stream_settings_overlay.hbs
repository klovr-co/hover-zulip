<div id="subscription_overlay" class="overlay two-pane-settings-overlay" data-overlay="subscriptions">
    <div class="flex overlay-content">
        <div class="two-pane-settings-container overlay-container cf-two-pane-shell">
            {{> ../cofounder/components/two_pane_header title=(t "Channels") title_class="subscriptions-title" }}
            <div class="two-pane-settings-content cf-two-pane-shell__content">
                <div class="left cf-two-pane-shell__pane cf-two-pane-shell__pane--list">
                    <div class="two-pane-settings-subheader cf-two-pane-shell__pane-header">
                        <div class="list-toggler-container">
                            <div id="add_new_subscription">
                                {{#if can_create_streams}}
                                {{> ../cofounder/components/icon_button
                                  icon="plus"
                                  intent="brand"
                                  custom_classes="create_stream_button two-pane-settings-plus-button tippy-zulip-delayed-tooltip"
                                  data-tooltip-template-id="create-new-stream-tooltip-template"
                                  data-tippy-placement="bottom"
                                  aria-label=(t "Create channel") }}
                                {{/if}}
                                <div class="float-clear"></div>
                            </div>
                        </div>
                    </div>
                    <div class="two-pane-settings-body cf-two-pane-shell__pane-body">
                        <div class="input-append stream_name_search_section two-pane-settings-search cf-two-pane-shell__filter" id="stream_filter">
                            <div id="folder_filter_container">
                                {{> ../cofounder/components/icon_button icon="folder-chevron" intent="neutral" id="folder_filter_button" custom_classes="filter-folders-dropdown-widget-button" aria-label=(t "Filter channels") }}
                            </div>
                            <input type="text" name="stream_name" id="search_stream_name" class="filter_text_input cf-field__control cf-two-pane-shell__filter-input" autocomplete="off"
                              placeholder="{{t 'Filter' }}" aria-label="{{t 'Filter channels' }}" value=""/>
                            {{> ../cofounder/components/icon_button icon="close" intent="neutral" id="clear_search_stream_name" custom_classes="clear_search_button" aria-label=(t "Clear filter") }}
                            <div class="stream_settings_filter_container {{#unless realm_has_archived_channels}}hide_filter{{/unless}}">
                                {{> ../dropdown_widget widget_name="stream_settings_filter" cofounder=true custom_classes="cf-two-pane-shell__filter-select"}}
                            </div>
                        </div>
                        <div class="no-streams-to-show">
                            <div class="subscribed_streams_tab_empty_text">
                                <span class="settings-empty-option-text">
                                    {{t 'You are not subscribed to any channels.'}}
                                    {{#if can_view_all_streams}}
                                    <a href="#channels/all">{{t 'View all channels'}}</a>
                                    {{/if}}
                                </span>
                            </div>
                            <div class="available_streams_tab_empty_text">
                                <span class="settings-empty-option-text">
                                    {{t 'No channels to show.'}}
                                    <a href="#channels/all">{{t 'View all channels'}}</a>
                                </span>
                            </div>
                            <div class="no_stream_match_filter_empty_text">
                                <span class="settings-empty-option-text">
                                    {{t 'No channels match your filter.'}}
                                </span>
                            </div>
                            <div class="all_streams_tab_empty_text">
                                <span class="settings-empty-option-text">
                                    {{t 'There are no channels you can view in this organization.'}}
                                    {{#if can_create_streams}}
                                        <a href="#channels/new">{{t 'Create a channel'}}</a>
                                    {{/if}}
                                </span>
                            </div>
                        </div>
                        <div class="streams-list two-pane-settings-left-simplebar-container cf-two-pane-shell__list" data-simplebar data-simplebar-tab-index="-1">
                        </div>
                    </div>
                </div>
                <div class="right cf-two-pane-shell__pane cf-two-pane-shell__pane--detail">
                    <div class="two-pane-settings-subheader cf-two-pane-shell__pane-header">
                        <div class="display-type">
                            <div id="stream_settings_title" class="stream-info-title cf-two-pane-shell__pane-title">{{t 'Channel settings' }}</div>
                        </div>
                    </div>
                    <div class="two-pane-settings-body cf-two-pane-shell__pane-body">
                        <div class="nothing-selected cf-two-pane-shell__empty">
                            <div class="stream-info-banner banner-wrapper"></div>
                            <div class="create-stream-button-container">
                                {{> ../cofounder/components/button variant="primary" label=(t "Create channel") custom_classes="create_stream_button" disabled=(not can_create_streams) }}
                                {{#unless can_create_streams}}
                                <span class="settings-empty-option-text">
                                    {{t 'You do not have permission to create channels.' }}
                                </span>
                                {{/unless}}
                            </div>
                        </div>
                        <div id="stream_settings" class="two-pane-settings-right-simplebar-container settings cf-two-pane-shell__detail" data-simplebar data-simplebar-tab-index="-1" data-simplebar-auto-hide="false">
                            {{!-- edit stream here --}}
                        </div>
                        {{> stream_creation_form . }}
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
