{{! Stream sidebar rows }}
{{#> cofounder/components/channel_nav_item .}}
    {{#if is_hover_space}}
    {{#if has_hover_ai_modules}}
    <section class="cf-module-nav" aria-label="{{t 'AI Modules' }}">
        <div class="cf-module-nav__header">{{t "AI Modules"}}</div>
        <ul class="cf-module-nav__list">
            {{#each hover_ai_modules}}
                <li>
                    <a class="cf-module-nav__item" href="{{url}}" data-cf-module-key="{{key}}">
                        {{> cofounder/components/icon name=icon_name compact=true custom_classes="cf-module-nav__icon"}}
                        <span class="cf-module-nav__name">{{name}}</span>
                        {{#if has_count}}<span class="cf-module-nav__count">{{count}}</span>{{/if}}
                    </a>
                </li>
            {{/each}}
        </ul>
    </section>
    {{/if}}
    <section class="cf-source-ledger" aria-label="{{t 'Attached sources' }}">
        <div class="cf-source-ledger__header">
            <span>{{t "Sources"}}</span>
        </div>
        <ul class="cf-source-ledger__list">
            {{#each hover_attached_sources}}
                <li>
                    <a class="cf-source-ledger__item" href="{{url}}" data-cf-source-key="{{source_key}}" {{#if is_external}}target="_blank" rel="noopener noreferrer"{{/if}}>
                        <span class="cf-source-ledger__icon" aria-hidden="true">{{> cofounder/components/icon name=icon_name compact=true}}</span>
                        <span class="cf-source-ledger__copy">
                            <span class="cf-source-ledger__name">{{name}}</span>
                            <span class="cf-source-ledger__detail">{{detail}}</span>
                        </span>
                        {{#if is_external}}{{> cofounder/components/icon name="external-link" compact=true custom_classes="cf-source-ledger__external"}}{{/if}}
                    </a>
                </li>
            {{/each}}
        </ul>
    </section>
    {{/if}}
    {{#if for_modal}}<div class="topic-list-scroll-container" data-simplebar data-simplebar-tab-index="-1"></div>{{/if}}
{{/cofounder/components/channel_nav_item}}
