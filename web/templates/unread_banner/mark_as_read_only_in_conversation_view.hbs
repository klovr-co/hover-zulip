{{#> ../cofounder/components/notice . intent="info" id="mark_as_read_turned_off_banner"}}
    <p id="mark_as_read_turned_off_content" class="cf-notice__content">
        {{#tr}}
            Messages will not be automatically marked as read because this is not a
            <z-conversation-view>conversation</z-conversation-view> view. <z-link>Change setting</z-link>
            {{#*inline "z-conversation-view"}}<a href='/help/reading-conversations'>{{> @partial-block}}</a>{{/inline}}
            {{#*inline "z-link"}}<a href='/#settings/preferences'>{{> @partial-block}}</a>{{/inline}}
        {{/tr}}
    </p>
    <div class="cf-notice__actions">
        {{> ../cofounder/components/button variant="secondary" id="mark_view_read" label=(t "Mark as read") custom_classes="cf-notice__action"}}
    </div>
{{/../cofounder/components/notice}}
