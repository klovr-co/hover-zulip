{{#> ../cofounder/components/notice . intent="info" custom_classes="mark-as-read-state-banner"}}
    <p class="cf-notice__content mark-as-read-state-content">
        {{t 'To preserve your reading state, this view does not mark messages as read.' }}
    </p>
    <div class="cf-notice__actions">
        {{> ../cofounder/components/button variant="secondary" label=(t "Mark as read") custom_classes="cf-notice__action mark-view-read"}}
    </div>
{{/../cofounder/components/notice}}
