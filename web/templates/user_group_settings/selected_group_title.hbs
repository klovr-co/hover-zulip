<div class="selected-group-title">
    <span class="selected-group">
        <span class="large-icon">
            {{> ../cofounder/components/icon name="circle-off" compact=true custom_classes="deactivated-user-group-icon"}}
        </span>
        <span class="selected-group-name" data-tippy-content="{{group_name}}">{{group_name}}</span>
    </span>
    {{#unless is_system_group}}
    <div class="button-group selected-group-buttons" data-group-id="{{group_id}}">
        <div class="left-end button-group">
            {{> ../cofounder/components/icon_button icon="edit" intent="neutral" custom_classes="open-group-info-button tippy-zulip-delayed-tooltip"
              data-tippy-content=(t 'Change group info') id="group_title_open_group_info_modal" }}
        </div>
        <div class="right-end button-group">
            <div class="join_leave_button_wrapper inline-block">
                {{#if is_direct_member}}
                {{> ../cofounder/components/button label=(t "Leave group") custom_classes="join_leave_button" type="button" compact=true
                  variant="secondary" }}
                {{else}}
                {{> ../cofounder/components/button label=(t "Join group") custom_classes="join_leave_button" type="button" compact=true
                  variant="primary" }}
                {{/if}}
            </div>
            {{> ../cofounder/components/icon_button icon="user-group-x" intent="danger" custom_classes="deactivate-group-button deactivate tippy-zulip-delayed-tooltip"
              data-tippy-content=(t 'Deactivate group') }}
            {{> ../cofounder/components/icon_button icon="user-group-plus" intent="success" custom_classes="reactivate-group-button reactivate tippy-zulip-delayed-tooltip"
              data-tippy-content=(t 'Reactivate group') }}
        </div>
    </div>
    {{/unless}}
</div>
