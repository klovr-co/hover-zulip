<div class="micromodal cf-theme cf-dialog-root cf-user-profile" id="user-profile-modal" data-user-id="{{user_id}}" aria-hidden="true">
    <div class="modal__overlay cf-dialog-backdrop" tabindex="-1">
        <div class="modal__container cf-dialog" role="dialog" aria-modal="true" aria-labelledby="user-profile-name-heading">
            <div class="modal__header cf-dialog__header">
                <div class="modal__header-content cf-dialog__heading">
                    <h1 class="modal__title user-profile-name-heading" id="user-profile-name-heading">
                        {{#unless is_bot}}
                            {{#if is_active}}
                                <span class="tippy-zulip-tooltip user-status-icon-wrapper" data-tippy-content="{{last_seen}}">
                                    {{> cofounder/components/presence_dot user_circle_class=user_circle_class user_id=user_id custom_classes="user_profile_presence"}}
                                </span>
                            {{else}}
                                <span>
                                    {{#if is_deleted}}
                                        <span class="deactivated-user-icon tippy-zulip-tooltip" data-tippy-content="{{t 'Deleted user'}}">{{> cofounder/components/icon name="circle-off" compact=true}}</span>
                                    {{else}}
                                        <span class="deactivated-user-icon tippy-zulip-tooltip" data-tippy-content="{{t 'Deactivated user'}}">{{> cofounder/components/icon name="circle-off" compact=true}}</span>
                                    {{/if}}
                                </span>
                            {{/if}}
                        {{/unless}}
                        {{#if is_bot}}
                            {{> cofounder/components/icon name="bot" compact=true}}
                        {{/if}}
                        <span class="user-profile-name">{{> user_full_name name=full_name}}</span>
                        <span class="user-profile-header-actions">
                            {{> cofounder/components/icon_button custom_classes="copy-link-to-user-profile tippy-zulip-delayed-tooltip" icon="link-alt" intent="neutral" data-tippy-content=(t "Copy link to profile") aria-label=(t "Copy link to profile") }}
                            {{#if is_me}}
                                {{#if can_manage_profile}}
                                    {{> cofounder/components/icon_button custom_classes="user-profile-update-user-tab-button tippy-zulip-delayed-tooltip" icon="edit" intent="neutral" data-tippy-content=(t "Edit profile") aria-label=(t "Edit profile") }}
                                {{else}}
                                    {{> cofounder/components/icon_button custom_classes="user-profile-profile-settings-button tippy-zulip-delayed-tooltip" icon="edit" intent="neutral" data-tippy-content=(t "Edit profile") aria-label=(t "Edit profile") }}
                                {{/if}}
                            {{else if can_manage_profile}}
                                {{#if is_bot}}
                                    {{> cofounder/components/icon_button custom_classes="user-profile-update-user-tab-button tippy-zulip-delayed-tooltip" icon="edit" intent="neutral" data-tippy-content=(t "Manage bot") aria-label=(t "Manage bot") }}
                                {{else}}
                                    {{> cofounder/components/icon_button custom_classes="user-profile-update-user-tab-button tippy-zulip-delayed-tooltip" icon="edit" intent="neutral" data-tippy-content=(t "Manage user") aria-label=(t 'Manage user') }}
                                {{/if}}
                            {{/if}}
                        </span>
                    </h1>
                </div>
                <div class="modal__tab-switcher-container cf-dialog__tabs"></div>
                {{> cofounder/components/icon_button icon="close" intent="neutral" custom_classes="modal__close cf-dialog__close" aria-label=(t 'Close modal') data-micromodal-close=true }}
            </div>
            <main class="modal__content cf-dialog__body" data-simplebar data-simplebar-tab-index="-1" data-simplebar-auto-hide="false">
                <div class="tab-data">
                    <div class="tabcontent active" id="profile-tab">
                        <div class="top">
                            <div class="col-wrap col-left">
                                <div id="default-section">
                                    {{#if email}}
                                    <div id="email" class="default-field">
                                        <div class="name">{{t "Email" }}</div>
                                        <div class="value">{{email}}</div>
                                    </div>
                                    {{/if}}
                                    <div id="user-id" class="default-field">
                                        <div class="name">{{t "User ID" }}</div>
                                        <div class="value">{{user_id}}</div>
                                    </div>
                                    <div id="user-type" class="default-field">
                                        <div class="name">{{t "Role" }}</div>
                                        {{#if is_bot}}
                                            {{#if is_system_bot}}
                                            <div class="value">{{t "System bot" }}</div>
                                            {{else}}
                                            <div class="value">{{t "Bot" }}
                                                <span class="lowercase">({{user_type}})</span>
                                            </div>
                                            {{/if}}
                                        {{else}}
                                            <div class="value">{{user_type}}</div>
                                        {{/if}}
                                    </div>
                                    <div id="date-joined" class="default-field">
                                        <div class="name">
                                            {{#if is_bot}}
                                                {{t "Created"}}
                                            {{else if is_imported_stub}}
                                                {{t "Account imported"}}
                                            {{else}}
                                                {{t "Joined"}}
                                            {{/if}}
                                        </div>
                                        <div class="value">{{date_joined}}</div>
                                    </div>
                                    {{#if user_time}}
                                    <div class="default-field">
                                        <div class="name">{{t "Local time" }}</div>
                                        <div class="value">{{user_time}}</div>
                                    </div>
                                    {{/if}}
                                </div>
                            </div>
                            <div class="col-wrap col-right">
                                <div id="avatar" {{#if user_is_guest}} class="guest-avatar" {{/if}}
                                  style="background-image: url('{{user_avatar}}');">
                                </div>
                            </div>
                        </div>
                        <div class="bottom">
                            <div id="content">
                                {{#if is_bot}}
                                    <div class="field-section">
                                        <div class="name">{{t "Bot type" }}</div>
                                        <div class="bot_info_value">{{bot_type}}</div>
                                    </div>
                                    {{#if bot_owner}}
                                    <div class="field-section bot_owner_user_field" data-field-id="{{bot_owner.user_id}}">
                                        <div class="name">{{t "Owner" }}</div>
                                        <div class="pill-container not-editable">
                                            <div class="input" contenteditable="false" style="display: none;"></div>
                                        </div>
                                    </div>
                                    {{/if}}
                                {{else}}
                                    {{> user_custom_profile_fields profile_fields=profile_data}}
                                {{/if}}
                            </div>
                        </div>
                    </div>

                    <div class="tabcontent" id="user-profile-streams-tab">
                        <div class="stream_list_info banner-wrapper"></div>
                        <div class="stream-list-top-section">
                            <div class="header-section">
                                <h3 class="stream-tab-element-header">{{t 'Subscribed channels' }}</h3>
                            </div>
                            <div class="stream-list-container">
                                {{> cofounder/components/search_field placeholder=(t "Filter") aria-label=(t "Filter channels") input_classes="stream-search" clear_button_classes="input-close-filter-button" clear_button_aria_label=(t "Clear filter") custom_classes="stream-search-container"}}
                                <div class="stream-list-loader"></div>
                                <div class="error-message"></div>
                                <div class="subscription-stream-list modal-list-scroll-container" data-simplebar data-simplebar-tab-index="-1">
                                    <ul class="user-stream-list modal-item-list" data-empty="{{t 'No channel subscriptions.' }}" data-search-results-empty="{{t 'No matching channels.' }}"></ul>
                                </div>
                            </div>
                        </div>
                        <div class="stream-list-bottom-section">
                            <div class="header-section">
                                <h3 class="stream-tab-element-header">{{t 'Subscribe {full_name} to channels'}}</h3>
                            </div>
                            {{> user_profile_subscribe_widget}}
                        </div>
                    </div>

                    <div class="tabcontent" id="user-profile-groups-tab">
                        <div class="user-profile-group-list-alert banner-wrapper"></div>
                        <div class="group-list-top-section">
                            <div class="header-section">
                                <h3 class="group-tab-element-header">{{t 'Group membership' }}</h3>
                            </div>
                            <div class="group-list-container">
                                {{> cofounder/components/search_field placeholder=(t "Filter") aria-label=(t "Filter groups") input_classes="group-search" clear_button_classes="input-close-filter-button" clear_button_aria_label=(t "Clear filter") custom_classes="group-search-container"}}
                                <div class="subscription-group-list modal-list-scroll-container" data-simplebar data-simplebar-tab-index="-1">
                                    <ul class="user-group-list modal-item-list" data-empty="{{t 'Not a member of any groups.' }}" data-search-results-empty="{{t 'No matching user groups' }}"></ul>
                                </div>
                            </div>
                        </div>
                        <div class="group-list-bottom-section">
                            <div class="header-section">
                                <h3 class="group-tab-element-header">{{t 'Add {full_name} to groups'}}</h3>
                            </div>
                            <div id="groups-to-add" class="add-button-container">
                                <div id="user-group-to-add">
                                    <div class="add-user-group-container">
                                        <div class="pill-container">
                                            <div class="input" contenteditable="true"
                                              data-placeholder="{{t 'Add user groups' }}">
                                                {{~! Squash whitespace so that placeholder is displayed when empty. ~}}
                                            </div>
                                        </div>
                                    </div>
                                </div>
                                {{> cofounder/components/button label=(t "Add") custom_classes="add-groups-button" variant="secondary" aria-label=(t "Add") }}
                            </div>
                        </div>
                    </div>
                    <div class="tabcontent" id="manage-profile-tab"></div>
                </div>
            </main>
            <footer class="modal__footer cf-dialog__footer manage-profile-tab-footer">
                <div class="save-success"></div>
                {{> cofounder/components/button variant="secondary" label=(t "Cancel") custom_classes="modal__button dialog_exit_button cf-dialog__button" aria-label=(t "Close this dialog window") micromodal_close=true}}
                {{> cofounder/components/button variant="primary" label=(t "Save changes") custom_classes="modal__button dialog_submit_button cf-dialog__button cf-dialog__submit" custom_label_classes="submit-button-text" spinner_class="cf-dialog__spinner"}}
            </footer>
        </div>
    </div>
</div>
