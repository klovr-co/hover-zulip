<div class="widget-choices">
    <div class="widget-choices-heading">{{heading}}</div>
    <ul>
        {{#each choices}}
            <li>
                <button class="widget-choice" data-idx="{{this.idx}}">
                    <span
                      class="widget-choice-short-name"
                      >{{this.short_name}}</span>
                    <span
                      class="widget-choice-long-name"
                      >{{this.long_name}}</span>
                </button>
            </li>
        {{/each}}
    </ul>
</div>
